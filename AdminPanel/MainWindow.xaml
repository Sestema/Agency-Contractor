<Window x:Class="AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agency Contractor — Admin Panel"
        Width="1380" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AdminTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="#89B4FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Admin Panel" FontSize="20" FontWeight="SemiBold" Foreground="#CDD6F4"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Text="" FontSize="12.5" Foreground="#A6ADC8"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,8,8">
                <TextBlock x:Name="TxtStatFirms" Text="Фірм: —" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,8,8">
                <TextBlock x:Name="TxtStatEmployees" Text="Працівників: —" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,8,8">
                <TextBlock x:Name="TxtStatEvents" Text="Подій: —" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <Button Style="{StaticResource DashboardCardButton}" Margin="0,0,0,8" Tag="license:7" Click="DashboardFilterCard_Click">
                <TextBlock x:Name="TxtStatExpiring" Text="&lt;=7 днів: —" Foreground="#FAB387" FontSize="13" FontWeight="SemiBold"/>
            </Button>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <WrapPanel DockPanel.Dock="Left">
                        <Button Style="{StaticResource PrimaryBtn}" Click="BtnRefresh_Click" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;"/>
                                <TextBlock Text="Оновити" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnExtend" Style="{StaticResource PrimaryBtn}" Click="BtnExtend_Click" Margin="0,0,6,6" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE787;"/>
                                <TextBlock Text="Активувати / продовжити" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnBlock" Style="{StaticResource DangerBtn}" Click="BtnBlock_Click" Margin="0,0,6,6" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;"/>
                                <TextBlock Text="Заблокувати" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnUnblock" Style="{StaticResource SuccessBtn}" Click="BtnUnblock_Click" Margin="0,0,6,6" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;"/>
                                <TextBlock Text="Розблокувати" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnBlockIp" Style="{StaticResource GhostBtn}" Click="BtnBlockIp_Click" Margin="0,0,6,6" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE774;"/>
                                <TextBlock Text="Блокувати IP" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnResetProfile" Style="{StaticResource GhostBtn}" Click="BtnResetProfile_Click" Margin="0,0,6,6" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8D7;"/>
                                <TextBlock Text="Скинути пароль" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDelete" Style="{StaticResource DangerBtn}" Click="BtnDelete_Click" Margin="0,0,12,6" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;"/>
                                <TextBlock Text="Видалити" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="TxtCount" Text="Клієнтів: 0" Foreground="#A6ADC8" FontSize="12.5"
                               VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,0,6"/>
                </DockPanel>

                <WrapPanel Grid.Row="1">
                    <Grid Width="250" Margin="0,0,8,0">
                        <TextBox x:Name="TxtClientSearch" Style="{StaticResource FilterTextBox}"
                                 TextChanged="ClientFilter_Changed"/>
                        <TextBlock Text="Пошук клієнта">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtClientSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="CmbClientStatus" Width="150" Style="{StaticResource FilterComboBox}"
                              SelectionChanged="ClientFilter_Changed" Margin="0,0,8,0">
                        <ComboBoxItem Tag="all" IsSelected="True">Усі статуси</ComboBoxItem>
                        <ComboBoxItem Tag="trial">Trial</ComboBoxItem>
                        <ComboBoxItem Tag="activated">Activated</ComboBoxItem>
                        <ComboBoxItem Tag="readonly">Read-only</ComboBoxItem>
                        <ComboBoxItem Tag="blocked">Заблоковані</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="CmbLicenseFilter" Width="180" Style="{StaticResource FilterComboBox}"
                              SelectionChanged="ClientFilter_Changed" Margin="0,0,8,0">
                        <ComboBoxItem Tag="all" IsSelected="True">Усі ліцензії</ComboBoxItem>
                        <ComboBoxItem Tag="expired">Протерміновані</ComboBoxItem>
                        <ComboBoxItem Tag="7">Закінчуються за 7 днів</ComboBoxItem>
                        <ComboBoxItem Tag="30">Закінчуються за 30 днів</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="CmbActivityFilter" Width="170" Style="{StaticResource FilterComboBox}"
                              SelectionChanged="ClientFilter_Changed" Margin="0,0,8,0">
                        <ComboBoxItem Tag="all" IsSelected="True">Уся активність</ComboBoxItem>
                        <ComboBoxItem Tag="recent3">Активні за 3 дні</ComboBoxItem>
                        <ComboBoxItem Tag="stale7">Неактивні 7+ днів</ComboBoxItem>
                        <ComboBoxItem Tag="stale30">Неактивні 30+ днів</ComboBoxItem>
                        <ComboBoxItem Tag="never">Без активності</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="CmbVersionFilter" Width="140" Style="{StaticResource FilterComboBox}"
                              SelectionChanged="ClientFilter_Changed" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GhostBtn}" Click="BtnResetClientFilters_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE894;"/>
                            <TextBlock Text="Скинути" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="DgClients"
                          Style="{StaticResource PanelDataGrid}"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          SelectionChanged="DgClients_SelectionChanged"
                          MouseDoubleClick="DgClients_MouseDoubleClick"
                          PreviewMouseRightButtonDown="DgClients_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="ClientGridContextMenu_Opened">
                            <MenuItem Header="Відкрити дзеркало" Click="MenuOpenMirror_Click"/>
                            <Separator/>
                            <MenuItem Header="Копіювати Client ID" Click="MenuCopyClientId_Click"/>
                            <MenuItem Header="Копіювати Machine ID" Click="MenuCopyMachineId_Click"/>
                            <MenuItem x:Name="MenuCopyIp" Header="Копіювати IP" Click="MenuCopyIp_Click"/>
                            <Separator/>
                            <MenuItem x:Name="MenuBlockClient" Header="Заблокувати" Click="BtnBlock_Click"/>
                            <MenuItem x:Name="MenuUnblockClient" Header="Розблокувати" Click="BtnUnblock_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ім'я" Binding="{Binding DisplayName}" Width="190"/>
                        <DataGridTextColumn Header="Версія" Binding="{Binding AppVersion}" Width="80"/>
                        <DataGridTextColumn Header="План" Binding="{Binding PlanDisplay}" Width="80"/>
                        <DataGridTextColumn Header="Фірми" Binding="{Binding FirmsCount}" Width="60"/>
                        <DataGridTextColumn Header="Працівники" Binding="{Binding EmployeesCount}" Width="86"/>
                        <DataGridTextColumn Header="Heartbeat" Binding="{Binding LatestHeartbeatDisplay}" SortMemberPath="LatestHeartbeatAt" Width="90"/>
                        <DataGridTemplateColumn Header="Ризик" SortMemberPath="RiskScore" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Center"
                                            ToolTip="{Binding RiskReasonsDisplay}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#21493D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RiskLevelCode}" Value="warning">
                                                        <Setter Property="Background" Value="#5C4A22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevelCode}" Value="high">
                                                        <Setter Property="Background" Value="#5A2D3D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RiskBadgeLabel}" FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A6E3A1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskLevelCode}" Value="warning">
                                                            <Setter Property="Foreground" Value="#FAB387"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevelCode}" Value="high">
                                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Останній вхід" Binding="{Binding LastSeen, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Активовано" Binding="{Binding ActivatedAt, StringFormat=dd.MM.yyyy}" Width="96"/>
                        <DataGridTextColumn Header="Діє до" Binding="{Binding ExpiresAt, StringFormat=dd.MM.yyyy}" Width="90"/>
                        <DataGridTemplateColumn Header="Статус" Width="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#45475A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccessStateCode}" Value="blocked">
                                                        <Setter Property="Background" Value="#5A2D3D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccessStateCode}" Value="readonly">
                                                        <Setter Property="Background" Value="#5C4A22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccessStateCode}" Value="trial">
                                                        <Setter Property="Background" Value="#4E3F20"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccessStateCode}" Value="activated">
                                                        <Setter Property="Background" Value="#21493D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AccessStateLabel}" FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccessStateCode}" Value="blocked">
                                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccessStateCode}" Value="readonly">
                                                            <Setter Property="Foreground" Value="#FAB387"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccessStateCode}" Value="trial">
                                                            <Setter Property="Foreground" Value="#F9E2AF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccessStateCode}" Value="activated">
                                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Нотатки" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtDetailHeader" Text="Клієнт не вибраний" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#CDD6F4" Margin="0,0,0,10"/>

                        <Border Background="#252836" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Статус" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtDetailStatus" Text="—" Style="{StaticResource InlineDetailValueBox}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Ризик" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailRisk" Text="—" Style="{StaticResource DetailValueBox}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Client ID" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailClientId" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ім'я ПК" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailMachine" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Machine ID" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailMachineId" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="IP адреса" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailIp" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Версія" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailVersion" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Активовано" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailActivated" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Останній вхід" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailLastSeen" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ліцензія до" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailExpires" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Стан ліцензії" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailLicense" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Останній стан" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtDetailHeartbeat" Text="—" Style="{StaticResource DetailValueBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border Background="#252836" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="План і AI" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="План клієнта" Style="{StaticResource DetailLabel}"/>
                                <ComboBox x:Name="CmbAccessPlan"
                                          Style="{StaticResource FilterComboBox}"
                                          Margin="0,0,0,10"
                                          SelectionChanged="CmbAccessPlan_SelectionChanged">
                                    <ComboBoxItem Tag="trial">Trial</ComboBoxItem>
                                    <ComboBoxItem Tag="standard">Standard</ComboBoxItem>
                                    <ComboBoxItem Tag="pro">Pro</ComboBoxItem>
                                    <ComboBoxItem Tag="business">Business</ComboBoxItem>
                                </ComboBox>

                                <Border x:Name="BusinessTenantPanel"
                                        Background="#1E1E2E"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Business workspace"
                                                   Foreground="#CDD6F4"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="Max users" Style="{StaticResource DetailLabel}"/>
                                        <TextBox x:Name="TxtBusinessMaxUsers"
                                                 Text="10"
                                                 TextChanged="BusinessTenantField_TextChanged"
                                                 Style="{StaticResource FilterTextBox}"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="Max devices" Style="{StaticResource DetailLabel}"/>
                                        <TextBox x:Name="TxtBusinessMaxDevices"
                                                 Text="3"
                                                 TextChanged="BusinessTenantField_TextChanged"
                                                 Style="{StaticResource FilterTextBox}"
                                                 Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkBusinessMultiUserEnabled"
                                                  Content="Multi-user enabled"
                                                  IsChecked="True"
                                                  Style="{StaticResource PanelCheckBox}"
                                                  Checked="BusinessTenantField_Changed"
                                                  Unchecked="BusinessTenantField_Changed"/>
                                        <TextBlock Text="Tenant status" Style="{StaticResource DetailLabel}"/>
                                        <ComboBox x:Name="CmbBusinessTenantStatus"
                                                  Style="{StaticResource FilterComboBox}"
                                                  Margin="0,0,0,8"
                                                  SelectionChanged="BusinessTenantField_SelectionChanged">
                                            <ComboBoxItem Tag="active">Active</ComboBoxItem>
                                            <ComboBoxItem Tag="suspended">Suspended</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock x:Name="TxtBusinessTenantInfo"
                                                   Foreground="#A6ADC8"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Text="Tenant буде створено при збереженні"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Admin Gemini API key" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="TxtManagedGeminiKey"
                                         TextChanged="TxtManagedGeminiKey_TextChanged"
                                         Style="{StaticResource FilterTextBox}"
                                         Margin="0,0,0,6"/>
                                <TextBlock Text="Для Standard можна залишити порожнім. Для Pro, Business або Trial ключ можна задати тут."
                                           Foreground="#A6ADC8"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <Button x:Name="BtnSaveAccessConfig"
                                        Content="Зберегти план і AI"
                                        Style="{StaticResource PrimaryBtn}"
                                        HorizontalAlignment="Right"
                                        IsEnabled="False"
                                        Click="BtnSaveAccessConfig_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252836" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Що робив" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="TxtDetailActivity"
                                         Text="—"
                                         Style="{StaticResource DetailValueBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="52"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Причина блокування" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="TxtDetailBlockReason" Text="—" Style="{StaticResource DetailValueBox}"/>
                        </StackPanel>

                        <Border Background="#252836" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Профіль користувача" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,10">
                                        <TextBlock Text="Ім'я та прізвище" Style="{StaticResource DetailLabel}"/>
                                        <TextBox x:Name="TxtDetailProfileName" Text="—" Style="{StaticResource DetailValueBox}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Статус профілю" Style="{StaticResource DetailLabel}"/>
                                        <TextBox x:Name="TxtDetailProfileStatus" Text="—" Style="{StaticResource DetailValueBox}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Remember me" Style="{StaticResource DetailLabel}"/>
                                        <TextBox x:Name="TxtDetailRememberMe" Text="—" Style="{StaticResource DetailValueBox}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Оновлено" Style="{StaticResource DetailLabel}"/>
                                        <TextBox x:Name="TxtDetailProfileUpdatedAt" Text="—" Style="{StaticResource DetailValueBox}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Нотатки оператора" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="TxtNotes"
                                 TextChanged="TxtNotes_TextChanged"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="110"
                                 Style="{StaticResource FilterTextBox}"
                                 VerticalContentAlignment="Top"
                                 Padding="10"/>
                        <Button x:Name="BtnSaveNotes"
                                Style="{StaticResource PrimaryBtn}"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                IsEnabled="False"
                                Click="BtnSaveNotes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;"/>
                                <TextBlock Text="Зберегти нотатки" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch"
                      Background="#1E1E2E" Margin="0,4"/>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="14,12">
            <TabControl x:Name="ClientDataTabs" Style="{StaticResource PanelTabControl}"
                        SelectionChanged="ClientDataTabs_SelectionChanged">
                <TabItem x:Name="TabActivity" Header="Активність">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Дії клієнта" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <TextBlock x:Name="TxtActivitySummary" Text="Виберіть клієнта"
                                       FontSize="12" Foreground="#A6ADC8" HorizontalAlignment="Right"/>
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbActivityKind" Width="170" Style="{StaticResource FilterComboBox}"
                                      SelectionChanged="ActivityFilter_Changed" Margin="0,0,8,0">
                                <ComboBoxItem Tag="all" IsSelected="True">Усі дії</ComboBoxItem>
                                <ComboBoxItem Tag="firm">Фірми</ComboBoxItem>
                                <ComboBoxItem Tag="employee">Працівники</ComboBoxItem>
                                <ComboBoxItem Tag="deleted">Видалення</ComboBoxItem>
                                <ComboBoxItem Tag="app">Запуски програми</ComboBoxItem>
                            </ComboBox>
                            <Grid Width="220" Margin="0,0,8,0">
                                <TextBox x:Name="TxtActivitySearch" Style="{StaticResource FilterTextBox}"
                                         TextChanged="ActivityFilter_Changed"/>
                                <TextBlock Text="Пошук у діях">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtActivitySearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="Скинути" Style="{StaticResource GhostBtn}"
                                    Click="BtnResetActivityFilters_Click"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="2" x:Name="DgActivity" Style="{StaticResource PanelDataGrid}" FontSize="12.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" SortMemberPath="At" Width="140"/>
                                <DataGridTextColumn Header="День" Binding="{Binding DayDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Дія" Binding="{Binding ActionDisplay}" Width="170"/>
                                <DataGridTextColumn Header="Об'єкт" Binding="{Binding Subject}" Width="200"/>
                                <DataGridTextColumn Header="Де" Binding="{Binding Place}" Width="180"/>
                                <DataGridTextColumn Header="Деталі" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabSessions" Header="Сесії">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Підсумок сесій" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <TextBlock x:Name="TxtSessionsSummary" Text="Виберіть клієнта"
                                       FontSize="12" Foreground="#A6ADC8" HorizontalAlignment="Right"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="DgSessions" Style="{StaticResource PanelDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Початок" Binding="{Binding StartedAt, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="150"/>
                                <DataGridTextColumn Header="Остання активність" Binding="{Binding LastActivityAt, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="165"/>
                                <DataGridTextColumn Header="Тривалість" Binding="{Binding DurationDisplay}" Width="95"/>
                                <DataGridTextColumn Header="Версія" Binding="{Binding AppVersion}" Width="85"/>
                                <DataGridTextColumn Header="Оновлення" Binding="{Binding UpdateDisplay}" Width="110"/>
                                <DataGridTextColumn Header="+ Фірм" Binding="{Binding FirmsAdded}" Width="70"/>
                                <DataGridTextColumn Header="+ Працівників" Binding="{Binding EmployeesAdded}" Width="95"/>
                                <DataGridTextColumn Header="Помилки" Binding="{Binding ErrorCount}" Width="70"/>
                                <DataGridTextColumn Header="Підсумок" Binding="{Binding SessionSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabEvents" Header="Події">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Телеметрія" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <TextBlock x:Name="TxtTelemetrySummary" Text="Показано: 0"
                                       FontSize="12" Foreground="#A6ADC8" HorizontalAlignment="Right"/>
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbTelemetryPreset" Width="170" Style="{StaticResource FilterComboBox}"
                                      SelectionChanged="TelemetryFilter_Changed" Margin="0,0,8,0">
                                <ComboBoxItem Tag="all" IsSelected="True">Уся телеметрія</ComboBoxItem>
                                <ComboBoxItem Tag="heartbeat">Тільки heartbeat</ComboBoxItem>
                                <ComboBoxItem Tag="errors">Error-like</ComboBoxItem>
                                <ComboBoxItem Tag="license">Ліцензії / блокування</ComboBoxItem>
                                <ComboBoxItem Tag="firms">Створення фірм</ComboBoxItem>
                                <ComboBoxItem Tag="employees">Додавання працівників</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="CmbTelemetryEvent" Width="180" Style="{StaticResource FilterComboBox}"
                                      SelectionChanged="TelemetryFilter_Changed" Margin="0,0,8,0"/>
                            <Grid Width="220" Margin="0,0,8,0">
                                <TextBox x:Name="TxtTelemetrySearch" Style="{StaticResource FilterTextBox}"
                                         TextChanged="TelemetryFilter_Changed"/>
                                <TextBlock Text="Пошук у подіях">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtTelemetrySearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="Скинути" Style="{StaticResource GhostBtn}"
                                    Click="BtnResetTelemetryFilters_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnLoadMoreTelemetry" Content="Завантажити ще" Style="{StaticResource PrimaryBtn}"
                                    Visibility="Collapsed" Click="BtnLoadMoreTelemetry_Click"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="2" x:Name="DgTelemetry" Style="{StaticResource PanelDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="150"/>
                                <DataGridTextColumn Header="Подія" Binding="{Binding EventTypeDisplay}" Width="150"/>
                                <DataGridTextColumn Header="ПК" Binding="{Binding MachineId}" Width="130"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                                <DataGridTextColumn Header="Версія" Binding="{Binding AppVersion}" Width="90"/>
                                <DataGridTextColumn Header="Опис" Binding="{Binding EventSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
