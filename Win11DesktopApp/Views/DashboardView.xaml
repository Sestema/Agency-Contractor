<UserControl x:Class="Win11DesktopApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:controls="clr-namespace:Win11DesktopApp.Controls"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <CubicEase x:Key="Ease" EasingMode="EaseOut"/>

        <!-- Every stat card opens something on click, so it has to answer the mouse:
             accent outline plus a faint fill. No shadow or scale here on purpose - the cards
             are full of text and both would blur it. -->
        <!-- Spacing scale for this page: radius 12 on top-level cards, 8 on nested blocks,
             every margin and padding a multiple of 4. Dialogs keep radius 16 on purpose:
             a bigger surface carries a bigger corner. -->
        <!-- Type scale for this page - five roles, nothing in between: FS26 headline number,
             FS20 number inside a widget, FS15 title, FS13 body, FS11 caption. Weight, not
             size, separates a dialog title from a widget number at the same FS20.
             Icon FontSize is geometry, not type, and is deliberately outside this scale. -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stat card icon, deliberately monochrome. On this page color is reserved for numbers
             that mean something (red problem count, green/red movement); four bright gradients
             here were competing with the data instead of labeling it. -->
        <Style x:Key="StatCardIconBadge" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="StatCardIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DragHandle" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE700;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ToolTip" Value="{DynamicResource DashDragToSwap}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardPrimaryGhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="{DynamicResource PurpleLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PurpleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PurpleLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardWidgetCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- One step lighter than the card it sits in, never darker: the window background
                 is below the card in every theme, so using it here read as a hole punched
                 through the surface (worst in the dark themes, where it is much darker). -->
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>

        <!-- Container tier inside the dialogs: same rank as WidgetSlot on the page, so it gets
             the same radius and padding. It used to borrow DashboardWidgetCard and patch the
             padding inline, which left it with the nested radius, a stray bottom margin, and
             the same fill as the cards it contains - a list that only separated from its own
             panel by a one pixel border. -->
        <Style x:Key="DialogPanelCard" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <!-- ===== WIDGET: Expiring Documents ===== -->
        <DataTemplate x:Key="ExpiringWidget">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource DragHandle}" Tag="grip"
                               MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DashExpiringSoon}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Style="{StaticResource CompactEmptyStateCard}"
                        Padding="20,16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding DataContext.ExpiringDocs.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVis}, ConverterParameter=invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                   Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource DashAllOk}" FontSize="{DynamicResource FS13}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}"
                              Visibility="{Binding DataContext.ExpiringDocs.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVis}}">
                    <ItemsControl ItemsSource="{Binding DataContext.ExpiringDocs, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DashboardWidgetCard}" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenEmployeeDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{Binding SeverityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexToBrush}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding Subtitle, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding CompanyName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4"
                                                VerticalAlignment="Center"
                                                Background="{Binding SeverityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}">
                                            <TextBlock Text="{Binding SeverityLabel}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexToBrush}}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- ===== WIDGET: Company Stats ===== -->
        <DataTemplate x:Key="CompaniesWidget">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource DragHandle}" Tag="grip"
                               MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>
                    <TextBlock Text="{DynamicResource DashWidgetEfficiency}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <Border Style="{StaticResource DashboardWidgetCard}" Margin="0,0,4,8">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.TotalEmployeesAllTime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="{DynamicResource FS20}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource DashEfficiencyEmployeesAllTime}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardWidgetCard}" Margin="4,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.GeneratedDocumentsCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="{DynamicResource FS20}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource DashEfficiencyGeneratedDocs}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardWidgetCard}" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.ProgramTimeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="{DynamicResource FS20}" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                                <TextBlock Text="{DynamicResource DashEfficiencyProgramTime}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardWidgetCard}" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.SavedTimeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="{DynamicResource FS20}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource DashEfficiencySavedTime}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Grid.Row="1"
                               Text="{DynamicResource DashEfficiencyFormula}"
                               FontSize="{DynamicResource FS11}"
                               Foreground="{DynamicResource TertiaryForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource DashEfficiencySavedTime}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding DataContext.SavedTimeText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding DataContext.EfficiencyChartMaxMinutes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{Binding DataContext.SavedMinutes, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource SuccessBrush}"
                                     Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
                        <DockPanel Grid.Row="2" Margin="0,8,0,4">
                            <TextBlock Text="{DynamicResource DashEfficiencyProgramTime}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding DataContext.ProgramTimeText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Grid.Row="3" Minimum="0" Maximum="{Binding DataContext.EfficiencyChartMaxMinutes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{Binding DataContext.ProgramMinutes, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource InfoBrush}"
                                     Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ===== WIDGET: Salary Overview ===== -->
        <!-- ===== Charts under the salary table: minimal style (big number, one line, thin graphics) ===== -->
        <Style x:Key="ChartBigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS20}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ChartSmallText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- One thin bar line: name · 3px bar · number. The bar colour comes from the Tag of the ItemsControl. -->
        <DataTemplate x:Key="ChartThinBarRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource ForegroundBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FirmName}" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="3" Margin="8,0" VerticalAlignment="Center">
                    <Border CornerRadius="1.5" Background="{DynamicResource DividerBrush}"/>
                    <Border CornerRadius="1.5" HorizontalAlignment="Left"
                            Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <Border.Width>
                            <MultiBinding Converter="{x:Static conv:RatioToWidthConverter.Instance}">
                                <Binding Path="Ratio"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding HoursText}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" MinWidth="28" TextAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChartPayoutsTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ChartBigNumber}">
                    <Run Text="{Binding DataContext.PayoutsTotalText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" Kč" FontSize="{DynamicResource FS11}" FontWeight="Normal" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </TextBlock>
                <TextBlock Grid.Row="1" Style="{StaticResource ChartSmallText}" Text="{Binding DataContext.PayoutsSubText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <controls:MonthBarsChart Grid.Row="2" MinHeight="50" Margin="0,6,0,0" OutlineMode="True"
                                         Bars="{Binding DataContext.PayoutBars, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         PrimaryBrush="{x:Static vm:DashboardViewModel.PayoutBrush}"
                                         LabelBrush="{DynamicResource SecondaryForegroundBrush}"
                                         GridBrush="{DynamicResource DividerBrush}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource ChartSmallText}" Margin="0,4,0,0"
                           Text="{Binding DataContext.PayoutsMinMaxText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChartFirmsTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ChartBigNumber}">
                    <Run Text="{Binding DataContext.FirmPeopleTotalText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding DataContext.FirmPeopleSubText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontSize="{DynamicResource FS11}" FontWeight="Normal" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </TextBlock>
                <ItemsControl Grid.Row="1" Margin="0,8,0,0" Tag="{x:Static vm:DashboardViewModel.PeopleBrush}"
                              ItemsSource="{Binding DataContext.FirmPeopleItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ItemTemplate="{StaticResource ChartThinBarRow}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource ChartSmallText}"
                           Text="{Binding DataContext.FirmPeopleMoreText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChartHoursTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ChartBigNumber}">
                    <Run Text="{Binding DataContext.HoursTotalText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource DashChartHoursUnit}" FontSize="{DynamicResource FS11}" FontWeight="Normal" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </TextBlock>
                <TextBlock Grid.Row="1" Style="{StaticResource ChartSmallText}" Text="{Binding DataContext.HoursSubText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <ItemsControl Grid.Row="2" Margin="0,8,0,0" Tag="{x:Static vm:DashboardViewModel.HoursBrush}"
                              ItemsSource="{Binding DataContext.FirmHoursItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ItemTemplate="{StaticResource ChartThinBarRow}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChartWhoTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource ChartBigNumber}">
                    <Run Text="{Binding DataContext.VisaShareText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource DashChartOnVisa}" FontSize="{DynamicResource FS11}" FontWeight="Normal" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </TextBlock>
                <controls:SegmentBar Height="3" Margin="0,12,0,4" TrackBrush="{DynamicResource DividerBrush}"
                                     Segments="{Binding DataContext.DocumentSegments, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource ChartSmallText}" TextWrapping="Wrap"
                           Text="{Binding DataContext.DocumentSummaryText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <controls:SegmentBar Height="3" Margin="0,14,0,4" TrackBrush="{DynamicResource DividerBrush}"
                                     Segments="{Binding DataContext.GenderSegments, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource ChartSmallText}"
                           Text="{Binding DataContext.GenderSummaryText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SalaryWidget">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="90"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource DragHandle}" Tag="grip"
                               MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DashWidgetSalary}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding DataContext.SalaryTotalText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{DynamicResource FS11}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,12"
                           Visibility="{Binding DataContext.SalaryMonths.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVis}}"/>

                <Border Grid.Row="2"
                        Style="{StaticResource CompactEmptyStateCard}"
                        Padding="20,16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding DataContext.SalaryMonths.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVis}, ConverterParameter=invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{DynamicResource TertiaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource DashSalaryEmpty}" FontSize="{DynamicResource FS13}"
                                   Foreground="{DynamicResource TertiaryForegroundBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource DashSalaryEmptyMsg}" FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource TertiaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Salary table: gross − advances ± extras/deductions = to pay, + firm expenses = total -->
                <Grid Grid.Row="2" Visibility="{Binding DataContext.SalaryMonths.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1.5" Padding="0,0,0,6" Margin="0,0,10,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="100"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource DashSalColMonth}" TextAlignment="Left" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource DashSalColGross}" TextAlignment="Right" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource DashSalColAdvances}" TextAlignment="Right" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource DashSalColAdjust}" TextAlignment="Right" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource DashSalColNet}" TextAlignment="Right" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{DynamicResource DashSalColExpenses}" TextAlignment="Right" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{DynamicResource DashSalColTotal}" TextAlignment="Right" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{DynamicResource DashSalColStatus}" TextAlignment="Center" Margin="6,0"
                                           FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}">
                        <ItemsControl ItemsSource="{Binding DataContext.SalaryMonths, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="SalaryRow" Padding="0,7" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                            Background="Transparent" CornerRadius="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*" MinWidth="100"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding MonthLabel}" Margin="6,0" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GrossCell}" TextAlignment="Right" Margin="6,0"
                                                       FontSize="{DynamicResource FS12}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AdvancesCell}" TextAlignment="Right" Margin="6,0"
                                                       FontSize="{DynamicResource FS12}" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AdjustmentsCell}" TextAlignment="Right" Margin="6,0" FontSize="{DynamicResource FS12}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdjustmentNegative}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNotStarted}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock x:Name="NetCell" Grid.Column="4" Text="{Binding NetCell}" TextAlignment="Right" Margin="6,0" FontSize="{DynamicResource FS12}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="5" Text="{Binding ExpensesCell}" TextAlignment="Right" Margin="6,0"
                                                       FontSize="{DynamicResource FS12}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="6" Text="{Binding TotalCell}" TextAlignment="Right" Margin="6,0" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FS12}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="9" Padding="7,1"
                                                    Background="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.14}">
                                                <TextBlock Text="{Binding StatusCell}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNotStarted}" Value="True">
                                            <Setter TargetName="SalaryRow" Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
                                            <Setter TargetName="NetCell" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="SalaryRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SalaryRow" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </DataTemplate>

        <!-- Charts widget: the four chart blocks; the whole widget moves between slots by its ≡ -->
        <DataTemplate x:Key="ChartsWidget">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource DragHandle}" Tag="grip"
                               MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DashWidgetCharts}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <!-- Four chart blocks: drag a block by ≡ to reorder; 4 / 2 / 1 per row depending on width -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="SalaryChartsScroll_SizeChanged">
                    <ItemsControl ItemsSource="{Binding DataContext.SalaryChartBlocks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Loaded="SalaryChartsItems_Loaded">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Tag="{Binding}" AllowDrop="True" Margin="0,0,8,8" CornerRadius="10" Padding="10,8"
                                        Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        DragEnter="ChartBlock_DragEnter" DragOver="ChartBlock_DragOver" DragLeave="ChartBlock_DragLeave" Drop="ChartBlock_Drop">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="11" Cursor="SizeAll" Margin="0,1,7,0"
                                                       Foreground="{DynamicResource TertiaryForegroundBrush}" ToolTip="{DynamicResource DashChartDragHint}"
                                                       MouseLeftButtonDown="ChartGrip_MouseLeftButtonDown"/>
                                            <TextBlock FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource DashChartPayouts}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="firms"><Setter Property="Text" Value="{DynamicResource DashChartFirms}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="hours"><Setter Property="Text" Value="{DynamicResource DashChartHours}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="who"><Setter Property="Text" Value="{DynamicResource DashChartWho}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ContentControl Grid.Row="1" Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ChartPayoutsTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="firms"><Setter Property="ContentTemplate" Value="{StaticResource ChartFirmsTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="hours"><Setter Property="ContentTemplate" Value="{StaticResource ChartHoursTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="who"><Setter Property="ContentTemplate" Value="{StaticResource ChartWhoTemplate}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- Widget slot style with drop highlight -->
        <Style x:Key="WidgetSlot" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AllowDrop" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}" Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource HeaderBackButton}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                </Button>
                <Border Style="{StaticResource PageHeaderIconBadge}"
                        Background="{DynamicResource BrandPrimaryGradientBrush}">
                    <TextBlock Text="&#xE9D2;" Style="{StaticResource PageHeaderIconText}"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource DashboardTitle}" Style="{StaticResource PageHeaderTitleText}"/>
                    <TextBlock FontSize="{DynamicResource FS11}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,3,0,0">
                        <Run Text="{Binding TotalEmployees}"/>
                        <Run Text=" "/>
                        <Run Text="{DynamicResource DashWidgetEmployees}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding TotalProblems}"/>
                        <Run Text=" "/>
                        <Run Text="{DynamicResource DashWidgetProblems}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding AIReportCommand}"
                        Style="{StaticResource DashboardPrimaryGhostButton}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                                   Foreground="{DynamicResource PurpleBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource AIReportBtn}" FontSize="{DynamicResource FS13}"
                                   Foreground="{DynamicResource PurpleBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource HeaderGhostButton}"
                        Width="36"
                        Height="36"
                        ToolTip="{DynamicResource DashLoading}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Cards Row -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMonthlyMovementDetailsCommand}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MainStatMonthlyMovement}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding MonthlyMovementSummaryText}" FontSize="{DynamicResource FS26}" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource MainStatAddedShort}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding MonthlyEmployeesAddedCount}" FontSize="{DynamicResource FS11}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="5,0,10,0"/>
                            <TextBlock Text="{DynamicResource MainStatArchivedShort}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding MonthlyEmployeesArchivedCount}" FontSize="{DynamicResource FS11}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="6"/>
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0"
                                         Minimum="0"
                                         Maximum="{Binding MonthlyMovementMax}"
                                         Value="{Binding MonthlyEmployeesAddedCount}"
                                         Foreground="{DynamicResource SuccessBrush}"
                                         Background="{DynamicResource DividerBrush}"
                                         BorderThickness="0"/>
                            <ProgressBar Grid.Row="2"
                                         Minimum="0"
                                         Maximum="{Binding MonthlyMovementMax}"
                                         Value="{Binding MonthlyEmployeesArchivedCount}"
                                         Foreground="{DynamicResource ErrorBrush}"
                                         Background="{DynamicResource DividerBrush}"
                                         BorderThickness="0"/>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatCardIconBadge}">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource StatCardIconGlyph}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDocsDialogCommand}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Documents in order: ring with the share of people whose documents are fine -->
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="62" Height="62" Margin="0,0,12,0" VerticalAlignment="Center">
                            <controls:MovementRing Added="{Binding DocsOkEmployees}"
                                                   Archived="{Binding DocsNotOkEmployees}"
                                                   AddedBrush="{DynamicResource SuccessBrush}"
                                                   ArchivedBrush="{DynamicResource ErrorLightBrush}"
                                                   TrackBrush="{DynamicResource DividerBrush}"
                                                   RingThickness="8"/>
                            <TextBlock Text="{Binding DocsOkPercentText}" FontSize="{DynamicResource FS13}" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DashDocsOkTitle}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding DocsOkOfText}" FontSize="{DynamicResource FS20}" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding DocsDetailText}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource ErrorBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatCardIconBadge}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource StatCardIconGlyph}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenAllEmployeesCommand}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DashWidgetActiveEmployees}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalEmployees}" FontSize="{DynamicResource FS26}" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource DashAllCompanies}" FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatCardIconBadge}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource StatCardIconGlyph}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCompanyDetailsCommand}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SearchCatCompanies}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalCompanies}" FontSize="{DynamicResource FS26}" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource DashVisibleCompanies}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatCardIconBadge}">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource StatCardIconGlyph}"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Bottom: two columns with GridSplitter; each column holds two slots -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightCol" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column with 2 slots -->
            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LeftTopRow" Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="LeftBottomRow" Height="0.7*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- SLOT 0: Left top -->
                <Border x:Name="Slot0Border" Grid.Row="0" Style="{StaticResource WidgetSlot}" Margin="0,0,0,5"
                        Tag="0" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave" Drop="Slot_Drop">
                    <ContentControl x:Name="Slot0Content" IsTabStop="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Slot0}" Value="expiring">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ExpiringWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot0}" Value="companies">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CompaniesWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot0}" Value="salary">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SalaryWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot0}" Value="charts">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ChartsWidget}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>

                <!-- Horizontal GridSplitter between left rows -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" Cursor="SizeNS" Focusable="False" FocusVisualStyle="{x:Null}"
                              DragCompleted="LeftRowSplitter_DragCompleted"/>

                <!-- SLOT 3: Left bottom -->
                <Border x:Name="Slot3Border" Grid.Row="2" Style="{StaticResource WidgetSlot}" Margin="0,5,0,0"
                        Tag="3" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave" Drop="Slot_Drop">
                    <ContentControl x:Name="Slot3Content" IsTabStop="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Slot3}" Value="expiring">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ExpiringWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot3}" Value="companies">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CompaniesWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot3}" Value="salary">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SalaryWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot3}" Value="charts">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ChartsWidget}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </Grid>

            <!-- Vertical GridSplitter between columns -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"
                          DragCompleted="ColumnSplitter_DragCompleted"/>

            <!-- Right column with 2 slots -->
            <Grid Grid.Column="2" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RightTopRow" Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="RightBottomRow" Height="1.5*"/>
                </Grid.RowDefinitions>

                <!-- SLOT 1: Right top -->
                <Border x:Name="Slot1Border" Grid.Row="0" Style="{StaticResource WidgetSlot}" Margin="0,0,0,5"
                        Tag="1" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave" Drop="Slot_Drop">
                    <ContentControl x:Name="Slot1Content" IsTabStop="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Slot1}" Value="expiring">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ExpiringWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot1}" Value="companies">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CompaniesWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot1}" Value="salary">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SalaryWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot1}" Value="charts">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ChartsWidget}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>

                <!-- Horizontal GridSplitter between right rows -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" Cursor="SizeNS"
                              DragCompleted="RowSplitter_DragCompleted"/>

                <!-- SLOT 2: Right bottom -->
                <Border x:Name="Slot2Border" Grid.Row="2" Style="{StaticResource WidgetSlot}" Margin="0,5,0,0"
                        Tag="2" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave" Drop="Slot_Drop">
                    <ContentControl x:Name="Slot2Content" IsTabStop="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Slot2}" Value="expiring">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ExpiringWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot2}" Value="companies">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CompaniesWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot2}" Value="salary">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SalaryWidget}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot2}" Value="charts">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ChartsWidget}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsPageLoadingVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}" CornerRadius="12"/>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,18"
                    CornerRadius="14"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="84" Height="6" Margin="0,0,12,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource DividerBrush}"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DashLoading}" FontSize="{DynamicResource FS13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Employee Details Overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsEmployeeDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}" Margin="-24,-16">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EmployeeDetailsVm.CloseCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding EmployeeDetailsVm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:EmployeeDetailsViewModel}">
                        <views:EmployeeDetailsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- Monthly Movement Details Overlay (shared with the report) -->
        <views:MonthlyMovementDetailsOverlay Grid.RowSpan="3"/>
        <views:DocumentsStatusOverlay Grid.RowSpan="3"/>

        <!-- Company Details Overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsCompanyDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}" Margin="-24,-16">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCompanyDetailsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                    Width="660" MaxWidth="780" MaxHeight="560" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{DynamicResource BrandAiGradientBrush}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource SearchCatCompanies}" FontSize="{DynamicResource FS20}"
                                           FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding TotalCompanies}"/>
                                    <Run Text="{DynamicResource DashActiveCompaniesInline}"/>
                                    <Run Text="{Binding TotalEmployees}"/>
                                    <Run Text="{DynamicResource DashEmployeesInline}"/>
                                    <Run Text="{Binding TotalProblems}"/>
                                    <Run Text="{DynamicResource DashProblemsInline}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseCompanyDetailsCommand}"
                                Style="{StaticResource HeaderGhostButton}" Width="34" Height="34">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource DialogPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource DashCompanyColumn}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource DashEmployeesColumn}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource DashProblemsColumn}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource DashTemplatesColumn}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{DynamicResource DashCompaniesEmpty}"
                                       FontSize="{DynamicResource FS13}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding CompanyStats.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"/>
                            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}"
                                          Visibility="{Binding CompanyStats.Count, Converter={StaticResource IntToVis}}">
                                <ItemsControl ItemsSource="{Binding CompanyStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DashboardWidgetCard}" Margin="0,0,0,8" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenCompanyEmployeesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CompanyName}" FontSize="{DynamicResource FS13}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding EmployeeRatio, Mode=OneWay}"
                                                                     Height="4" Margin="0,6,18,0"
                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                     Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding EmployeeCount}" FontSize="{DynamicResource FS15}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Background="{DynamicResource ErrorLightBrush}">
                                                        <TextBlock Text="{Binding ProblemCount}" FontSize="{DynamicResource FS13}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding TemplateCount}" FontSize="{DynamicResource FS13}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{DynamicResource DashCompanyOpenEmployeesHint}"
                               FontSize="{DynamicResource FS11}" Foreground="{DynamicResource TertiaryForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- AI Report Overlay -->
        <Grid Visibility="{Binding IsAIReportOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAIReportCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                    MaxWidth="600" MaxHeight="520" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource PurpleBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource AIReportTitle}" FontSize="{DynamicResource FS20}"
                                   FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380"
                                  Style="{StaticResource ThinScroll}">
                        <TextBox Text="{Binding AIReportText, Mode=OneWay}" 
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 FontSize="{DynamicResource FS13}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 VerticalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Command="{Binding CloseAIReportCommand}"
                            Padding="24,8" Margin="0,14,0,0" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <TextBlock Text="{DynamicResource DetBtnClose}" FontSize="{DynamicResource FS13}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
