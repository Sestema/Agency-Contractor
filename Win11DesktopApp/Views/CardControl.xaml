<UserControl x:Class="Win11DesktopApp.Views.CardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="170">
    <UserControl.Resources>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <CubicEase x:Key="SmoothEase" EasingMode="EaseOut"/>
        <BackEase x:Key="BounceBack" EasingMode="EaseOut" Amplitude="0.3"/>
    </UserControl.Resources>
    <Grid>
        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="0" Background="Transparent" Padding="0" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" 
                            Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Width="{DynamicResource UiMenuCardW}" Height="{DynamicResource UiMenuCardH}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <!-- No DropShadowEffect here: this control is instantiated once per
                             dashboard tile (a dozen+ on screen at once), and the shadow used to
                             also animate on every hover/press - a major source of lag on
                             weak/integrated GPUs. Hover/press feedback is still conveyed via the
                             scale/translate lift below, which is cheap to render. -->
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CardTranslate" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid>
                            <!-- Soft hover tint without OpacityMask (zero intermediate GPU surface) -->
                            <Border x:Name="HoverTint"
                                    CornerRadius="17"
                                    Margin="1"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Background="{Binding IconGradient, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                            <!-- Hover accent border matching the module gradient -->
                            <Border x:Name="HoverAccentRing"
                                    CornerRadius="18"
                                    BorderThickness="1.5"
                                    BorderBrush="{Binding IconGradient, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True"/>

                            <Grid Margin="14,16,14,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Squircle icon container with soft ambient plate + top gloss -->
                                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>

                                    <Border x:Name="IconHalo"
                                            Width="76" Height="76"
                                            CornerRadius="24"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding IconGradient, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Opacity="0.12"
                                            IsHitTestVisible="False"/>

                                    <Border x:Name="IconCircle"
                                            Width="{DynamicResource UiMenuCardIcon}" Height="{DynamicResource UiMenuCardIcon}"
                                            CornerRadius="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding IconGradient, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid>
                                            <!-- Subtle top light sheen -->
                                            <Border CornerRadius="20" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#36FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#08FFFFFF" Offset="0.48"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="20"
                                                    BorderThickness="1"
                                                    BorderBrush="#38FFFFFF"
                                                    IsHitTestVisible="False"/>
                                            <Path Data="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Fill="White"
                                                  Stretch="Uniform"
                                                  Width="{DynamicResource UiMenuCardIconInner}" Height="{DynamicResource UiMenuCardIconInner}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Title -->
                                <TextBlock x:Name="TitleText" Grid.Row="1"
                                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="{DynamicResource FS13}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="2,10,2,0"/>
                            </Grid>

                            <!-- Badge inside top-right corner of the card -->
                            <Border CornerRadius="11"
                                    Background="{DynamicResource ErrorBrush}"
                                    BorderBrush="{DynamicResource CardBackgroundBrush}"
                                    BorderThickness="2"
                                    MinWidth="24" Height="22"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,10,0"
                                    Padding="6,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding BadgeCount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntToVis}}">
                                <TextBlock Text="{Binding BadgeCount, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           Foreground="White" FontSize="{DynamicResource FS11}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Static inner highlight rim: visible only in Glass themes
                                 where GlassInnerHighlightBrush is defined. In other themes
                                 the DynamicResource does not resolve, so nothing is drawn. -->
                            <Border x:Name="GlassHighlight"
                                    CornerRadius="18"
                                    BorderThickness="1,1,1,0"
                                    BorderBrush="{DynamicResource GlassInnerHighlightBrush}"
                                    Margin="1"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover: lift + scale + icon pulse (no cursor-follow reveal). -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Card lifts up -->
                                    <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                     Storyboard.TargetProperty="Y"
                                                     To="-3" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <!-- Card scales slightly -->
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.018" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.018" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <!-- Icon breathes -->
                                    <DoubleAnimation Storyboard.TargetName="IconScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.05" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="IconScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.05" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="IconHalo"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.22" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.05" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverAccentRing"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.55" Duration="0:0:0.20"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Mouse Leave: smooth return -->
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                     Storyboard.TargetProperty="Y"
                                                     To="0" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="IconScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="IconScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="IconHalo"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.13" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverAccentRing"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.3"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Press: subtle press-in -->
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="0.96" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="0.96" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                     Storyboard.TargetProperty="Y"
                                                     To="0" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Release: bounce back up -->
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.018" Duration="0:0:0.18"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.018" Duration="0:0:0.18"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                     Storyboard.TargetProperty="Y"
                                                     To="-3" Duration="0:0:0.18"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
