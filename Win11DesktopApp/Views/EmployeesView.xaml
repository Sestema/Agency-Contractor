                                                                        <DataTrigger Binding="{Binding InsuranceSeverity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding InsuranceSeverity}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
