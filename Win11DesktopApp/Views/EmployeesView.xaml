                            <!-- TILES VIEW -->
                            <ItemsControl ItemsSource="{Binding EmployeesForTiles}"
                                          ClipToBounds="False"
                                          SizeChanged="TilesItemsControl_SizeChanged"
                                          Visibility="{Binding IsTilesView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ClipToBounds="False"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='6,14,8,8'}"
                                              h:TileWidthAnimator.TargetWidth="{Binding DataContext.TileCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                                              UseLayoutRounding="True"
                                              SnapsToDevicePixels="True"
                                              TextOptions.TextFormattingMode="Ideal"
                                              TextOptions.TextRenderingMode="ClearType"
                                              TextOptions.TextHintingMode="Fixed"
                                              ContextMenu="{StaticResource EmployeeCardContextMenu}"
                                              MouseLeftButtonUp="EmployeeTileCard_MouseLeftButtonUp">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <Border x:Name="TileCard" CornerRadius="16" BorderThickness="1"
                                                    BorderBrush="{DynamicResource EmployeeTileCardBorderBrush}"
                                                    Background="{DynamicResource EmployeeTileCardBackgroundBrush}"
                                                    ClipToBounds="True" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Ellipse Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=190}"
                                                             Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=120}"
                                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,-48,-62,0'}"
                                                             IsHitTestVisible="False" Opacity="0.42"
                                                             Fill="{DynamicResource EmployeeTileDecorBlueBrush}"/>
                                                    <Ellipse Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=170}"
                                                             Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=110}"
                                                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                             Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='-70,0,0,-46'}"
                                                             IsHitTestVisible="False" Opacity="0.32"
                                                             Fill="{DynamicResource EmployeeTileDecorGreenBrush}"/>
                                                    <StackPanel Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter=16}"
                                                                TextOptions.TextFormattingMode="Ideal"
                                                                TextOptions.TextRenderingMode="ClearType"
                                                                TextOptions.TextHintingMode="Fixed">
                                                <!-- Header -->
                                                <Grid Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,0,0,8'}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="1.05*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Top"
                                                              Margin="0,4,8,0"
                                                              Checked="EmployeeSelectionCheckBox_Changed"
                                                              Unchecked="EmployeeSelectionCheckBox_Changed"
                                                              Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                                    <Grid Grid.Column="1"
                                                          Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=72}"
                                                          Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=72}"
                                                          Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,0,12,0'}">
                                                        <Border Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=74}"
                                                                Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=74}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Background="{DynamicResource EmployeeTileAvatarBackgroundBrush}"
                                                                BorderBrush="{DynamicResource EmployeeTileAvatarBorderBrush}"
                                                                BorderThickness="2"
                                                                Padding="0"
                                                                SnapsToDevicePixels="True"
                                                                CornerRadius="26">
                                                            <Border.Clip>
                                                                <RectangleGeometry Rect="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomRect}, ConverterParameter='0,0,74,74'}"
                                                                                   RadiusX="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=26}"
                                                                                   RadiusY="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=26}"/>
                                                            </Border.Clip>
                                                            <Grid>
                                                                <Image Source="{Binding PhotoPath, Converter={StaticResource ThumbnailPathConverter}, ConverterParameter=512}"
