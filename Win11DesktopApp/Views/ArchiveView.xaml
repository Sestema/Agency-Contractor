                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SortField}" Value="Firm">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{DynamicResource ArchiveSortFirm}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                        </Button>

                        <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"
                                VerticalAlignment="Center" Margin="2,0,10,0"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock Text="&#xE71C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding FirmOptions}"
                                      SelectedItem="{Binding SelectedFirm}"
                                      MinWidth="150"
                                      MaxWidth="220"
                                      Height="32"
                                      VerticalContentAlignment="Center"
                                      FontSize="{DynamicResource FS12}"
                                      ToolTip="{DynamicResource ArchiveSortFirm}"/>
                            <Button Command="{Binding ClearFilterCommand}"
                                    Style="{StaticResource ArchiveToggleButtonBase}"
                                    Margin="6,0,0,0"
                                    Padding="8,0"
                                    ToolTip="{DynamicResource ArchiveClearFilter}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                            </Button>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SetViewModeCommand}" CommandParameter="List" ToolTip="{DynamicResource ViewList}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ArchiveToggleButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                        </Button>

                        <Button Command="{Binding SetViewModeCommand}" CommandParameter="Tiles" ToolTip="{DynamicResource ViewTiles}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ArchiveToggleButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewMode}" Value="Tiles">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                        </Button>

                        <Button Command="{Binding SetViewModeCommand}" CommandParameter="Icons" ToolTip="{DynamicResource ViewIcons}" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ArchiveToggleButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewMode}" Value="Icons">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE80B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                        </Button>

                        <TextBlock Text="&#xE71E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource FS10}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Slider Value="{Binding TileSizeStep}"
                                Minimum="1"
                                Maximum="6"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Width="72"
                                Style="{StaticResource ArchiveZoomSlider}"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource EmpTileSizeTooltip}"/>
                        <Border CornerRadius="6" Padding="5,1" Margin="4,0,8,0"
                                Background="{DynamicResource ContentBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding TileSizeStep, StringFormat=x{0}}"
                                       FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center" MinWidth="14" TextAlignment="Center"
                                       ToolTip="{DynamicResource EmpTileSizeTooltip}"/>
                        </Border>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{DynamicResource ArchiveResultsLabel}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding ResultsPrimaryCount, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding ResultsSecondaryCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ClipToBounds="False">
                <Grid Visibility="{Binding HasArchivedData, Converter={StaticResource BoolToVis}}"
                      ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ClipToBounds="False">
                    <!-- LIST MODE -->
                    <ListBox ItemsSource="{Binding ArchivedForList}"
                             Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Margin="4,8,4,12"
                             ClipToBounds="False"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScroll}"/>
                        </ListBox.Resources>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6,8,12"
                                      MaxWidth="{Binding DataContext.ArchiveListMaxWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      HorizontalAlignment="Center" Cursor="Hand">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ViewEmployeeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="14" Padding="16,15"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            UseLayoutRounding="True" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27"
                                                    Background="{DynamicResource ContentBackgroundBrush}"
                                                    VerticalAlignment="Top" Margin="0,0,14,0"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding PhotoPath, Converter={StaticResource ThumbnailPathConverter}, ConverterParameter=128}"
                                                           Stretch="UniformToFill" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS20}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TertiaryForegroundBrush}"
                                                               Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource FS16}" FontWeight="Bold"
                                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                                    <Border Background="{DynamicResource InfoChipBackgroundBrush}"
                                                            BorderBrush="{DynamicResource InfoChipBorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS10}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource InfoChipForegroundBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PositionTitle}" FontSize="{DynamicResource FS12}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                        <TextBlock Text="&#xE787;" Style="{StaticResource ArchiveMetaIcon}" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Style="{StaticResource ArchiveMetaText}">
                                                            <Run Text="{DynamicResource ArchiveStarted}"/>
                                                            <Run Text="{Binding StartDate, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                        <TextBlock Text="&#xE787;" Style="{StaticResource ArchiveMetaIcon}" Foreground="{DynamicResource ErrorBrush}"/>
                                                        <TextBlock Style="{StaticResource ArchiveMetaText}">
                                                            <Run Text="{DynamicResource ArchiveEnded}"/>
                                                            <Run Text="{Binding EndDate, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"
                                                                Visibility="{Binding ArchivedOn, Converter={StaticResource InverseStrToVis}}">
                                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource ArchiveMetaIcon}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <TextBlock Style="{StaticResource ArchiveMetaText}">
                                                            <Run Text="{DynamicResource ArchiveArchivedOn}"/>
                                                            <Run Text="{Binding ArchivedOn, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </WrapPanel>
                                                <Border Background="{DynamicResource WarningChipBackgroundBrush}"
                                                        BorderBrush="{DynamicResource WarningChipBorderBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="{DynamicResource DetNoPhoto}" FontSize="{DynamicResource FS10}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                                <Button Style="{StaticResource FilledActionButton}"
                                                        Command="{Binding DataContext.RestoreEmployeeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Padding="14,8" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Foreground="White" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource ArchiveRestore}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CardActionBtn}"
                                                        Command="{Binding DataContext.ViewEmployeeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource ArchiveViewProfile}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CardActionBtn}"
                                                        Command="{Binding DataContext.OpenEmployeeFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" ToolTip="{DynamicResource ArchiveOpenFolder}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource EmpBtnFolder}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- TILES MODE -->
                    <ScrollViewer Style="{StaticResource ThinScroll}"
                                  Visibility="{Binding IsTilesView, Converter={StaticResource BoolToVis}}"
                                  ClipToBounds="False">
                        <ItemsControl ItemsSource="{Binding ArchivedForTiles}"
                                      ItemTemplate="{StaticResource ArchiveTileItemTemplate}"
                                      SizeChanged="TilesItemsControl_SizeChanged"
                                      ClipToBounds="False" Margin="4,8,4,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ClipToBounds="False"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ICONS MODE -->
                    <ScrollViewer Style="{StaticResource ThinScroll}"
                                  Visibility="{Binding IsIconsView, Converter={StaticResource BoolToVis}}"
                                  ClipToBounds="False">
                        <ItemsControl ItemsSource="{Binding ArchivedForIcons}"
                                      ItemTemplate="{StaticResource ArchiveIconItemTemplate}"
                                      SizeChanged="IconsItemsControl_SizeChanged"
                                      ClipToBounds="False" Margin="4,8,4,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ClipToBounds="False"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="1"
                            Command="{Binding ShowMoreCommand}"
                            Visibility="{Binding HasMoreToShow, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,12"
                            Padding="18,10"
                            Style="{StaticResource FilledActionButton}">
                        <TextBlock Text="{Binding ShowMoreLabel}"
                                   FontSize="{DynamicResource FS12}"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Button>
                </Grid>

                <Border Padding="28,24"
                        Visibility="{Binding HasArchivedData, Converter={StaticResource InverseBoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CompactEmptyStateCard}">
                            <Setter Property="Visibility" Value="{Binding HasArchivedData, Converter={StaticResource InverseBoolToVis}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource CompactEmptyStateIconText}" FontSize="{DynamicResource FS28}"/>
                        <TextBlock Text="{DynamicResource ArchiveEmpty}" Style="{StaticResource CompactEmptyStateTitleText}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource ArchiveEmptyDesc}"
                                   Style="{StaticResource CompactEmptyStateDescriptionText}"
                                   TextAlignment="Center"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Border>

                <Border Padding="28,24"
                        Visibility="{Binding ShowNoMatchesState, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CompactEmptyStateCard}">
                            <Setter Property="Visibility" Value="{Binding ShowNoMatchesState, Converter={StaticResource BoolToVis}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" Style="{StaticResource CompactEmptyStateIconText}" FontSize="{DynamicResource FS28}"/>
                        <TextBlock Text="{DynamicResource GlobalSearchNoResults}" Style="{StaticResource CompactEmptyStateTitleText}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource ArchiveNoMatchesDesc}"
                                   Style="{StaticResource CompactEmptyStateDescriptionText}"
                                   TextAlignment="Center"
                                   MaxWidth="360"/>
                        <Button Command="{Binding ClearFilterCommand}"
                                Margin="0,18,0,0"
                                Padding="14,8"
                                HorizontalAlignment="Center"
                                Style="{StaticResource FilledActionButton}">
                            <TextBlock Text="{DynamicResource ArchiveClearFilter}"
                                       FontSize="{DynamicResource FS12}"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource CardBackgroundBrush}" Opacity="0.4" CornerRadius="12"/>
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ModernCard}"
                            Padding="22,18"
                            CornerRadius="14"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Width="180"
                                         Height="6"
                                         Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7B8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FS16}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource DashLoading}"
                                           FontSize="{DynamicResource FS13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== RESTORE DIALOG ===== -->
        <Grid Visibility="{Binding IsRestoreDialogOpen, Converter={StaticResource BoolToVis}}"
              Style="{StaticResource OverlayFadeInGrid}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelRestoreCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource ModernDialogCard}"
                    Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="18" 
                    Width="480" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS22}" 
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ArchiveRestoreTitle}" FontSize="{DynamicResource FS18}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding EmployeeToRestore.FullName}" FontSize="{DynamicResource FS13}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Form -->
                    <TextBlock Text="{DynamicResource ArchiveFirm}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableCompanies}" 
                              SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="Name"
                              Padding="8,6" Margin="0,0,0,12" FontSize="{DynamicResource FS13}"/>

                    <TextBlock Text="{DynamicResource ArchiveStartDate}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewStartDate, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,4" FontSize="{DynamicResource FS13}"/>
                    <TextBlock Text="{DynamicResource ArchiveDateFormatHint}"
                               FontSize="{DynamicResource FS10}"
                               Foreground="{DynamicResource TertiaryForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource ArchiveSignDate}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewContractSignDate, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,4" FontSize="{DynamicResource FS13}"/>
                    <TextBlock Text="{DynamicResource ArchiveDateFormatHint}"
                               FontSize="{DynamicResource FS10}"
                               Foreground="{DynamicResource TertiaryForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource ArchivePosition}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CompanyPositions}"
                              SelectedItem="{Binding SelectedPosition}"
                              Padding="8,6" Margin="0,0,0,12" FontSize="{DynamicResource FS13}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" — " Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="{Binding MonthlySalaryBrutto, StringFormat={}{0:N0} Kč/міс, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding HourlySalary, StringFormat={}{0:N2} Kč/год, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{DynamicResource ArchiveWorkPlace}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CompanyAddresses}"
                              SelectedItem="{Binding SelectedAddress}"
                              Padding="8,6" Margin="0,0,0,16" FontSize="{DynamicResource FS13}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Street, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Number, Mode=OneWay}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding City, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ZipCode, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Status message -->
                    <TextBlock Text="{Binding RestoreStatus}" Foreground="{DynamicResource ErrorBrush}" FontSize="{DynamicResource FS12}" 
                               Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding CancelRestoreCommand}" Padding="16,8" Margin="0,0,8,0"
                                Background="{DynamicResource ContentBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource ForegroundBrush}" Cursor="Hand">
                            <TextBlock Text="{DynamicResource BtnCancel}" FontSize="{DynamicResource FS13}"/>
                        </Button>
                        <Button Command="{Binding ConfirmRestoreCommand}" Padding="16,8"
                                Background="{DynamicResource AccentBrush}" Foreground="White" 
                                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource ArchiveRestoreBtn}" FontSize="{DynamicResource FS13}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== EMPLOYEE DETAILS OVERLAY ===== -->
        <Grid Visibility="{Binding IsEmployeeDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmployeeDetailsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EmployeeDetailsVm.CloseCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding EmployeeDetailsVm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:EmployeeDetailsViewModel}">
                        <views:EmployeeDetailsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
