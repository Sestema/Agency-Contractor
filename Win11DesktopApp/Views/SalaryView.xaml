<UserControl x:Class="Win11DesktopApp.Views.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win11DesktopApp.Converters"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding CloseAdvanceDialogCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:MoneySpacesConverter x:Key="MoneySpaces"/>

        <Style x:Key="FinanceMoneyPillText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonthPickerToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,2,6,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonthPickerYearButton" TargetType="Button" BasedOn="{StaticResource HeaderGhostButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonthPickerCell" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="MonthName" Text="{Binding Name}" HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="MonthAmount" Text="{Binding AmountText}" HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter TargetName="MonthName" Property="Foreground" Value="White"/>
                                <Setter TargetName="MonthAmount" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Top bar: white outlined buttons, round capsule buttons, tiles -->
        <Style x:Key="FinToolbarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FinCapsuleRoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="30" Height="30" CornerRadius="15"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FinStatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="FinStatIconSquare" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                        PreviewMouseLeftButtonDown="CommitGridEdits_BeforeAction"
                        Style="{StaticResource HeaderBackButton}">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                </Button>

                <!-- Month navigator: spans the whole bar so it stays in the true centre of the page -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Month capsule: prev, month picker, next / create next month -->
                    <Border CornerRadius="24" Padding="5,4" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PrevMonthCommand}" Style="{StaticResource FinCapsuleRoundButton}" Margin="0,0,6,0"
                                PreviewMouseLeftButtonDown="CommitGridEdits_BeforeAction">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}"/>
                        </Button>
                        <ToggleButton x:Name="MonthPickerButton"
                                      Style="{StaticResource MonthPickerToggle}"
                                      IsChecked="{Binding IsMonthPickerOpen, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=MonthPickerPopup, Converter={StaticResource InverseBool}}"
                                      PreviewMouseLeftButtonDown="CommitGridEdits_BeforeAction">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="120" ClipToBounds="True" VerticalAlignment="Center">
                                    <TextBlock x:Name="MonthLabel"
                                               Text="{Binding MonthDisplay}"
                                               FontSize="{DynamicResource FS18}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="MonthSlide"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <Popup x:Name="MonthPickerPopup"
                               IsOpen="{Binding IsMonthPickerOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=MonthPickerButton}"
                               Placement="Bottom"
                               HorizontalOffset="-103"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Width="344" Padding="10" CornerRadius="12" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}">
                                <StackPanel>
                                    <Grid Margin="2,0,2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding PickerPrevYearCommand}"
                                                IsEnabled="{Binding HasPickerPrevYear}"
                                                Style="{StaticResource MonthPickerYearButton}">
                                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding PickerYear}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FS16}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Button Grid.Column="2" Command="{Binding PickerNextYearCommand}"
                                                IsEnabled="{Binding HasPickerNextYear}"
                                                Style="{StaticResource MonthPickerYearButton}">
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PickerMonths}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MonthPickerCell}"
                                                        Command="{Binding DataContext.SelectPickerMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding Exists}"
                                                        ToolTip="{Binding AmountToolTip}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Loading spinner -->
                        <Border Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="LoadingSpinner"
                                       Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.85"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </Border>

                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="6,0,0,0"
                                 VerticalAlignment="Center" ToolTip="{DynamicResource FinUnsavedChanges}"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>


                        <Button Command="{Binding NextMonthCommand}" Style="{StaticResource FinCapsuleRoundButton}" Margin="6,0,0,0"
                                PreviewMouseLeftButtonDown="CommitGridEdits_BeforeAction"
                                Visibility="{Binding NextMonthExists, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}"/>
                        </Button>

                        <Button Command="{Binding CreateNextMonthCommand}" Cursor="Hand" Margin="6,0,0,0"
                                PreviewMouseLeftButtonDown="CommitGridEdits_BeforeAction"
                                Visibility="{Binding NextMonthExists, Converter={StaticResource InverseBoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="15" Padding="11,6" Background="{DynamicResource SuccessLightBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource FinBtnCreateMonth}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="10,5" Margin="12,0,0,0"
                            Background="{DynamicResource WarningLightBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource FinSalaryViewOnlyHint}"
                            Visibility="{Binding ShowSalaryViewOnlyBadge, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource FinSalaryViewOnlyBadge}" FontSize="{DynamicResource FS11}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search -->
                <!-- Search: thin rounded pill, same height as the buttons; blue frame while typing -->
                <Border Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Width="210" Height="30"
                        CornerRadius="15" Padding="10,0" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center" Margin="2,0,6,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 FontSize="{DynamicResource FS12}" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 Padding="0,2" TextChanged="SearchBox_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                                                  VerticalAlignment="Center" Margin="0"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                                   Text="{DynamicResource FinSearchPlaceholder}"
                                   FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                        <Button x:Name="SearchClearBtn" Grid.Column="2"
                                Style="{StaticResource ToolbarInlineIconButton}"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="Collapsed" Margin="4,0,0,0">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Manage Columns -->
                    <Button Command="{Binding ManageColumnsCommand}" Style="{StaticResource FinToolbarButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource FinBtnManageColumns}" FontSize="{DynamicResource FS11}" 
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}" Style="{StaticResource FinToolbarButton}"
                            PreviewMouseLeftButtonDown="CommitGridEdits_BeforeAction" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource BtnSave}" FontSize="{DynamicResource FS11}" 
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource FinToolbarButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Excel" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PrintQrCommand}" Style="{StaticResource FinToolbarButton}" Margin="0,0,6,0"
                            Visibility="{Binding HasQrTransferColumn, Converter={StaticResource BoolToVis}}"
                            ToolTip="{DynamicResource FinQrPrintDesc}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED14;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource FinQrPrint}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddAdvanceCommand}" Style="{StaticResource FinToolbarButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource FinBtnAdvance}" FontSize="{DynamicResource FS11}" 
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding MarkAllPaidCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="12,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllPaid}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource FinBtnMarkAllPaid}" FontSize="{DynamicResource FS11}" 
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Display settings (name order, hours format) -->
                    <Button Command="{Binding ToggleNameOrderSettingsCommand}"
                            Style="{StaticResource ToolbarInlineIconButton}"
                            ToolTip="{DynamicResource FinDisplaySettingsTitle}"
                            Margin="6,0,0,0">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== SUMMARY TILES: colored icon squares ===== -->
            <Grid Grid.Row="1" Margin="-4,0,-4,10">
                <UniformGrid Rows="1" Columns="5">
                    <Border Style="{StaticResource FinStatTile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FinStatIconSquare}" Background="{DynamicResource AccentLightBrush}">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FinStatEmployees}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{DynamicResource FS18}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"><Run Text="{Binding TotalEmployees, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FinStatTile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FinStatIconSquare}" Background="{DynamicResource PurpleLightBrush}">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                           Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FinStatHours}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{DynamicResource FS18}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"><Run Text="{Binding TotalHours, StringFormat={}{0:N1}, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FinStatTile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FinStatIconSquare}" Background="{DynamicResource WarningLightBrush}">
                                <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                           Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FinStatGross}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{DynamicResource FS18}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"><Run Text="{Binding TotalGross, Converter={StaticResource MoneySpaces}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}" FontSize="{DynamicResource FS12}" FontWeight="Normal"/></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FinStatTile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FinStatIconSquare}" Background="{DynamicResource SuccessLightBrush}">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                           Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FinStatNet}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{DynamicResource FS18}" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetNegative}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style><Run Text="{Binding TotalNet, Converter={StaticResource MoneySpaces}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}" FontSize="{DynamicResource FS12}" FontWeight="Normal"/></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FinStatTile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FinStatIconSquare}" Background="{DynamicResource ErrorLightBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                           Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FinStatPaid}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PaidDisplay}" FontSize="{DynamicResource FS18}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllPaid}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Height="5" Margin="0,4,0,0" Minimum="0" Maximum="{Binding TotalEmployees}" Value="{Binding PaidCount, Mode=OneWay}"
                                             Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- ===== DATA GRID + SIDEBAR ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="540"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="230" MinWidth="210"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                <!-- Blue line through the whole table while a column border is dragged -->
                <Canvas x:Name="ColumnResizeGuideLayer" IsHitTestVisible="False" Panel.ZIndex="5">
                    <Border x:Name="ColumnResizeGuide" Width="2" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                </Canvas>
                <Border x:Name="DataGridBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DataGridSlide"/>
                    </Border.RenderTransform>
                    <Grid>
                    <!-- Dark strip behind the header row, full card width with rounded top corners.
                         It also fills the empty corner above the vertical scrollbar, so the header looks rounded on both sides. -->
                    <Border Height="{Binding ColumnHeaderHeight, ElementName=SalaryGrid}" VerticalAlignment="Top" CornerRadius="11,11,0,0"
                            Background="{DynamicResource FinGridHeaderBackgroundBrush}" IsHitTestVisible="False"/>
                    <DataGrid x:Name="SalaryGrid"
                              Style="{x:Null}"
                              ItemsSource="{Binding GroupedEntries}" SelectedItem="{Binding SelectedEntry}"
                              IsReadOnly="{Binding IsSalaryReadOnly}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              BeginningEdit="SalaryGrid_BeginningEdit"
                              CellEditEnding="SalaryGrid_CellEditEnding"
                              RowEditEnding="SalaryGrid_RowEditEnding"
                              CanUserResizeColumns="True" CanUserSortColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent" AlternatingRowBackground="{DynamicResource CardHoverBrush}"
                              Foreground="{DynamicResource ForegroundBrush}"
                              HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource FinGridVerticalLineBrush}"
                              ColumnHeaderHeight="42" RowHeight="34"
                              FontSize="{DynamicResource FS12}"
                              FrozenColumnCount="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ScrollViewer.CanContentScroll="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                              PreviewMouseRightButtonDown="SalaryGrid_PreviewMouseRightButtonDown"
                              Loaded="SalaryGrid_Loaded"
                              Unloaded="SalaryGrid_Unloaded">

                        <!-- Group by firm -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Border Margin="0,16,0,0" CornerRadius="12" SnapsToDevicePixels="True" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource FinGroupHeaderBorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource CardBackgroundBrush}">
                                                        <StackPanel>
                                                            <Border Padding="10,8" CornerRadius="11,11,0,0"
                                                                    Background="{DynamicResource FinGroupHeaderBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource FinGroupHeaderBorderBrush}"
                                                                    BorderThickness="0,0,0,1">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Center">
                                                                    <Border Width="22" Height="22" CornerRadius="11"
                                                                            Background="{DynamicResource FinGroupHeaderIconBackgroundBrush}"
                                                                            Margin="0,0,8,0" Opacity="0.85">
                                                                        <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="{DynamicResource FS10}"
                                                                                   Foreground="{DynamicResource FinGroupHeaderIconForegroundBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold" FontSize="{DynamicResource FS14}"
                                                                               Foreground="{DynamicResource FinGroupHeaderForegroundBrush}"
                                                                               VerticalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxWidth="480"/>
                                                                    <Border Background="{DynamicResource FinGroupHeaderCountBackgroundBrush}"
                                                                            CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                                                        <TextBlock Foreground="{DynamicResource FinGroupHeaderCountForegroundBrush}"
                                                                                   FontSize="{DynamicResource FS11}"
                                                                                   FontWeight="SemiBold" VerticalAlignment="Center">
                                                                            <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource FinGridHeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FinGridHeaderForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="1"/>
                                                </Grid.RowDefinitions>
                                                <!-- Header content -->
                                                <Border x:Name="HeaderSurface"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="0"
                                                        Margin="0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                                <!-- Transparent resize zones are layered over the header, not placed between columns. -->
                                                <Thumb x:Name="PART_LeftHeaderGripper" Grid.RowSpan="2"
                                                       HorizontalAlignment="Left" Width="4" Cursor="SizeWE"
                                                       Background="Transparent">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Grid Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                                <!-- Column border: always visible, turns blue on hover so it is clear where to drag. -->
                                                <Thumb x:Name="PART_RightHeaderGripper" Grid.RowSpan="2"
                                                       HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE"
                                                       Background="Transparent" Panel.ZIndex="2">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Grid Background="Transparent">
                                                                <Border x:Name="ResizeLine"
                                                                        Width="1"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Stretch"
                                                                        Background="{DynamicResource FinGridHeaderForegroundBrush}"
                                                                        Opacity="0.30"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ResizeLine" Property="Width" Value="3"/>
                                                                    <Setter TargetName="ResizeLine" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ResizeLine" Property="Width" Value="3"/>
                                                                    <Setter TargetName="ResizeLine" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                                <Border x:Name="HeaderUnderline" Grid.Row="1" Grid.ColumnSpan="3"
                                                        Background="{DynamicResource FinGridHeaderSeparatorBrush}"
                                                        Opacity="0.30"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter TargetName="HeaderUnderline" Property="Background" Value="{DynamicResource FinGridHeaderSortAccentBrush}"/>
                                                    <Setter TargetName="HeaderUnderline" Property="Height" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter TargetName="HeaderUnderline" Property="Background" Value="{DynamicResource FinGridHeaderSortAccentBrush}"/>
                                                    <Setter TargetName="HeaderUnderline" Property="Height" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Resources>
                            <!-- Rows have a 3px coloured stripe on the left; move the header by the same 3px so column lines meet. -->
                            <Style TargetType="DataGridColumnHeadersPresenter">
                                <Setter Property="Margin" Value="3,0,0,0"/>
                            </Style>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Color, Source={StaticResource AccentBrush}}" Opacity="0.14"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Color, Source={StaticResource AccentBrush}}" Opacity="0.10"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Color, Source={StaticResource ForegroundBrush}}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Color, Source={StaticResource ForegroundBrush}}"/>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <!-- Hours = 0: subtle orange left border (not yet filled) -->
                                    <DataTrigger Binding="{Binding HoursWorked}" Value="0">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <!-- Hover -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#142196F3"/>
                                    </Trigger>
                                    <!-- Paid -->
                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                    </DataTrigger>
                                    <!-- Finished (no longer active at firm) -->
                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                        <Setter Property="Background" Value="#10D32F2F"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <!-- Selected must remain visually strongest -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <!-- Same 3px left stripe as the other states, so the row never shifts sideways -->
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        <Setter Property="Background" Value="#262196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Name (FIXED, clickable) -->
                            <DataGridTemplateColumn IsReadOnly="True" Width="220" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColName}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Cursor="Hand" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}"/>
                                            </Grid.InputBindings>

                                            <Border x:Name="NameCell"
                                                    Padding="6,2,4,2"
                                                    CornerRadius="6"
                                                    Background="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Background" Value="#122196F3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Background" Value="#1C2196F3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                <Setter Property="Background" Value="#12D32F2F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hours (FIXED) -->
                            <DataGridTextColumn Binding="{Binding HoursDisplayText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="70" SortMemberPath="HoursWorked">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColHours}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HoursWorked}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Rate (FIXED) -->
                            <DataGridTextColumn Binding="{Binding HourlyRate, StringFormat={}{0:N0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60" SortMemberPath="HourlyRate">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColRate}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HourlyRate}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Gross/Suma (FIXED). Editable only when HourlyRate=0 (fixed monthly pay). -->
                            <DataGridTemplateColumn x:Name="GrossColumn" Width="90" SortMemberPath="GrossSalary">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColGross}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="GrossPill" CornerRadius="8" Padding="0" HorizontalAlignment="Center"
                                                Background="Transparent">
                                            <TextBlock Text="{Binding GrossSalary, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource FinanceMoneyPillText}"
                                                       Foreground="{DynamicResource FinGrossForegroundBrush}"
                                                       Opacity="0.82"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding GrossSalary}" Value="0">
                                                <Setter TargetName="GrossPill" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="GrossPill" Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanEditGrossSalary}" Value="True"/>
                                                    <Condition Binding="{Binding CanEditSalary}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="GrossPill" Property="Opacity" Value="1"/>
                                                <Setter TargetName="GrossPill" Property="Cursor" Value="IBeam"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding GrossSalary, StringFormat={}{0:N0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 TextAlignment="Center"
                                                 Padding="0"
                                                 BorderThickness="1"
                                                 Background="{DynamicResource CardBackgroundBrush}"
                                                 Foreground="{DynamicResource ForegroundBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Advance (FIXED) - click to see details popup -->
                            <DataGridTemplateColumn Width="85" IsReadOnly="True" SortMemberPath="Advance">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColAdvance}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Padding="4,2"
                                                    MouseLeftButtonDown="AdvanceCell_Click" Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanEditSalary}" Value="False">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border x:Name="AdvancePill" CornerRadius="8" Background="{DynamicResource FinAdvanceBackgroundBrush}">
                                                    <TextBlock Text="{Binding Advance, StringFormat={}{0:N0}}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FinanceMoneyPillText}">
                                                                <Setter Property="Foreground" Value="{DynamicResource FinAdvanceForegroundBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Advance}" Value="0">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Advance}" Value="0">
                                                <Setter TargetName="AdvancePill" Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DYNAMIC COLUMNS INSERTED HERE BY CODE-BEHIND (index 5+) -->

                            <!-- Net Pay (FIXED - always last-1) -->
                            <DataGridTemplateColumn x:Name="NetColumn" IsReadOnly="True" Width="95" SortMemberPath="NetSalary">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColNet}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="NetPill" CornerRadius="8" HorizontalAlignment="Center"
                                                Background="Transparent">
                                            <TextBlock Text="{Binding NetSalary, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource FinanceMoneyPillText}"
                                                       Foreground="{DynamicResource FinNetForegroundBrush}"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.9"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NetSalary}" Value="0">
                                                <Setter TargetName="NetPill" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="NetPill" Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NetSalary, Converter={x:Static local:NegativeCheckConverter.Instance}}" Value="True">
                                                <Setter TargetName="NetPill" Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Paid checkbox -->
                            <DataGridTemplateColumn Width="96" SortMemberPath="IsPaid">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✓" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPaid, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEditSalary}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand">
                                            <CheckBox.Template>
                                                <ControlTemplate TargetType="CheckBox">
                                                    <Border x:Name="PaidPill"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            MinWidth="76"
                                                            Background="{DynamicResource FinUnpaidBackgroundBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock x:Name="PaidIcon" Text="○" FontSize="{DynamicResource FS10}"
                                                                       Foreground="{DynamicResource FinUnpaidForegroundBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="PaidText" Text="{DynamicResource FinStatusUnpaid}"
                                                                       FontSize="{DynamicResource FS10}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource FinUnpaidForegroundBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="PaidPill" Property="Background" Value="{DynamicResource FinPaidBackgroundBrush}"/>
                                                            <Setter TargetName="PaidPill" Property="BorderBrush" Value="{DynamicResource FinPaidBackgroundBrush}"/>
                                                            <Setter TargetName="PaidIcon" Property="Text" Value="✓"/>
                                                            <Setter TargetName="PaidIcon" Property="Foreground" Value="{DynamicResource FinPaidForegroundBrush}"/>
                                                            <Setter TargetName="PaidText" Property="Text" Value="{DynamicResource FinColPaid}"/>
                                                            <Setter TargetName="PaidText" Property="Foreground" Value="{DynamicResource FinPaidForegroundBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PaidPill" Property="Opacity" Value="0.86"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="PaidPill" Property="Opacity" Value="0.55"/>
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </CheckBox.Template>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Note (LAST — Width="*" absorbs all remaining space) -->
                            <DataGridTextColumn x:Name="NoteColumn" Width="*" SortMemberPath="Note">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Note" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource FinColNote}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Opacity" Value="0.82"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Margin" Value="4,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <!-- Loading overlay (covers DataGrid while data reloads) -->
                <Border x:Name="LoadingOverlay" CornerRadius="12"
                        Background="{DynamicResource OverlayBrush}"
                        Opacity="0.42"
                        IsHitTestVisible="False">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="22,18"
                            CornerRadius="14"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Width="180"
                                         Height="6"
                                         Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="OverlaySpinnerIcon"
                                           Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FS16}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="OverlaySpinnerRotate"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="OverlaySpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1.0"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource DashLoading}"
                                           FontSize="{DynamicResource FS13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
                </Grid>

                <!-- ===== RIGHT SIDEBAR ===== -->
                <GridSplitter Focusable="False" FocusVisualStyle="{x:Null}" Grid.Column="1"
                              Width="8"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              DragCompleted="SidebarColumnSplitter_DragCompleted">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Width="8" Background="Transparent">
                                <Border Width="1" HorizontalAlignment="Center"
                                        Background="{DynamicResource CardBorderBrush}"/>
                                <Border Width="4" Height="42" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Opacity="0.45"/>
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Border Grid.Column="2" Margin="4,0,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="SidebarTopRow" Height="2*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="SidebarExpensesRow" Height="*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Selected firm: shown once, with a way back to all firms -->
                        <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="8" Padding="9,7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirmFiltered}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Visibility="{Binding IsFirmFiltered, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedFirmFilter}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentDarkBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedFirmFilter}"/>
                                    <TextBlock FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,1,0,0">
                                        <Run Text="{Binding TotalEmployees, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource FinPanelPeople}"/><Run Text=" · "/><Run Text="{Binding TotalHours, StringFormat={}{0:N1}, Mode=OneWay}"/><Run Text=" h · ✓ "/><Run Text="{Binding PaidCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalEmployees, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsFirmFiltered, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{DynamicResource FinExpenseAllFirms}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{DynamicResource FinPanelPickFirmHint}" FontSize="{DynamicResource FS10}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding SelectFirmCommand}" CommandParameter="" Cursor="Hand"
                                        VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{DynamicResource FinPanelShowAll}"
                                        Visibility="{Binding IsFirmFiltered, Converter={StaticResource BoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Width="24" Height="24" CornerRadius="6" Background="Transparent"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Firms caption -->
                        <Border Grid.Row="1" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource FinPanelFirmsCaption}" FontSize="{DynamicResource FS10}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FirmsSectionSummaryText}" FontSize="{DynamicResource FS10}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Firms list -->
                        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                Background="{DynamicResource WindowBackgroundBrush}" Padding="0,2">
                        <ScrollViewer Style="{StaticResource ThinScroll}">
                            <ItemsControl ItemsSource="{Binding FirmSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectFirmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding FirmName}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border x:Name="FirmRow" Background="Transparent" Padding="10,6"
                                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock x:Name="FirmName" Text="{Binding FirmName}" FontWeight="SemiBold" FontSize="{DynamicResource FS12}"
                                                                               Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FirmName}"/>
                                                                    <TextBlock FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,1,0,0">
                                                                        <Run Text="{Binding EmployeeCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TotalHours, StringFormat={}{0:N1}, Mode=OneWay}"/><Run Text=" h · ✓ "/><Run Text="{Binding PaidCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding EmployeeCount, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock x:Name="FirmTotal" Grid.Column="1" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                           Text="{Binding TotalNet, Converter={StaticResource MoneySpaces}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="SelectedBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                                                Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FirmRow" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="FirmRow" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                            <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FirmName" Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                                            <Setter TargetName="FirmTotal" Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Border>

                        <GridSplitter Focusable="False" FocusVisualStyle="{x:Null}" Grid.Row="3"
                                      Height="18"
                                      Margin="0,6,0,6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True"
                                      DragCompleted="SidebarRowSplitter_DragCompleted">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Height="18" Background="Transparent" Cursor="SizeNS" ToolTip="{DynamicResource FinPanelSplitterTip}">
                                        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource CardBorderBrush}"/>
                                        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="9" Padding="9,1"
                                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{DynamicResource FinPanelSplitterLabel}" FontSize="{DynamicResource FS10}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- ===== FIRM EXPENSES SECTION ===== -->
                        <Grid Grid.Row="4" Margin="0,0,0,0" MinHeight="140">
                            <Grid.Resources>
                                <Style x:Key="ExpenseInputBox" TargetType="TextBox">
                                    <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="ExpenseIconButton" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="22" Height="22">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Expenses caption -->
                            <Border Grid.Row="0" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource FinPanelExpensesCaption}" FontSize="{DynamicResource FS10}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ExpensesSectionSummaryText}" FontSize="{DynamicResource FS10}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            </Border>

                            <!-- Input row (only when one firm is selected) -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                <Border CornerRadius="8" Padding="8,6" Background="{DynamicResource InfoLightBrush}"
                                        Visibility="{Binding IsFirmFiltered, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                                   Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource FinExpenseSelectFirmHint}" FontSize="{DynamicResource FS11}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="8" Padding="8,6,8,8" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentLightBrush}"
                                        Visibility="{Binding CanEditSelectedFirmExpenses, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource FinExpenseNewTitle}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentDarkBrush}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="NewExpenseNameBox" Style="{StaticResource ExpenseInputBox}"
                                                 Text="{Binding NewExpenseName, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="NewExpenseName_PreviewKeyDown"/>
                                        <TextBlock Text="{DynamicResource FinExpenseNamePlaceholder}" FontSize="{DynamicResource FS12}" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource TertiaryForegroundBrush}" VerticalAlignment="Center" Margin="9,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewExpenseNameBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Popup IsOpen="{Binding IsExpenseSuggestionsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=NewExpenseNameBox}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                               Width="{Binding ActualWidth, ElementName=NewExpenseNameBox}" MinWidth="220">
                                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,2,0,0">
                                                <ListBox x:Name="ExpenseSuggestionList" ItemsSource="{Binding ExpenseSuggestions}" BorderThickness="0"
                                                         Background="Transparent" KeyDown="ExpenseSuggestionList_KeyDown"
                                                         PreviewMouseLeftButtonUp="ExpenseSuggestionList_MouseUp">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" CornerRadius="5" Padding="7,4" Background="Transparent">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FS12}"
                                                                           Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" FontSize="{DynamicResource FS11}" Margin="8,0,0,0"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                                    <Run Text="{DynamicResource FinExpenseLastAmount}"/><Run Text=" "/><Run Text="{Binding LastAmountText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="4,0,0,0">
                                        <TextBox x:Name="NewExpenseAmountBox" Style="{StaticResource ExpenseInputBox}" HorizontalContentAlignment="Right"
                                                 Text="{Binding NewExpenseAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="NewExpenseAmount_PreviewKeyDown"/>
                                        <TextBlock Text="{DynamicResource FinExpenseAmountPlaceholder}" FontSize="{DynamicResource FS12}" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource TertiaryForegroundBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewExpenseAmountBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="2" Command="{Binding AddNewExpenseCommand}" Cursor="Hand" Margin="4,0,0,0"
                                            ToolTip="{DynamicResource FinExpenseAdd}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="6" Width="28" Height="28">
                                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Expenses: compact rows, grouped by firm when all firms are shown -->
                            <ScrollViewer Grid.Row="2" Style="{StaticResource ThinScroll}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ExpenseGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,4,6" CornerRadius="8" BorderThickness="1"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource WindowBackgroundBrush}">
                                            <StackPanel>
                                                <Grid Margin="0"
                                                      Visibility="{Binding DataContext.ShowExpenseGroupHeaders, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="7,7,0,0"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"/>
                                                    <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold" Margin="8,5,0,5"
                                                               Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FirmName}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningBrush}" Margin="6,5,8,5"
                                                               Visibility="{Binding ShowTotal, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Rows}" Margin="4,3,4,3">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Row" CornerRadius="6" Padding="6,4" Margin="0" Background="Transparent">
                                                                <Grid>
                                                                    <!-- Read mode -->
                                                                    <Grid Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}" Background="Transparent">
                                                                        <Grid.InputBindings>
                                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                                          Command="{Binding DataContext.BeginEditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                        </Grid.InputBindings>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FS12}" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Name}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                                                        <Button Grid.Column="2" Style="{StaticResource ExpenseIconButton}" ToolTip="{DynamicResource FinExpenseEdit}"
                                                                                Command="{Binding DataContext.BeginEditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                                        </Button>
                                                                        <Button Grid.Column="3" Style="{StaticResource ExpenseIconButton}" ToolTip="{DynamicResource FinExpenseDelete}"
                                                                                Command="{Binding DataContext.RemoveExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Id}">
                                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                                        </Button>
                                                                    </Grid>
                                                                    <!-- Edit mode -->
                                                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="74"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Style="{StaticResource ExpenseInputBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                                                 IsVisibleChanged="ExpenseEditName_IsVisibleChanged">
                                                                            <TextBox.InputBindings>
                                                                                <KeyBinding Key="Enter" Command="{Binding DataContext.SaveExpenseEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                                <KeyBinding Key="Escape" Command="{Binding DataContext.CancelExpenseEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                            </TextBox.InputBindings>
                                                                        </TextBox>
                                                                        <TextBox Grid.Column="1" Style="{StaticResource ExpenseInputBox}" Margin="4,0,0,0" HorizontalContentAlignment="Right"
                                                                                 Text="{Binding EditAmountText, UpdateSourceTrigger=PropertyChanged}">
                                                                            <TextBox.InputBindings>
                                                                                <KeyBinding Key="Enter" Command="{Binding DataContext.SaveExpenseEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                                <KeyBinding Key="Escape" Command="{Binding DataContext.CancelExpenseEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                            </TextBox.InputBindings>
                                                                        </TextBox>
                                                                        <Button Grid.Column="2" Style="{StaticResource ExpenseIconButton}" Margin="2,0,0,0" ToolTip="{DynamicResource FinExpenseSave}"
                                                                                Command="{Binding DataContext.SaveExpenseEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                                                                        </Button>
                                                                        <Button Grid.Column="3" Style="{StaticResource ExpenseIconButton}" ToolTip="{DynamicResource BtnCancel}"
                                                                                Command="{Binding DataContext.CancelExpenseEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Grid.Row="2" Text="{DynamicResource FinExpenseEmpty}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource TertiaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoExpenses, Converter={StaticResource BoolToVis}}"/>

                        </Grid>

                        <!-- Summary boxes -->
                        <StackPanel Grid.Row="5" Margin="0,10,0,0">

                            <!-- Summary: salaries + expenses = total, like an invoice -->
                            <Border Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource FinPanelSummaryCaption}" FontSize="{DynamicResource FS10}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MonthDisplay}" FontSize="{DynamicResource FS10}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                    Background="{DynamicResource WindowBackgroundBrush}" Padding="10,6">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource FinPanelSalaries}" FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalNetText}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource FinPanelPlusExpenses}" FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalExpensesText}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                    <Border Height="1.5" Background="{DynamicResource ForegroundBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource FinStatGrandTotal}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotalText}" FontSize="{DynamicResource FS16}" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Extra stats toggle -->
                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,8,0,4"/>
                            <Button x:Name="StatsSettingsButton"
                                    Command="{Binding ToggleStatsSettingsCommand}" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalAlignment="Left" Padding="4,2" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource AccentDarkBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource FinStatsConfig}" FontSize="{DynamicResource FS10}"
                                               Foreground="{DynamicResource AccentDarkBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Stats settings popup -->
                            <Popup IsOpen="{Binding IsStatsSettingsOpen, Mode=TwoWay}"
                                   Placement="Top"
                                   PlacementTarget="{Binding ElementName=StatsSettingsButton}"
                                   VerticalOffset="-4"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border CornerRadius="8"
                                        Padding="8,6"
                                        MinWidth="210"
                                        MaxWidth="260"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
                                    </Border.Effect>
                                    <ScrollViewer Style="{StaticResource ThinScroll}"
                                                  MaxHeight="180"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <CheckBox Content="{DynamicResource FinStatPaid}" IsChecked="{Binding ShowStatPaid}"
                                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,2"/>
                                            <CheckBox Content="{DynamicResource FinStatRemaining}" IsChecked="{Binding ShowStatRemaining}"
                                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,2"/>
                                            <CheckBox Content="{DynamicResource FinStatAdvances}" IsChecked="{Binding ShowStatAdvances}"
                                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,2"/>
                                            <CheckBox Content="{DynamicResource FinStatCustomAdd}" IsChecked="{Binding ShowStatCustomAdd}"
                                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,2"/>
                                            <CheckBox Content="{DynamicResource FinStatCustomSub}" IsChecked="{Binding ShowStatCustomSub}"
                                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,2"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <!-- Extra stat: Paid -->
                            <Border Background="{DynamicResource SuccessLightBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,3"
                                    Visibility="{Binding ShowStatPaid, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FinStatPaid}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FS12}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}">
                                        <Run Text="{Binding StatPaid, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Extra stat: Remaining -->
                            <Border Background="{DynamicResource ErrorLightBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,3"
                                    Visibility="{Binding ShowStatRemaining, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FinStatRemaining}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FS12}" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}">
                                        <Run Text="{Binding StatRemaining, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Extra stat: Advances -->
                            <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,3"
                                    Visibility="{Binding ShowStatAdvances, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FinStatAdvances}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FS12}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}">
                                        <Run Text="{Binding StatAdvances, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Extra stat: Custom Add (surcharges) -->
                            <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,3"
                                    Visibility="{Binding ShowStatCustomAdd, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FinStatCustomAdd}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FS12}" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}">
                                        <Run Text="{Binding StatCustomAdd, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Extra stat: Custom Sub (accommodation etc.) -->
                            <Border Background="{DynamicResource PurpleLightBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,3"
                                    Visibility="{Binding ShowStatCustomSub, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FinStatCustomSub}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource PurpleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FS12}" FontWeight="Bold" Foreground="{DynamicResource PurpleBrush}">
                                        <Run Text="{Binding StatCustomSub, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== BOTTOM SUMMARY BAR ===== -->
            <Border Grid.Row="3" Margin="0,8,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="{DynamicResource FS12}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Net Pay -->
                    <Border Grid.Column="2" Background="{DynamicResource SuccessLightBrush}" CornerRadius="6" Padding="12,5" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource FinStatNet}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="{DynamicResource FS14}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding TotalNet, StringFormat={}{0:N2}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Grand Total -->
                    <Border Grid.Column="3" CornerRadius="6" Padding="14,5"
                            Background="{DynamicResource FinActionWarningBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource FinStatGrandTotal}" FontSize="{DynamicResource FS11}" Foreground="White"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="{DynamicResource FS15}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                                <Run Text="{Binding GrandTotal, StringFormat={}{0:N2}, Mode=OneWay}"/><Run Text="{Binding CurrencySuffix, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== ADVANCE DETAILS POPUP ===== -->
        <Popup x:Name="AdvancePopup" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade" Placement="Bottom">
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="10" 
                    Padding="14" MinWidth="260" MaxWidth="380"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="AdvancePopupTitle" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="2"
                                Click="AdvancePopupClose_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="AdvancePopupList"/>
                    <TextBlock x:Name="AdvancePopupEmpty" Text="-" FontSize="{DynamicResource FS11}" 
                               Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,4"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== DISPLAY SETTINGS DIALOG ===== -->
        <Grid Visibility="{Binding IsNameOrderSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseNameOrderSettingsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                    MinWidth="380" MaxWidth="420" Padding="20,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource FinDisplaySettingsTitle}"
                                   FontSize="{DynamicResource FS16}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CloseNameOrderSettingsCommand}"
                                Style="{StaticResource HeaderGhostButton}" Width="34" Height="34">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                        </Button>
                    </Grid>

                    <!-- Name order -->
                    <TextBlock Text="{DynamicResource FinNameOrderConfig}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
                    <RadioButton GroupName="SalaryNameOrderDialog" Content="{DynamicResource FinNameOrderFirstLast}"
                                 IsChecked="{Binding SalaryNameOrderLastFirst, Converter={StaticResource InverseBool}}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <TextBlock Text="{DynamicResource FinNameOrderFirstLastExample}" FontSize="{DynamicResource FS10}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="20,1,0,5"/>
                    <RadioButton GroupName="SalaryNameOrderDialog" Content="{DynamicResource FinNameOrderLastFirst}"
                                 IsChecked="{Binding SalaryNameOrderLastFirst}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <TextBlock Text="{DynamicResource FinNameOrderLastFirstExample}" FontSize="{DynamicResource FS10}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="20,1,0,0"/>

                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,13,0,11"/>

                    <!-- Hours format -->
                    <TextBlock Text="{DynamicResource FinHoursFormatConfig}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
                    <RadioButton GroupName="SalaryHoursFormatDialog" Content="{DynamicResource FinHoursRounded}"
                                 IsChecked="{Binding HoursCustomPrecision, Converter={StaticResource InverseBool}}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <TextBlock Text="{DynamicResource FinHoursRoundedDesc}" FontSize="{DynamicResource FS10}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="20,1,0,5"/>
                    <RadioButton GroupName="SalaryHoursFormatDialog" Content="{DynamicResource FinHoursCustom}"
                                 IsChecked="{Binding HoursCustomPrecision}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <TextBlock Text="{DynamicResource FinHoursCustomDesc}" FontSize="{DynamicResource FS10}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="20,1,0,0"/>

                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,13,0,11"/>

                    <TextBlock Text="{DynamicResource FinCurrencyConfig}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
                    <RadioButton GroupName="SalaryCurrencyDialog" Content="{DynamicResource FinCurrencyUsd}"
                                 IsChecked="{Binding IsDisplayCurrencyUsd}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <RadioButton GroupName="SalaryCurrencyDialog" Content="{DynamicResource FinCurrencyEur}"
                                 IsChecked="{Binding IsDisplayCurrencyEur}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <RadioButton GroupName="SalaryCurrencyDialog" Content="{DynamicResource FinCurrencyCzk}"
                                 IsChecked="{Binding IsDisplayCurrencyCzk}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                    <RadioButton GroupName="SalaryCurrencyDialog" Content="{DynamicResource FinCurrencyPln}"
                                 IsChecked="{Binding IsDisplayCurrencyPln}"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS11}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== ADVANCE DIALOG ===== -->
        <Grid Visibility="{Binding IsAdvanceDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAdvanceDialogCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                    Width="400" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource FinAdvanceTitle}" FontSize="{DynamicResource FS18}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource FinColName}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AdvanceName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,12" FontSize="{DynamicResource FS13}"/>

                    <TextBlock Text="{DynamicResource FinColAmount}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AdvanceAmount, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,12" FontSize="{DynamicResource FS13}"/>

                    <TextBlock Text="{DynamicResource FinAdvanceDate}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AdvanceDate}" Margin="0,0,0,12" FontSize="{DynamicResource FS13}"
                                Style="{StaticResource ThemedDatePicker}"
                                Padding="4,4"/>

                    <TextBlock Text="{DynamicResource FinAdvanceNote}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AdvanceNote, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,16" FontSize="{DynamicResource FS13}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseAdvanceDialogCommand}" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="16,9"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{DynamicResource BtnCancel}" FontSize="{DynamicResource FS13}"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding ConfirmAdvanceCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource FinActionWarningBrush}" CornerRadius="8" Padding="18,9">
                                        <TextBlock Text="{DynamicResource FinBtnConfirmAdvance}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== EMPLOYEE DETAILS OVERLAY ===== -->
        <Grid Visibility="{Binding IsEmployeeDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmployeeDetailsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EmployeeDetailsVm.CloseCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding EmployeeDetailsVm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:EmployeeDetailsViewModel}">
                        <views:EmployeeDetailsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
