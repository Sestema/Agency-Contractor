<UserControl x:Class="Win11DesktopApp.Views.EmployeesView"
             x:Name="EmployeesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             xmlns:local="clr-namespace:Win11DesktopApp.Converters"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:h="clr-namespace:Win11DesktopApp.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:StatusColorConverter x:Key="StatusColor"/>
        <local:StatusBackgroundConverter x:Key="StatusBg"/>
        <local:GenderRingBrushConverter x:Key="GenderRingBrush"/>
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StrToVis"/>
        <local:InverseStringNullOrEmptyToVisibilityConverter x:Key="InverseStrToVis"/>
        <local:NameToColorConverter x:Key="NameToColor"/>
        <local:FirstCharConverter x:Key="FirstCharConverter"/>
        <local:ZoomDoubleConverter x:Key="ZoomDouble"/>
        <local:ZoomFontSizeConverter x:Key="ZoomFontSize"/>
        <local:ZoomThicknessConverter x:Key="ZoomThickness"/>
        <local:ZoomRectConverter x:Key="ZoomRect"/>
        <local:ZoomCornerRadiusConverter x:Key="ZoomCornerRadius"/>
        <local:DocumentSeverityBrushConverter x:Key="DocSeverityBrush"/>
        <Style x:Key="StatusMessageText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusMessageBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkAwareDeleteBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerOutlineBrush}"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource DangerOutlineBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmployeeMetaIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmployeeMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmployeeDocChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
        </Style>

        <Style x:Key="EmployeeDocChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="EmployeeCardIconBtn" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>

        <Style x:Key="EmployeeCardDeleteIconBtn" TargetType="Button" BasedOn="{StaticResource DarkAwareDeleteBtn}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>

        <Style x:Key="EmployeeCardMoreBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmployeeCardPopupBtn" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinWidth" Value="210"/>
        </Style>

        <Style x:Key="EmployeeCardPopupDeleteBtn" TargetType="Button" BasedOn="{StaticResource DarkAwareDeleteBtn}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinWidth" Value="210"/>
        </Style>

        <Style x:Key="EmployeeDocPillBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="EmployeeDocPillVisaBorder" TargetType="Border" BasedOn="{StaticResource EmployeeDocPillBorder}">
            <Setter Property="Background" Value="{DynamicResource SuccessChipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessChipBorderBrush}"/>
        </Style>

        <Style x:Key="EmployeeTileStatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource EmployeeTileTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmployeeTileClearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmployeeDocPillVisaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FS9}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <!-- Segmented sort button: hover only applies while the segment is inactive (Tag is empty). -->
        <Style x:Key="SortSegmentButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value=""/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid ClipToBounds="False">
        <Border Background="{DynamicResource PageBackgroundBrush}"
                CacheMode="BitmapCache"
                RenderOptions.CachingHint="Cache"
                IsHitTestVisible="False"/>
        <Grid ClipToBounds="False"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Ideal"
              TextOptions.TextRenderingMode="ClearType"
              TextOptions.TextHintingMode="Fixed">
            <Grid Margin="24,10,24,20" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="Auto"/>  <!-- Stats + sort + view + zoom -->
                    <RowDefinition Height="Auto"/>  <!-- Selection bar -->
                    <RowDefinition Height="*"/>     <!-- List -->
                </Grid.RowDefinitions>

                <!-- ===== HEADER ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,8" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="EmpHeaderSide"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="EmpHeaderSide"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding GoBackCommand}" Style="{StaticResource HeaderBackButton}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                        </Button>
                        <Border CornerRadius="14"
                                Padding="6,5,12,5"
                                Background="{DynamicResource EmpCompanyPillBackgroundBrush}"
                                BorderBrush="{DynamicResource EmpCompanyPillBorderBrush}"
                                BorderThickness="1"
                                MaxWidth="420"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="{DynamicResource EmpCompanyPillAvatarBackgroundBrush}"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, Converter={StaticResource FirstCharConverter}}"
                                               FontSize="{DynamicResource FS13}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmpCompanyPillAvatarForegroundBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource PageHeaderTitleTextEmployees}"
                                           Foreground="{DynamicResource EmpCompanyPillForegroundBrush}"
                                           VerticalAlignment="Center"
                                           MaxWidth="300"/>
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FS12}"
                                           Foreground="{DynamicResource EmpCompanyPillCheckBrush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsCompanySelected, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1"
                          Margin="16,0,0,0"
                          Height="34"
                          MaxWidth="380"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <!-- Shadow on an empty backing border keeps the search text crisp (no rasterization). -->
                        <Border CornerRadius="20"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Effect="{DynamicResource CardShadow}"/>
                        <Border Style="{StaticResource ToolbarSearchContainer}"
                                CornerRadius="20"
                                Padding="12,0,8,0"
                                UseLayoutRounding="True"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType">
                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FS13}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                            <TextBox x:Name="EmployeeSearchBox"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"
                                     FontSize="{DynamicResource FS13}"
                                     Padding="0,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Tag" Value="{DynamicResource FinSearchPlaceholder}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="placeholder"
                                                                   Text="{TemplateBinding Tag}"
                                                                   Foreground="{DynamicResource TertiaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="{DynamicResource FS13}"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Border Grid.Column="2"
                                    CornerRadius="8"
                                    Padding="8,3"
                                    Margin="6,0,2,0"
                                    Background="{DynamicResource ContentBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource InverseStrToVis}}">
                                <TextBlock Text="Ctrl + K"
                                           FontSize="{DynamicResource FS10}"
                                           Foreground="{DynamicResource TertiaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Command="{Binding ExportToExcelCommand}"
                                Style="{StaticResource HeaderGhostButton}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource EmpTooltipExport}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}" Margin="0,0,6,0"/>
                                <TextBlock Text="Excel" FontSize="{DynamicResource FS12}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenBatchAIValidationCommand}"
                                Style="{StaticResource HeaderGhostButton}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource EmpAiCheckTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource EmpAiCheck}" FontSize="{DynamicResource FS12}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleSelectionModeCommand}"
                                Style="{StaticResource HeaderGhostButton}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource EmpTooltipSelect}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource EmpBtnSelect}" FontSize="{DynamicResource FS12}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddEmployeeCommand}" Style="{StaticResource FilledActionButton}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                                           Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource BtnAddEmployee}" FontSize="{DynamicResource FS13}"
                                           FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Skeleton loading placeholders -->
                <StackPanel Grid.Row="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ProgressBar IsIndeterminate="True" Height="3" Width="100" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource MsgEmployeesLoading}" FontSize="{DynamicResource FS11}" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonCard}" Height="72" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="44" Height="44" RadiusX="22" RadiusY="22" Style="{StaticResource SkeletonBlock}"/>
                            <StackPanel Margin="14,4,0,0">
                                <Rectangle Width="160" Height="14" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,8"/>
                                <Rectangle Width="100" Height="10" Style="{StaticResource SkeletonBlock}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonCard}" Height="72" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="44" Height="44" RadiusX="22" RadiusY="22" Style="{StaticResource SkeletonBlock}"/>
                            <StackPanel Margin="14,4,0,0">
                                <Rectangle Width="140" Height="14" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,8"/>
                                <Rectangle Width="120" Height="10" Style="{StaticResource SkeletonBlock}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonCard}" Height="72" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="44" Height="44" RadiusX="22" RadiusY="22" Style="{StaticResource SkeletonBlock}"/>
                            <StackPanel Margin="14,4,0,0">
                                <Rectangle Width="180" Height="14" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,8"/>
                                <Rectangle Width="90" Height="10" Style="{StaticResource SkeletonBlock}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== STATS + SORT + VIEW TOOLBAR ===== -->
                <Grid Grid.Row="1" Margin="0,0,0,6"
                      Visibility="{Binding HasEmployees, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="14" Background="{DynamicResource CardBackgroundBrush}"
                            Effect="{DynamicResource CardShadow}"/>
                    <Border CornerRadius="14" BorderThickness="1" Padding="8,4"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="Table" ToolTip="{DynamicResource ViewTable}"
                                        Padding="6,4" Margin="0,0,2,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewMode}" Value="Table">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                                </Button>
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="List" ToolTip="{DynamicResource ViewList}"
                                        Padding="6,4" Margin="0,0,2,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                                </Button>
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="Tiles" ToolTip="{DynamicResource ViewTiles}"
                                        Padding="6,4" Margin="0,0,2,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewMode}" Value="Tiles">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                                </Button>
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="Icons" ToolTip="{DynamicResource ViewIcons}"
                                        Padding="6,4" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewMode}" Value="Icons">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE80B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                                </Button>
