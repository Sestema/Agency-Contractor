<UserControl x:Class="Win11DesktopApp.Views.MonthlyMovementDetailsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:controls="clr-namespace:Win11DesktopApp.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="860">
    <!-- Shared by the dashboard and the report: ring, tabs and people. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <Style x:Key="DialogPanelCard" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>
    </UserControl.Resources>

        <Grid Visibility="{Binding IsMonthlyMovementDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Resources>
                <conv:StringNullOrEmptyToVisibilityConverter x:Key="MovementTextToVis"/>
                <Style x:Key="MovementSegmentButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                    <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="MovementTabButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="FontSize" Value="{DynamicResource FS13}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                        Padding="2,4,2,8" Margin="0,0,18,0">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Border Background="{DynamicResource OverlayBrush}" Margin="-24,-16">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseMonthlyMovementDetailsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                    Width="780" MaxWidth="860" Height="560" MaxHeight="600" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: title, period switch, close -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{DynamicResource BrandWarmGradientBrush}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding MovementDialogTitle}" FontSize="{DynamicResource FS20}"
                                           FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{Binding MovementPeriodHint}" FontSize="{DynamicResource FS12}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Padding="3" CornerRadius="10"
                        Visibility="{Binding ShowMovementPeriodSettings, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MovementSegmentButton}" Command="{Binding SetMovementMonthCountCommand}" CommandParameter="1"
                                        Tag="{Binding IsMovementPeriod1}" Content="{DynamicResource DashMovementPeriodShort1}"
                                        ToolTip="{DynamicResource DashMovementPeriod1Desc}"/>
                                <Button Style="{StaticResource MovementSegmentButton}" Command="{Binding SetMovementMonthCountCommand}" CommandParameter="2"
                                        Tag="{Binding IsMovementPeriod2}" Content="{DynamicResource DashMovementPeriodShort2}"
                                        ToolTip="{DynamicResource DashMovementPeriod2Desc}"/>
                                <Button Style="{StaticResource MovementSegmentButton}" Command="{Binding SetMovementMonthCountCommand}" CommandParameter="3"
                                        Tag="{Binding IsMovementPeriod3}" Content="{DynamicResource DashMovementPeriodShort3}"
                                        ToolTip="{DynamicResource DashMovementPeriod3Desc}"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="2" Command="{Binding CloseMonthlyMovementDetailsCommand}" VerticalAlignment="Center"
                                Style="{StaticResource HeaderGhostButton}" Width="34" Height="34">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: ring and short facts -->
                        <Border Style="{StaticResource DialogPanelCard}">
                            <StackPanel>
                                <Grid Width="150" Height="150" HorizontalAlignment="Center" Margin="0,4,0,12">
                                    <controls:MovementRing Added="{Binding MonthlyEmployeesAddedCount}"
                                                           Archived="{Binding MonthlyEmployeesArchivedCount}"
                                                           AddedBrush="{DynamicResource SuccessBrush}"
                                                           ArchivedBrush="{DynamicResource ErrorBrush}"
                                                           TrackBrush="{DynamicResource DividerBrush}"
                                                           RingThickness="14"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MovementNetText}" FontSize="{DynamicResource FS28}" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MovementNetCaption}" FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FS18}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center">
                                            <Run Text="+"/><Run Text="{Binding MonthlyEmployeesAddedCount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource DashMovementTabAdded}" FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FS18}" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center">
                                            <Run Text="&#x2212;"/><Run Text="{Binding MonthlyEmployeesArchivedCount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource DashMovementTabArchived}" FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

                                <StackPanel Margin="0,0,0,10" Visibility="{Binding MovementTopAddedFirmText, Converter={StaticResource MovementTextToVis}}">
                                    <TextBlock Text="{DynamicResource DashMovementTopAdded}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding MovementTopAddedFirmText}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding MovementTopAddedFirmText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" Visibility="{Binding MovementTopArchivedFirmText, Converter={StaticResource MovementTextToVis}}">
                                    <TextBlock Text="{DynamicResource DashMovementTopArchived}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding MovementTopArchivedFirmText}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding MovementTopArchivedFirmText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource DashMovementActiveNow}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding MovementActiveCount}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: tabs and people -->
                        <Border Grid.Column="2" Style="{StaticResource DialogPanelCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MovementTabButton}" Command="{Binding SelectMovementTabCommand}" CommandParameter="added"
                                                Tag="{Binding IsMovementAddedTab}">
                                            <TextBlock>
                                                <Run Text="{DynamicResource DashMovementTabAdded}"/><Run Text=" · "/><Run Text="{Binding MonthlyEmployeesAddedCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource MovementTabButton}" Command="{Binding SelectMovementTabCommand}" CommandParameter="archived"
                                                Tag="{Binding IsMovementArchivedTab}">
                                            <TextBlock>
                                                <Run Text="{DynamicResource DashMovementTabArchived}"/><Run Text=" · "/><Run Text="{Binding MonthlyEmployeesArchivedCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding MovementVisibleEmptyText}"
                                           FontSize="{DynamicResource FS13}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{Binding MovementVisibleEmployees.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"/>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}"
                                              Visibility="{Binding MovementVisibleEmployees.Count, Converter={StaticResource IntToVis}}">
                                    <ItemsControl ItemsSource="{Binding MovementVisibleEmployees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" CornerRadius="9" Padding="8,7" Margin="0,0,0,2" Cursor="Hand"
                                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.OpenMovementEmployeeDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                                                                Background="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.14}">
                                                            <TextBlock Text="{Binding Initials}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding FirmName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource FS12}"
                                                                       Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>
                                                            <Border CornerRadius="8" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Right"
                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                    Visibility="{Binding DetailText, Converter={StaticResource MovementTextToVis}}">
                                                                <TextBlock Text="{Binding DetailText}" FontSize="{DynamicResource FS10}"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{DynamicResource DashMovementOpenEmployeeHint}"
                               FontSize="{DynamicResource FS11}" Foreground="{DynamicResource TertiaryForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>

                    <!-- Loading ring while the chosen period is being read -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsMovementLoading, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.75" CornerRadius="12"/>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18" CornerRadius="14"
                                Background="{DynamicResource ContentBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Ellipse Stroke="{DynamicResource DividerBrush}" StrokeThickness="4"/>
                                    <Path Data="M22,2 A20,20 0 0 1 42,22" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform/>
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMovementLoading}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="MovementSpinStoryboard">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="MovementSpinStoryboard"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                                <TextBlock Text="{DynamicResource DashLoading}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
</UserControl>
