                                                                        <DataTrigger Binding="{Binding WorkPermitSeverity}" Value="Expired"><Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding WorkPermitSeverity}" Value="Critical"><Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding WorkPermitSeverity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding WorkPermitSeverity}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/></DataTrigger>
