<Window x:Class="Win11DesktopApp.Views.StartupRoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StartupRoleSelectionTitle}"
        Width="640"
        MinWidth="560"
        MaxWidth="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource ThinScroll}" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource PageHeaderIconBadge}">
                            <TextBlock Text="&#xE716;" Style="{StaticResource PageHeaderIconText}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Agency Contractor" FontSize="{DynamicResource FS24}" Style="{StaticResource PageHeaderTitleText}"/>
                            <TextBlock Text="{DynamicResource StartupRoleSelectionSubtitle}"
                                       FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                        <TextBlock Text="{DynamicResource LangLabel}"
                                   FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding CurrentLanguage, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Tag="uk" Content="Українська"/>
                            <ComboBoxItem Tag="en" Content="English"/>
                            <ComboBoxItem Tag="cs" Content="Čeština"/>
                            <ComboBoxItem Tag="ru" Content="Русский"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Command="{Binding ChooseOwnerCommand}"
                            Margin="0,0,8,0"
                            Padding="18,18"
                            Style="{StaticResource HeaderGhostButton}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StartupRoleOwnerTitle}"
                                       FontSize="{DynamicResource FS16}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource StartupRoleOwnerDescription}"
                                       FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ChooseMemberCommand}"
                            Margin="8,0,0,0"
                            Padding="18,18"
                            Style="{StaticResource FilledActionButton}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StartupRoleMemberTitle}"
                                       FontSize="{DynamicResource FS16}"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="{DynamicResource StartupRoleMemberDescription}"
                                       FontSize="{DynamicResource FS11}"
                                       Foreground="White"
                                       Opacity="0.92"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Padding="28,10,28,18"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}"
                        Padding="18,9"
                        Style="{StaticResource HeaderGhostButton}"
                        Content="{DynamicResource StartupRoleCancelButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
