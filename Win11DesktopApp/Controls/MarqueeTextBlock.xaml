<UserControl x:Class="Win11DesktopApp.Controls.MarqueeTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             SnapsToDevicePixels="True">
    <Grid x:Name="ClipHost" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">        <TextBlock x:Name="DisplayText"
                   Text="{Binding Text, ElementName=Root}"
                   FontSize="{Binding FontSize, ElementName=Root}"
                   FontWeight="{Binding FontWeight, ElementName=Root}"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   RenderTransformOrigin="0,0.5">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="ScrollTransform"/>
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</UserControl>
