                                       Style="{StaticResource CompactEmptyStateTitleText}"
                                       Margin="0,0,0,10"/>
                            <Button Content="{DynamicResource BtnSelectCompany}"
                                    Command="{Binding SelectCompanyCommand}"
                                    Style="{StaticResource HeaderGhostButton}"
                                    Visibility="{Binding IsCompanySelected, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Content="{DynamicResource EmpClearFilters}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Style="{StaticResource HeaderGhostButton}"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

        <!-- Loading overlay (visible while a large employee list is being prepared) -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}" Opacity="0.58"/>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24,20"
                    CornerRadius="16"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Effect="{DynamicResource DialogShadow}">
                <StackPanel MinWidth="250">
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,0,0,14"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource DividerBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7B8;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource FS16}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingMessage}"
                                   FontSize="{DynamicResource FS13}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource EmpLoadingDetails}"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FS11}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add Employee Dialog -->
        <Grid Visibility="{Binding IsAddEmployeeDialogOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddEmployeeDialogOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource OverlayBrush}"/>
            <ContentControl Content="{Binding AddEmployeeVm}" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                            Margin="10">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:AddEmployeeWizardViewModel}" xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels">
                        <views:AddEmployeeWizardView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- Employee Details Overlay -->
        <Grid Visibility="{Binding IsEmployeeDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmployeeDetailsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EmployeeDetailsVm.CloseCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding EmployeeDetailsVm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:EmployeeDetailsViewModel}" xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels">
                        <views:EmployeeDetailsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- Delete Confirm Dialog -->
        <Grid Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeleteConfirmOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource OverlayBrush}"/>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="12" Padding="24" 
                    Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS32}" 
                               HorizontalAlignment="Center" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource MsgDeleteEmployee}" FontSize="{DynamicResource FS16}" FontWeight="SemiBold" 
                               Margin="0,0,0,6" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding EmployeeToDelete.FullName}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="{DynamicResource FS14}"
                               Margin="0,0,0,20" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding CancelDeleteCommand}" Padding="18,8" Margin="0,0,10,0"
                                Background="{DynamicResource ContentBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource ForegroundBrush}" Cursor="Hand">
                            <TextBlock Text="{DynamicResource BtnCancel}" FontSize="{DynamicResource FS13}"/>
                        </Button>
                        <Button Command="{Binding ConfirmDeleteCommand}" Padding="18,8"
                                Background="{DynamicResource DangerHoverBrush}" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnDelete}" FontSize="{DynamicResource FS13}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Batch AI Validation Dialog -->
        <Grid Visibility="{Binding IsBatchAIValidationOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseBatchAIValidationCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}"
                    CornerRadius="16"
                    Width="640"
                    MaxHeight="620"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Effect="{DynamicResource DialogShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PageHeaderIconBadge}" Width="38" Height="38" Margin="0,0,10,0">
                                <TextBlock Text="&#xE945;" Style="{StaticResource PageHeaderIconText}" FontSize="{DynamicResource FS16}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource EmpAiCheckTooltip}"
                                           FontSize="{DynamicResource FS18}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource EmpAiCheckDescription}"
                                           FontSize="{DynamicResource FS12}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseBatchAIValidationCommand}"
                                Width="38"
                                Height="38"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Cursor="Hand"
                                ToolTip="{DynamicResource DetBtnClose}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="19">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="X" FontSize="{DynamicResource FS16}" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="12"
                            Padding="14"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,12"
                            Visibility="{Binding ShowBatchAIOptions, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource EmpAiCheckOptionsTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FS13}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <CheckBox Content="{DynamicResource EmpAiCheckPassport}" IsChecked="{Binding BatchAICheckPassport}" Margin="0,0,12,8"/>
                                <CheckBox Content="{DynamicResource EmpAiCheckVisa}" IsChecked="{Binding BatchAICheckVisa}" Margin="0,0,0,8"/>
                                <CheckBox Content="{DynamicResource DetDocInsurance}" IsChecked="{Binding BatchAICheckInsurance}" Margin="0,0,12,0"/>
                                <CheckBox Content="{DynamicResource ChkWorkPermit}" IsChecked="{Binding BatchAICheckPermit}"/>
                            </UniformGrid>
                            <CheckBox Content="{DynamicResource EmpAiCheckOnlySelected}"
                                      IsChecked="{Binding BatchAICheckOnlySelected}"
                                      Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button Command="{Binding ShowBatchAIOptionsCommand}"
                                Style="{StaticResource HeaderGhostButton}"
                                HorizontalAlignment="Left"
                                Padding="10,5"
                                Margin="0,0,0,8"
                                Visibility="{Binding ShowBatchAIOptions, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource EmpAiChangeOptions}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding BatchAIProgressTotal}"
                                     Value="{Binding BatchAIProgressCurrent}"
                                     Height="6"
                                     Background="{DynamicResource DividerBrush}"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding BatchAIStatusMessage}"
                                   Margin="0,8,0,0"
                                   FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"/>
                        <Border CornerRadius="10"
                                Padding="10,8"
                                Margin="0,10,0,0"
                                Background="{DynamicResource InfoChipBackgroundBrush}"
                                BorderBrush="{DynamicResource InfoChipBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsBatchAIValidationRunning, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource TagGrpEmployee}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding BatchAICurrentEmployee}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource ActLogCatDocument}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding BatchAICurrentDocument}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource EmpAiCurrentAction}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding BatchAICurrentField}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="{DynamicResource EmpAiResults}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource FS13}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <Border Grid.Row="4"
                            CornerRadius="12"
                            Background="Transparent"
                            BorderThickness="0">
                        <ScrollViewer Style="{StaticResource ThinScroll}" MaxHeight="260">
                            <ItemsControl ItemsSource="{Binding BatchAIResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Padding="12"
                                                Margin="8,8,8,0"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="error">
                                                            <Setter Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="warning">
                                                            <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="missing">
                                                            <Setter Property="Background" Value="{DynamicResource InfoChipBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource InfoChipBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding EmployeeName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="{DynamicResource FS13}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Text=" · "
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <TextBlock Text="{Binding DocumentName}"
                                                                   FontSize="{DynamicResource FS12}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}"
                                                               Margin="0,4,0,0"
                                                               FontSize="{DynamicResource FS12}"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <Grid Margin="0,8,0,0" Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{DynamicResource EmpAiProfileValue}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Text="{Binding CurrentValue}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{DynamicResource EmpAiDocumentValue}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Text="{Binding SuggestedValue}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.OpenBatchAIDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource HeaderGhostButton}"
                                                            Padding="12,7"
                                                            Margin="0,0,0,7"
                                                            Visibility="{Binding CanOpenDocument, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{DynamicResource AIValidationOpenSourceButton}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.ApplyBatchAISuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FilledActionButton}"
                                                            Padding="12,7"
                                                            Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{DynamicResource AIValidationApplyButton}" Foreground="White" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding CancelBatchAIValidationCommand}"
                                Style="{StaticResource HeaderGhostButton}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsBatchAIValidationRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource BtnCancel}"/>
                        </Button>
                        <Button Command="{Binding CloseBatchAIValidationCommand}"
                                Style="{StaticResource DialogAccentSoftButton}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsBatchAIValidationRunning, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{DynamicResource DetBtnClose}"/>
                        </Button>
                        <Button Command="{Binding StartBatchAIValidationCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Visibility="{Binding IsBatchAIValidationRunning, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource EmpAiStartCheck}" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Batch Generate Dialog -->
        <Grid Visibility="{Binding IsBatchGenerateOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBatchGenerateOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseBatchGenerateCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="12" 
                    Width="500" MaxHeight="500" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS18}" 
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource EmpBatchTitle}" FontSize="{DynamicResource FS18}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding CloseBatchGenerateCommand}"
                                Width="38" Height="38"
                                Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Cursor="Hand"
                                ToolTip="{DynamicResource DetBtnClose}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="19">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}" MaxHeight="95" Margin="0,0,0,10"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding BatchStatusMessage}" Foreground="#888" FontSize="{DynamicResource FS12}" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="2" Style="{StaticResource ThinScroll}" MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding BatchTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" 
                                            Padding="12,8" Margin="0,0,0,6" Cursor="Hand"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" 
                                                    Background="{DynamicResource InfoChipBackgroundBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Format}" VerticalAlignment="Center" 
                                                           HorizontalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FS11}"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FS14}"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource MutedForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.BatchGenerateFromTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,5" FontWeight="SemiBold"
                                                        Background="{DynamicResource AccentBrush}" Foreground="White" 
                                                        BorderThickness="0" VerticalAlignment="Center" Cursor="Hand"
                                                        Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource EmpGenerate}" FontSize="{DynamicResource FS11}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding DataContext.BatchGenerateToFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,5" FontWeight="SemiBold"
                                                        Background="{DynamicResource CardHoverBrush}"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        ToolTip="Вибрати папку для збереження">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="В папку..." FontSize="{DynamicResource FS11}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
