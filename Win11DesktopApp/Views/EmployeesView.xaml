                                                            <StackPanel Grid.Column="0" MinWidth="0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding FirstName}" FontWeight="SemiBold"
                                                                           FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=16}"
