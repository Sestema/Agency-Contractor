<UserControl x:Class="Win11DesktopApp.Views.StepCropPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Win11DesktopApp.Views">
    <UserControl.Resources>
        <local:CropTargetIconConverter x:Key="CropIcon"/>
        <local:CropAspectEqualsConverter x:Key="AspectEqual"/>

        <Geometry x:Key="GeomCropHeader">M5 2V5H2V6.6H5V13.4C5 14.28 5.72 15 6.6 15H13.4V18H15V15H18V13.4H6.6V2H5ZM8.6 5V6.6H13.4V11.4H15V6.6C15 5.72 14.28 5 13.4 5H8.6Z</Geometry>
        <Geometry x:Key="GeomRotateLeft">M10 3.2V1L6.2 4.4L10 7.8V5C13.1 5 15.6 7.5 15.6 10.6C15.6 13.7 13.1 16.2 10 16.2C6.9 16.2 4.4 13.7 4.4 10.6H2.6C2.6 14.7 5.9 18 10 18C14.1 18 17.4 14.7 17.4 10.6C17.4 6.5 14.1 3.2 10 3.2Z</Geometry>
        <Geometry x:Key="GeomRotateRight">M10 3.2V1L13.8 4.4L10 7.8V5C6.9 5 4.4 7.5 4.4 10.6C4.4 13.7 6.9 16.2 10 16.2C13.1 16.2 15.6 13.7 15.6 10.6H17.4C17.4 14.7 14.1 18 10 18C5.9 18 2.6 14.7 2.6 10.6C2.6 6.5 5.9 3.2 10 3.2Z</Geometry>
        <Geometry x:Key="GeomEnhance">M10 2L11.7 6.8L16.5 8.5L11.7 10.2L10 15L8.3 10.2L3.5 8.5L8.3 6.8L10 2ZM15.5 12.2L16.3 14.5L18.6 15.3L16.3 16.1L15.5 18.4L14.7 16.1L12.4 15.3L14.7 14.5L15.5 12.2Z</Geometry>

        <Style x:Key="CropDocItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="9,6" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CropAspectButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CropRotateButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomChipButton" TargetType="Button">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=1}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="244"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource PageHeaderIconBadge}" Background="{DynamicResource AccentBrush}">
                    <Path Data="{StaticResource GeomCropHeader}" Width="16" Height="16" Stretch="Uniform" Fill="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource StepCropPhoto}" FontSize="{DynamicResource FS16}"
                           Style="{StaticResource PageHeaderTitleText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Canvas area -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="CropCanvas" Width="600" Height="396" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Canvas x:Name="ZoomWorld" Width="600" Height="396">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ZoomTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Image x:Name="CropImage" Width="600" Height="396" Stretch="Uniform"
                                   Source="{Binding CurrentCropImagePath, Converter={StaticResource ImagePathConverter}}"/>
                        </Canvas>
                        <Rectangle x:Name="CropRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                   Fill="#266D4AFF" RadiusX="4" RadiusY="4" IsHitTestVisible="False"
                                   Visibility="{Binding IsCropPhotoMode, Converter={StaticResource BoolToVis}}"/>
                    </Canvas>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                            CornerRadius="8" Padding="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="−" Style="{StaticResource ZoomChipButton}" Click="ZoomOut_Click"/>
                            <Button x:Name="ZoomResetBtn" Content="100%" Style="{StaticResource ZoomChipButton}"
                                    MinWidth="46" Click="ZoomReset_Click"/>
                            <Button Content="+" Style="{StaticResource ZoomChipButton}" Click="ZoomIn_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="CropSideScroll"
                          Grid.Column="1"
                          Grid.RowSpan="2"
                          Margin="14,0,0,0"
                          VerticalAlignment="Stretch"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PreviewMouseWheel="OnCropSidePreviewMouseWheel">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WizDocLabel}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="2,0,0,6"/>
                    <ListBox ItemsSource="{Binding CropTargets}"
                             SelectedItem="{Binding SelectedCropTarget}"
                             ItemContainerStyle="{StaticResource CropDocItem}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Path Data="{Binding Converter={StaticResource CropIcon}}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource AccentDarkBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Command="{Binding RotateLeftCommand}"
                                ToolTip="{DynamicResource WizRotateLeft}"
                                Style="{StaticResource CropRotateButton}">
                            <Path Data="{StaticResource GeomRotateLeft}" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Command="{Binding RotateRightCommand}"
                                Margin="10,0,0,0"
                                ToolTip="{DynamicResource WizRotateRight}"
                                Style="{StaticResource CropRotateButton}">
                            <Path Data="{StaticResource GeomRotateRight}" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>

                    <!-- Enhance button (for document targets) -->
                    <Button Command="{Binding EnhanceDocumentCommand}"
                            Margin="0,0,0,6"
                            Visibility="{Binding IsCropPhotoMode, Converter={StaticResource InverseBoolToVis}}"
                            Style="{StaticResource FilledActionButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeomEnhance}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource WizEnhanceBtn}" FontSize="{DynamicResource FS13}"
                                       FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Photo crop controls (only in Фото mode) -->
                    <StackPanel Visibility="{Binding IsCropPhotoMode, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="{DynamicResource WizKeepAspect}" IsChecked="{Binding KeepAspectRatio}"
                                  Margin="2,0,0,6" FontSize="{DynamicResource FS12}"
                                  Foreground="{DynamicResource ForegroundBrush}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,8" IsEnabled="{Binding KeepAspectRatio}">
                            <RadioButton Content="1:1" Style="{StaticResource CropAspectButton}" Margin="0,0,4,0"
                                         IsChecked="{Binding CropAspectRatio, Converter={StaticResource AspectEqual}, ConverterParameter=1}"/>
                            <RadioButton Content="4:3" Style="{StaticResource CropAspectButton}" Margin="2,0"
                                         IsChecked="{Binding CropAspectRatio, Converter={StaticResource AspectEqual}, ConverterParameter=1.3333}"/>
                            <RadioButton Content="3:4" Style="{StaticResource CropAspectButton}" Margin="4,0,0,0"
                                         IsChecked="{Binding CropAspectRatio, Converter={StaticResource AspectEqual}, ConverterParameter=0.75}"/>
                        </UniformGrid>

                        <TextBlock Text="{DynamicResource WizCropInstruction}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>

                        <Button Command="{Binding ApplyCropCommand}"
                                Margin="0,0,0,8"
                                Style="{StaticResource FilledActionButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomCropHeader}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource BtnApplyCrop}" FontSize="{DynamicResource FS13}"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource WizPreviewLabel}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>

                        <Border CornerRadius="12" Width="136" Height="146" Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                ClipToBounds="True" HorizontalAlignment="Center">
                            <Image Source="{Binding CroppedPhotoPath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
