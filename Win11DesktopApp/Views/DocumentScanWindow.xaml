<Window x:Class="Win11DesktopApp.Views.DocumentScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
        xmlns:models="clr-namespace:Win11DesktopApp.Models"
        Title="{DynamicResource ScanWindowTitle}" Width="1120" Height="720"
        WindowStartupLocation="CenterOwner" MinWidth="920" MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis"/>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <ObjectDataProvider x:Key="ScanColorModes" MethodName="GetValues" ObjectType="{x:Type models:ScanColorMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ScanColorMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ScanSources" MethodName="GetValues" ObjectType="{x:Type models:ScanSource}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ScanSource"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource PageHeaderIconBadge}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource PageHeaderIconText}"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ScanWindowTitle}" FontSize="{DynamicResource FS22}" Style="{StaticResource PageHeaderTitleText}"/>
                    <TextBlock Text="{DynamicResource ScanWindowSubtitle}" FontSize="{DynamicResource FS11}"
                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                    Style="{StaticResource HeaderGhostButton}" Width="36" Height="36">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DialogSectionCard}" Padding="14">
                <ScrollViewer Style="{StaticResource ThinScroll}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ScanSettingsTitle}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ScanDeviceLabel}" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" Padding="8,4" Cursor="Hand"
                                    Style="{StaticResource HeaderGhostButton}">
                                <TextBlock Text="{DynamicResource ScanBtnRefresh}" FontSize="{DynamicResource FS11}"/>
                            </Button>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDevice}" Margin="0,0,0,6"
                                  IsEnabled="{Binding ScannerAvailable}"/>
                        <Button Command="{Binding PickDeviceCommand}" Padding="8,7" Margin="0,0,0,10" Cursor="Hand"
                                Style="{StaticResource HeaderGhostButton}">
                            <TextBlock Text="{DynamicResource ScanBtnPickDevice}" FontSize="{DynamicResource FS11}"/>
                        </Button>

                        <TextBlock Text="{DynamicResource ScanDpiLabel}" FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding SelectedDpi}" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource ScanColorLabel}" FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource ScanColorModes}}"
                                  SelectedItem="{Binding SelectedColorMode}" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource ScanSourceLabel}" FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource ScanSources}}"
                                  SelectedItem="{Binding SelectedSource}" Margin="0,0,0,14"/>

                        <Button Command="{Binding ScanPageCommand}" Margin="0,0,0,8" Padding="12,10" Cursor="Hand"
                                Style="{StaticResource FilledActionButton}" IsEnabled="{Binding CanScan}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource ScanBtnScan}" FontSize="{DynamicResource FS12}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ScanViaDialogCommand}" Margin="0,0,0,8" Padding="12,10" Cursor="Hand"
                                Style="{StaticResource HeaderGhostButton}" IsEnabled="{Binding CanScan}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource ScanBtnWindowsScan}" FontSize="{DynamicResource FS12}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ImportFromFileCommand}" Padding="12,10" Cursor="Hand"
                                Style="{StaticResource HeaderGhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource ScanBtnImport}" FontSize="{DynamicResource FS12}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource ScanNoDevicesHint}" FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding ShowNoDevicesHint, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource ScanNoScannerHint}" FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding ScannerAvailable, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DialogSectionCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource ScanPreviewTitle}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Style="{StaticResource DialogPreviewSurface}" Background="{DynamicResource WindowBackgroundBrush}">
                        <Grid>
                            <Image Source="{Binding SelectedPreviewPath, Converter={StaticResource ImagePathConverter}}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{DynamicResource ScanNoPageSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TertiaryForegroundBrush}" FontSize="{DynamicResource FS13}"
                                       Visibility="{Binding HasSelectedPage, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding EditPageCommand}" Padding="10,7" Margin="0,0,6,0" Cursor="Hand"
                                Style="{StaticResource HeaderGhostButton}">
                            <TextBlock Text="{DynamicResource ScanBtnEdit}" FontSize="{DynamicResource FS12}"/>
                        </Button>
                        <Button Command="{Binding MovePageUpCommand}" Width="34" Height="34" Margin="0,0,4,0" Cursor="Hand"
                                Style="{StaticResource ToolbarIconButton}">
                            <TextBlock Text="&#xE110;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                        </Button>
                        <Button Command="{Binding MovePageDownCommand}" Width="34" Height="34" Margin="0,0,4,0" Cursor="Hand"
                                Style="{StaticResource ToolbarIconButton}">
                            <TextBlock Text="&#xE111;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                        </Button>
                        <Button Command="{Binding DeletePageCommand}" Padding="10,7" Cursor="Hand"
                                Style="{StaticResource HeaderGhostButton}"
                                Foreground="{DynamicResource ErrorBrush}">
                            <TextBlock Text="{DynamicResource ScanBtnDelete}" FontSize="{DynamicResource FS12}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource DialogSectionCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10">
                        <Run Text="{DynamicResource ScanPagesTitle}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding PageCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScroll}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Padding="6" Margin="0,0,0,8" Background="{DynamicResource ContentBackgroundBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                                        <Border Height="110" CornerRadius="6" Background="{DynamicResource WindowBackgroundBrush}">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="{DynamicResource FS12}"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/>
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" FontSize="{DynamicResource FS12}"
                   Foreground="{DynamicResource ErrorBrush}" Margin="0,12,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>

        <Border Grid.Row="3" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,14,0,0" Margin="0,10,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{DynamicResource ScanFinishHint}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelCommand}" Padding="18,10" Margin="0,0,8,0" Cursor="Hand"
                            Style="{StaticResource HeaderGhostButton}" Content="{DynamicResource BtnCancel}"/>
                    <Button Command="{Binding FinishCommand}" Padding="18,10" Cursor="Hand"
                            Style="{StaticResource FilledActionButton}" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource ScanBtnFinish}" FontSize="{DynamicResource FS13}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
