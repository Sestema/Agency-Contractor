                                                                            <DataTrigger Binding="{Binding InsuranceSeverity}" Value="Expired"><Setter Property="Foreground" Value="{DynamicResource ErrorChipForegroundBrush}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding InsuranceSeverity}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource ErrorChipForegroundBrush}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding InsuranceSeverity}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningChipForegroundBrush}"/></DataTrigger>
