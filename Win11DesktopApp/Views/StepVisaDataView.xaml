<UserControl x:Class="Win11DesktopApp.Views.StepVisaDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Win11DesktopApp.Views">
    <UserControl.Resources>
        <Geometry x:Key="GeomVisaStep">M10 2A8 8 0 1 0 10 18A8 8 0 1 0 10 2ZM3.9 9.3H6.8C6.9 7.3 7.4 5.5 8.2 4.2A6.3 6.3 0 0 0 3.9 9.3ZM6.8 10.7H3.9A6.3 6.3 0 0 0 8.2 15.8C7.4 14.5 6.9 12.7 6.8 10.7ZM8.3 9.3H11.7C11.6 7.5 10.9 5.8 10 4.5C9.1 5.8 8.4 7.5 8.3 9.3ZM11.7 10.7H8.3C8.4 12.5 9.1 14.2 10 15.5C10.9 14.2 11.6 12.5 11.7 10.7ZM13.2 9.3H16.1A6.3 6.3 0 0 0 11.8 4.2C12.6 5.5 13.1 7.3 13.2 9.3ZM11.8 15.8A6.3 6.3 0 0 0 16.1 10.7H13.2C13.1 12.7 12.6 14.5 11.8 15.8Z</Geometry>
        <Geometry x:Key="GeomSparkleVisa">M10 2L11.7 6.8L16.5 8.5L11.7 10.2L10 15L8.3 10.2L3.5 8.5L8.3 6.8L10 2ZM15.5 12.2L16.3 14.5L18.6 15.3L16.3 16.1L15.5 18.4L14.7 16.1L12.4 15.3L14.7 14.5L15.5 12.2Z</Geometry>

        <Style x:Key="VisaFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="1,0,0,4"/>
        </Style>

        <Style x:Key="VisaFieldInput" TargetType="TextBox" BasedOn="{StaticResource WizInput}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=4}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource ThinScroll}" Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Hidden"
                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <!-- Header + AI Scan -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PageHeaderIconBadge}" Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}">
                                <Path Data="{StaticResource GeomVisaStep}" Width="16" Height="16" Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource StepVisaData}"
                                       FontSize="{DynamicResource FS16}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding AIScanDocumentCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Height="34" Padding="14,0"
                                Visibility="{Binding IsAIScanning, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomSparkleVisa}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource AIScanBtn}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin AI status banner -->
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                            Background="{DynamicResource AccentLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding AIScanStatus, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding AIScanStatus}"
                                   FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Row 0: VisaNumber | VisaType -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SecondaryStepVisaNumberLabel}" Style="{StaticResource VisaFieldLabel}"/>
                            <TextBox Text="{Binding Data.VisaNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VisaFieldInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Visibility="{Binding ShowSecondaryVisaTypeField, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource WizVisaType}" Style="{StaticResource VisaFieldLabel}"/>
                            <TextBox Text="{Binding Data.VisaType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VisaFieldInput}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: VisaStartDate | VisaExpiry -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizVisaStartDate}" Style="{StaticResource VisaFieldLabel}"/>
                            <TextBox Text="{Binding Data.VisaStartDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VisaFieldInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding SecondaryStepVisaExpiryLabel}" Style="{StaticResource VisaFieldLabel}"/>
                            <TextBox Text="{Binding Data.VisaExpiry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VisaFieldInput}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: VisaAuthority (full width) -->
                    <TextBlock Text="{Binding SecondaryStepVisaAuthorityLabel}" Style="{StaticResource VisaFieldLabel}"/>
                    <TextBox Text="{Binding Data.VisaAuthority, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VisaFieldInput}"/>

                    <!-- Row 3: WorkPermitName (full width) -->
                    <StackPanel Visibility="{Binding IsEuIdCard, Converter={StaticResource InverseBoolToVis}}">
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,10"/>
                        <TextBlock Text="{DynamicResource WizWorkPermitName}" Style="{StaticResource VisaFieldLabel}"/>
                        <TextBox Text="{Binding Data.WorkPermitName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VisaFieldInput}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"
                          Margin="0"/>
            <views:DocumentPreviewPanel Grid.Column="2" Margin="10,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
