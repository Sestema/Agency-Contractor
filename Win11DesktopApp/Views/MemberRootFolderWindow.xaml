<Window x:Class="Win11DesktopApp.Views.MemberRootFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MemberRootFolderTitle}"
        Width="620"
        MinWidth="520"
        MaxWidth="700"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource ThinScroll}" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource PageHeaderIconBadge}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource PageHeaderIconText}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource MemberRootFolderTitle}"
                                       FontSize="{DynamicResource FS24}"
                                       Style="{StaticResource PageHeaderTitleText}"/>
                            <TextBlock Text="{DynamicResource MemberRootFolderDescription}"
                                       FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                        <TextBlock Text="{DynamicResource LangLabel}"
                                   FontSize="{DynamicResource FS11}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding CurrentLanguage, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Tag="uk" Content="Українська"/>
                            <ComboBoxItem Tag="en" Content="English"/>
                            <ComboBoxItem Tag="cs" Content="Čeština"/>
                            <ComboBoxItem Tag="ru" Content="Русский"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource DialogSectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MemberRootFolderPathLabel}"
                                   FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding RootFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseCommand}"
                                    Padding="14,8"
                                    Style="{StaticResource HeaderGhostButton}"
                                    Content="{DynamicResource MemberRootFolderBrowseButton}"/>
                        </Grid>

                        <Border Background="{DynamicResource WarningLightBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Padding="28,10,28,18"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}"
                        Padding="18,9"
                        Margin="0,0,12,0"
                        Style="{StaticResource HeaderGhostButton}"
                        Content="{DynamicResource ProfileCloseButton}"/>
                <Button Command="{Binding ContinueCommand}"
                        Padding="18,9"
                        Style="{StaticResource FilledActionButton}"
                        Content="{DynamicResource MemberRootFolderContinueButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
