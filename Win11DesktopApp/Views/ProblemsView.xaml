<UserControl x:Class="Win11DesktopApp.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:DocTypeToGeometryConverter x:Key="DocTypeGeometry"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StrToVis"/>

        <!-- Severity colours live in styles rather than a converter so they survive a theme
             switch: a converter resolves the brush once when the binding is set up and is never
             asked again, because the severity itself has not changed. DynamicResource re-resolves.
             Expired and Critical share one colour, so red is the default and only the remaining
             two states need a trigger. Ok cannot reach this list, but it is covered to keep the
             behaviour identical to the converter that used to fall back to accent.

             There are two families because the employee card binds WorstSeverity while each
             document row binds Severity, and a trigger's binding is fixed inside the style. -->

        <Style x:Key="WorstSeverityStrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Filter pill. Tag carries the dot colour. The border stays 1 thick in every state so
             selecting a pill never changes its size. IsChecked is bound OneWay: ToggleButton
             flips it with SetCurrentValue, which keeps the binding alive. -->
        <Style x:Key="FilterPill" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Padding="12,0" CornerRadius="16"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{TemplateBinding Tag}"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayoutToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillCount" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}" Margin="24,10,24,16" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource HeaderBackButton}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                </Button>
                <Border Style="{StaticResource PageHeaderIconBadge}" Background="{DynamicResource ErrorBrush}">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource PageHeaderIconText}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FS22}" Style="{StaticResource PageHeaderTitleText}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FS11}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding ExportToPdfCommand}" Padding="10,6" Style="{StaticResource FilledActionButton}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                          Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M7,0 V9 M3,5 L7,9 L11,5 M1,13 H13"/>
                    <TextBlock Text="{DynamicResource ProbExportPdf}" FontSize="{DynamicResource FS12}" FontWeight="Medium"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- STATS + FILTERS -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Tag="{DynamicResource ErrorBrush}"
                              IsChecked="{Binding IsFilterExpired, Mode=OneWay}" Command="{Binding FilterExpiredCommand}"
                              ToolTip="{Binding ExpiredPeopleText}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource FilterPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExpiredCount}" Value="0">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource PillCount}" Foreground="{DynamicResource ErrorBrush}"/>
                        <TextBlock Text="{DynamicResource ProbStatExpired}" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Tag="{DynamicResource WarningBrush}"
                              IsChecked="{Binding IsFilterWarning, Mode=OneWay}" Command="{Binding FilterWarningCommand}"
                              ToolTip="{Binding WarningPeopleText}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource FilterPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WarningCount}" Style="{StaticResource PillCount}" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource ProbStatWarning}" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Tag="{DynamicResource InfoChipForegroundBrush}"
                              IsChecked="{Binding IsFilterIgnored, Mode=OneWay}" Command="{Binding FilterIgnoredCommand}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource FilterPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IgnoredCount}" Value="0">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding IgnoredCount}" Style="{StaticResource PillCount}"/>
                        <TextBlock Text="{DynamicResource ProbIgnored}" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Filters: search + firm -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search box -->
                <Border CornerRadius="10" Height="32" MinWidth="240" MaxWidth="320"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,8,0"
                        UseLayoutRounding="True"
                        TextOptions.TextFormattingMode="Display"
                        TextOptions.TextRenderingMode="ClearType">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource FS13}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 FontSize="{DynamicResource FS13}" Padding="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Tag" Value="{DynamicResource ProbSearchPlaceholder}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="placeholder"
                                                               Text="{TemplateBinding Tag}"
                                                               Foreground="{DynamicResource TertiaryForegroundBrush}"
                                                               VerticalAlignment="Center" Margin="4,0"
                                                               FontSize="{DynamicResource FS13}"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Command="{Binding ClearFiltersCommand}" Cursor="Hand"
                                VerticalAlignment="Center" Margin="4,0,0,0"
                                Visibility="{Binding SearchQuery, Converter={StaticResource StrToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Firm filter -->
                <ComboBox Height="32" MinWidth="170" MaxWidth="230"
                          Style="{StaticResource ThemedComboBox}"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding FirmOptions}"
                          SelectedItem="{Binding SelectedFirm, Mode=TwoWay}"
                          ToolTip="{DynamicResource ProbAllFirms}"/>

                <Border Width="1" Height="20" Margin="12,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerBrush}"/>

                <!-- Layout: one card per row or two. Icons are drawn rather than taken from an
                     icon font, so they cannot fall back to empty boxes. -->
                <Border Height="32" CornerRadius="10" Padding="2"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource LayoutToggle}"
                                      IsChecked="{Binding IsOneColumn, Mode=OneWay}" Command="{Binding SetOneColumnCommand}"
                                      ToolTip="{DynamicResource ProbViewOneColumn}">
                            <Path Width="14" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M1,0 H13 A1,1 0 0 1 14,1 V4 A1,1 0 0 1 13,5 H1 A1,1 0 0 1 0,4 V1 A1,1 0 0 1 1,0 Z
                                        M1,7 H13 A1,1 0 0 1 14,8 V11 A1,1 0 0 1 13,12 H1 A1,1 0 0 1 0,11 V8 A1,1 0 0 1 1,7 Z"/>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LayoutToggle}"
                                      IsChecked="{Binding IsTwoColumns, Mode=OneWay}" Command="{Binding SetTwoColumnsCommand}"
                                      ToolTip="{DynamicResource ProbViewTwoColumns}">
                            <Path Width="14" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M1,0 H5 A1,1 0 0 1 6,1 V4 A1,1 0 0 1 5,5 H1 A1,1 0 0 1 0,4 V1 A1,1 0 0 1 1,0 Z
                                        M9,0 H13 A1,1 0 0 1 14,1 V4 A1,1 0 0 1 13,5 H9 A1,1 0 0 1 8,4 V1 A1,1 0 0 1 9,0 Z
                                        M1,7 H5 A1,1 0 0 1 6,8 V11 A1,1 0 0 1 5,12 H1 A1,1 0 0 1 0,11 V8 A1,1 0 0 1 1,7 Z
                                        M9,7 H13 A1,1 0 0 1 14,8 V11 A1,1 0 0 1 13,12 H9 A1,1 0 0 1 8,11 V8 A1,1 0 0 1 9,7 Z"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- PROBLEMS LIST (grouped by employee) -->
        <Grid Grid.Row="2">
            <ItemsControl ItemsSource="{Binding ProblemGroups}" Margin="10,2,10,4"
                          Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource ThinScroll}" Padding="10" CanContentScroll="True" Focusable="False" ClipToBounds="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <!-- One column keeps the virtualizing panel. Two columns use a WrapPanel with each
                     card sized to half the viewport: WrapPanel does not virtualize, which is fine
                     at this list's size, and unlike UniformGrid it does not force every row to the
                     height of the tallest card. -->
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTwoColumns}" Value="True">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                            <Setter Property="Width"
                                                    Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={x:Static conv:ColumnWidthConverter.Instance}}"/>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <!-- No entry animation and no RenderTransform on these cards on purpose.
                             The panel recycles containers, so a Loaded-driven fade replays every
                             time a card scrolls back into view, and fading a card full of text
                             pushes it through an opacity layer that softens the glyphs. -->
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                                    Padding="0" Margin="10,4,10,7"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Cursor="Hand"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="ClearType"
                                    MouseLeftButtonDown="EmployeeCard_MouseLeftButtonDown"
                                    Effect="{x:Null}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity color strip (worst severity). Inset top and bottom so the bar
                                         never reaches the card's corner arcs, which curve inward for the first
                                         11 device pixels and would otherwise clip its ends. The radius has to
                                         stay at or below half the 5 width, or WPF trims it back to fit. -->
                                    <Border Grid.Column="0" Margin="0,10" CornerRadius="2.5"
                                            Style="{StaticResource WorstSeverityStrip}"/>

                                    <Grid Grid.Column="1" Margin="12,10,12,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Employee header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Initials -->
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Initials}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + firm -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EmployeeName}" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="{DynamicResource ProbIssueCount}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <TextBlock Text="{Binding IssueCount}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Open employee button -->
                                            <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand"
                                                    Command="{Binding DataContext.OpenEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource ProbOpenTooltip}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{DynamicResource ProbOpen}" FontSize="{DynamicResource FS11}"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Issues list -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- One line per document. Name and date columns have fixed widths so
                                                         dates and badges line up across every card; a shared size scope would
                                                         also work but re-measures as virtualized cards scroll in and out. -->
                                                    <Border x:Name="Row" Margin="0,0,0,1" Padding="6,4" CornerRadius="7"
                                                            Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="95"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                                <Path Data="{Binding DocumentType, Converter={StaticResource DocTypeGeometry}}"
                                                                      Stretch="Uniform" Width="14" Height="14"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Stroke="{DynamicResource SecondaryForegroundBrush}"
                                                                      StrokeThickness="1.5" Fill="Transparent"
                                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1" Text="{Binding DocumentTypeDisplay}"
                                                                       FontSize="{DynamicResource FS13}" FontWeight="Medium"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,12,0" ToolTip="{Binding DocumentTypeDisplay}"/>

                                                            <TextBlock Grid.Column="2" Text="{Binding ExpiryDateStr}"
                                                                       FontSize="{DynamicResource FS12}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       VerticalAlignment="Center"/>

                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border CornerRadius="6" Padding="7,2"
                                                                        UseLayoutRounding="True" SnapsToDevicePixels="True"
                                                                        Style="{StaticResource SeverityTile}"
                                                                        ToolTip="{Binding DaysRemaining, Converter={x:Static conv:DaysRemainingTextConverter.Instance}, ConverterParameter=exact}">
                                                                    <TextBlock Text="{Binding DaysRemaining, Converter={x:Static conv:DaysRemainingTextConverter.Instance}}"
                                                                               Style="{StaticResource SeverityText}"/>
                                                                </Border>
                                                                <Border CornerRadius="6" Padding="7,2" Margin="6,0,0,0"
                                                                        Background="{DynamicResource AccentLightBrush}"
                                                                        Visibility="{Binding IgnoredUntil, Converter={StaticResource StrToVis}}">
                                                                    <TextBlock FontSize="{DynamicResource FS11}" FontWeight="Medium"
                                                                               Foreground="{DynamicResource AccentDarkBrush}">
                                                                        <Run Text="{DynamicResource ProbUntil}"/><Run Text="{Binding IgnoredUntil, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">

                                                            <!-- Close validity — custom signed documents only -->
                                                            <Button VerticalAlignment="Center" Cursor="Hand"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.CloseCustomDocumentValidityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsCustomDocument, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{DynamicResource ProbCloseValidityTooltip}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,3">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource SuccessChipForegroundBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{DynamicResource ProbCloseValidity}" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource SuccessChipForegroundBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Restore button — ignored view only -->
                                                            <Button VerticalAlignment="Center" Cursor="Hand"
                                                                    Command="{Binding DataContext.RestoreProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding DataContext.IsFilterIgnored, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{DynamicResource ProbRestoreTooltip}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,3">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{DynamicResource ProbRestore}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource AccentBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Ignore button -->
                                                            <Button VerticalAlignment="Center" Cursor="Hand"
                                                                    Command="{Binding DataContext.IgnoreProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding DataContext.IsFilterIgnored, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}"
                                                                    ToolTip="{DynamicResource ProbIgnoreTooltip}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,3">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{DynamicResource ProbIgnore}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <!-- Empty state: no problems at all -->
            <Border Style="{StaticResource CompactEmptyStateCard}"
                    Padding="28,24"
                    Visibility="{Binding IsAllClear, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource CompactEmptyStateIconText}"
                               FontSize="{DynamicResource FS28}" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource ProbAllOk}" Style="{StaticResource CompactEmptyStateTitleText}"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource ProbAllOkDesc}" Style="{StaticResource CompactEmptyStateDescriptionText}"/>
                </StackPanel>
            </Border>

            <!-- Empty state: ignored view with nothing ignored -->
            <Border Style="{StaticResource CompactEmptyStateCard}"
                    Padding="28,24"
                    Visibility="{Binding IsIgnoredEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7E7;" Style="{StaticResource CompactEmptyStateIconText}"
                               FontSize="{DynamicResource FS28}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource ProbNoIgnored}" Style="{StaticResource CompactEmptyStateTitleText}"/>
                    <TextBlock Text="{DynamicResource ProbNoIgnoredDesc}" Style="{StaticResource CompactEmptyStateDescriptionText}"/>
                </StackPanel>
            </Border>

            <!-- Empty state: problems exist but filter/search hides them all -->
            <Border Style="{StaticResource CompactEmptyStateCard}"
                    Padding="28,24"
                    Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" Style="{StaticResource CompactEmptyStateIconText}"
                               FontSize="{DynamicResource FS28}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource ProbNoMatches}" Style="{StaticResource CompactEmptyStateTitleText}"/>
                    <TextBlock Text="{DynamicResource ProbNoMatchesDesc}" Style="{StaticResource CompactEmptyStateDescriptionText}"/>
                    <Button Command="{Binding ClearFiltersCommand}" Cursor="Hand"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Style="{StaticResource FilledActionButton}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource ProbClearFilters}" FontSize="{DynamicResource FS12}"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Employee Details Overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsEmployeeDetailsOpen, Converter={StaticResource BoolToVis}}">
            <!-- Only the dim fades in. The same animation used to sit on this Grid, which meant
                 the whole employee card - a very large view full of text - was pushed through a
                 half-screen opacity buffer for the whole quarter second. The dim is a flat rect
                 with no children, so fading it costs nothing; the card itself just appears. -->
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmployeeDetailsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EmployeeDetailsVm.CloseCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding EmployeeDetailsVm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:EmployeeDetailsViewModel}">
                        <views:EmployeeDetailsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
