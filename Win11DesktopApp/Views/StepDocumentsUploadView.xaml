<UserControl x:Class="Win11DesktopApp.Views.StepDocumentsUploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Geometry x:Key="GeomPassport">M4 2.5C4 1.67 4.67 1 5.5 1H14.5C15.33 1 16 1.67 16 2.5V17.5C16 18.33 15.33 19 14.5 19H5.5C4.67 19 4 18.33 4 17.5V2.5ZM6 3V17H14V3H6ZM10 5.4A2.2 2.2 0 1 1 10 9.8A2.2 2.2 0 1 1 10 5.4ZM7.3 12.6C7.7 11.4 8.75 10.7 10 10.7C11.25 10.7 12.3 11.4 12.7 12.6H7.3ZM7.2 14.4H12.8V15.5H7.2V14.4Z</Geometry>
        <Geometry x:Key="GeomPassport2">M5 2C4.45 2 4 2.45 4 3V17C4 17.55 4.45 18 5 18H15C15.55 18 16 17.55 16 17V3C16 2.45 15.55 2 15 2H5ZM6.5 5H13.5V6.3H6.5V5ZM6.5 8H13.5V9.3H6.5V8ZM6.5 11H11.5V12.3H6.5V11ZM6.5 14H13.5V15.2H6.5V14Z</Geometry>
        <Geometry x:Key="GeomIdCard">M2 4.5C2 3.67 2.67 3 3.5 3H16.5C17.33 3 18 3.67 18 4.5V15.5C18 16.33 17.33 17 16.5 17H3.5C2.67 17 2 16.33 2 15.5V4.5ZM3.7 5V15H16.3V5H3.7ZM6.8 6.8A1.6 1.6 0 1 1 6.8 10A1.6 1.6 0 1 1 6.8 6.8ZM4.7 12.8C5 11.7 5.8 11.1 6.8 11.1C7.8 11.1 8.6 11.7 8.9 12.8H4.7ZM10.4 7.3H15V8.5H10.4V7.3ZM10.4 10H15V11.2H10.4V10ZM10.4 12.6H13.5V13.8H10.4V12.6Z</Geometry>
        <Geometry x:Key="GeomVisa">M10 2A8 8 0 1 0 10 18A8 8 0 1 0 10 2ZM3.9 9.3H6.8C6.9 7.3 7.4 5.5 8.2 4.2A6.3 6.3 0 0 0 3.9 9.3ZM6.8 10.7H3.9A6.3 6.3 0 0 0 8.2 15.8C7.4 14.5 6.9 12.7 6.8 10.7ZM8.3 9.3H11.7C11.6 7.5 10.9 5.8 10 4.5C9.1 5.8 8.4 7.5 8.3 9.3ZM11.7 10.7H8.3C8.4 12.5 9.1 14.2 10 15.5C10.9 14.2 11.6 12.5 11.7 10.7ZM13.2 9.3H16.1A6.3 6.3 0 0 0 11.8 4.2C12.6 5.5 13.1 7.3 13.2 9.3ZM11.8 15.8A6.3 6.3 0 0 0 16.1 10.7H13.2C13.1 12.7 12.6 14.5 11.8 15.8Z</Geometry>
        <Geometry x:Key="GeomInsurance">M10 1.8L16.5 4.4V9.4C16.5 13.7 13.7 17.3 10 18.5C6.3 17.3 3.5 13.7 3.5 9.4V4.4L10 1.8ZM9.2 6.2V8.9H6.5V10.5H9.2V13.2H10.8V10.5H13.5V8.9H10.8V6.2H9.2Z</Geometry>
        <Geometry x:Key="GeomPermit">M7 2.5C7 1.67 7.67 1 8.5 1H11.5C12.33 1 13 1.67 13 2.5V4H16.5C17.33 4 18 4.67 18 5.5V16.5C18 17.33 17.33 18 16.5 18H3.5C2.67 18 2 17.33 2 16.5V5.5C2 4.67 2.67 4 3.5 4H7V2.5ZM8.5 2.5V4H11.5V2.5H8.5ZM3.7 8.5V16.3H16.3V8.5H12V10.2H8V8.5H3.7Z</Geometry>
        <Geometry x:Key="GeomUpload">M10 2.5L14.2 6.7L13.1 7.8L10.8 5.5V13.2H9.2V5.5L6.9 7.8L5.8 6.7L10 2.5ZM4 15.2H16V16.8H4V15.2Z</Geometry>
        <Geometry x:Key="GeomReplace">M10 3.2A6.8 6.8 0 0 1 16.4 7.7H14.6A5.2 5.2 0 0 0 5.3 7.8L7.4 7.8V9.3H3.2V5.1H4.7V6.6A6.8 6.8 0 0 1 10 3.2ZM16.8 10.7V14.9H15.3V13.4A6.8 6.8 0 0 1 3.6 12.3H5.4A5.2 5.2 0 0 0 14.7 12.2H12.6V10.7H16.8Z</Geometry>
        <Geometry x:Key="GeomCheck">M7.8 13.9L3.6 9.7L4.9 8.4L7.8 11.3L15.1 4L16.4 5.3L7.8 13.9Z</Geometry>

        <Style x:Key="DocRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Opacity" Value="0.68"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DocIconTile" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DocIconPath" TargetType="Path">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="">
                    <Setter Property="Fill" Value="{DynamicResource AccentDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Null}">
                    <Setter Property="Fill" Value="{DynamicResource AccentDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DocName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DocFile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DocLoadedPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DocCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DocUploadBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeomReplace}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource DetBtnReplace}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <Trigger Property="Tag" Value="">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomUpload}" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnUpload}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomUpload}" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnUpload}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DocKindBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=0}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <ScrollViewer x:Name="DocScroll" Style="{StaticResource ThinScroll}" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PageHeaderIconBadge}" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource PageHeaderIconText}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource StepDocuments}" FontSize="{DynamicResource FS16}" Style="{StaticResource PageHeaderTitleText}"/>
                            <TextBlock Text="{DynamicResource ReplDocUploadHint}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="3"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetEuDocTypeCommand}" CommandParameter="passport">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DocKindBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEuPassport}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomPassport}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource DocKindPassport}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetEuDocTypeCommand}" CommandParameter="id_card" Margin="2,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DocKindBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEuIdCard}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomIdCard}" Width="14" Height="14" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource EuDocTypeIdCard}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 1. Passport / ID card side 1 (always required) -->
                <Border Style="{StaticResource DocRow}" Tag="True"
                        Drop="PassportDrop" DragEnter="OnDocDragEnter" DragLeave="OnDocDragLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomCheck}" Width="10" Height="10" Stretch="Uniform" Fill="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DocIconTile}" Tag="{Binding PassportPreviewPath}">
                            <Path>
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource DocIconPath}">
                                        <Setter Property="Data" Value="{StaticResource GeomPassport}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEuIdCard}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource GeomIdCard}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PrimaryDocument1Label}" Style="{StaticResource DocName}"/>
                                <Border CornerRadius="6" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="{DynamicResource DocRequired}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentDarkBrush}"/>
                                </Border>
                                <Border Style="{StaticResource DocLoadedPill}" Tag="{Binding PassportPreviewPath}">
                                    <TextBlock Text="{DynamicResource DocUploaded}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PassportPreviewPath}" Style="{StaticResource DocFile}"/>
                        </StackPanel>
                        <Button Grid.Column="3" Command="{Binding UploadPassportCommand}" Tag="{Binding PassportPreviewPath}"
                                Style="{StaticResource DocUploadBtn}"/>
                    </Grid>
                </Border>

                <!-- 2. Passport / ID card side 2 -->
                <Border Style="{StaticResource DocRow}" Tag="{Binding HasPassportPage2}"
                        MouseLeftButtonUp="PassportPage2Row_MouseLeftButtonUp"
                        Drop="PassportPage2Drop" DragEnter="OnDocDragEnter" DragLeave="OnDocDragLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasPassportPage2}" Style="{StaticResource DocCheck}"/>
                        <Border Grid.Column="1" Style="{StaticResource DocIconTile}" Tag="{Binding PassportPage2PreviewPath}">
                            <Path>
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource DocIconPath}">
                                        <Setter Property="Data" Value="{StaticResource GeomPassport2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEuIdCard}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource GeomIdCard}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PrimaryDocument2Label}" Style="{StaticResource DocName}"/>
                                <Border Style="{StaticResource DocLoadedPill}" Tag="{Binding PassportPage2PreviewPath}">
                                    <TextBlock Text="{DynamicResource DocUploaded}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PassportPage2PreviewPath}" Style="{StaticResource DocFile}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{DynamicResource DocOptional}" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding HasPassportPage2, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Grid.Column="3" Command="{Binding UploadPassportPage2Command}" IsEnabled="{Binding HasPassportPage2}"
                                Tag="{Binding PassportPage2PreviewPath}" Style="{StaticResource DocUploadBtn}"/>
                    </Grid>
                </Border>

                <!-- 3. Visa (hidden for ID card) -->
                <Border Tag="{Binding HasVisa}"
                        MouseLeftButtonUp="VisaRow_MouseLeftButtonUp"
                        Drop="VisaDrop" DragEnter="OnDocDragEnter" DragLeave="OnDocDragLeave">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource DocRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEuIdCard}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasVisa}" Style="{StaticResource DocCheck}"/>
                        <Border Grid.Column="1" Style="{StaticResource DocIconTile}" Tag="{Binding VisaPreviewPath}">
                            <Path Data="{StaticResource GeomVisa}" Style="{StaticResource DocIconPath}"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource ChkVisa}" Style="{StaticResource DocName}"/>
                                <Border Style="{StaticResource DocLoadedPill}" Tag="{Binding VisaPreviewPath}">
                                    <TextBlock Text="{DynamicResource DocUploaded}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding VisaPreviewPath}" Style="{StaticResource DocFile}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{DynamicResource DocOptional}" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding HasVisa, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Grid.Column="3" Command="{Binding UploadVisaCommand}" IsEnabled="{Binding HasVisa}"
                                Tag="{Binding VisaPreviewPath}" Style="{StaticResource DocUploadBtn}"/>
                    </Grid>
                </Border>

                <!-- 3b. Visa page 2 (only when visa is an ID card) -->
                <Border Style="{StaticResource DocRow}" Tag="{Binding HasVisaPage2}"
                        Visibility="{Binding CanToggleVisaPage2, Converter={StaticResource BoolToVis}}"
                        MouseLeftButtonUp="VisaPage2Row_MouseLeftButtonUp"
                        Drop="VisaPage2Drop" DragEnter="OnDocDragEnter" DragLeave="OnDocDragLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasVisaPage2}" Style="{StaticResource DocCheck}"/>
                        <Border Grid.Column="1" Style="{StaticResource DocIconTile}" Tag="{Binding VisaPage2PreviewPath}">
                            <Path Data="{StaticResource GeomIdCard}" Style="{StaticResource DocIconPath}"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource ChkVisaPage2}" Style="{StaticResource DocName}"/>
                                <Border Style="{StaticResource DocLoadedPill}" Tag="{Binding VisaPage2PreviewPath}">
                                    <TextBlock Text="{DynamicResource DocUploaded}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding VisaPage2PreviewPath}" Style="{StaticResource DocFile}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{DynamicResource DocOptional}" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding HasVisaPage2, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Grid.Column="3" Command="{Binding UploadVisaPage2Command}" IsEnabled="{Binding HasVisaPage2}"
                                Tag="{Binding VisaPage2PreviewPath}" Style="{StaticResource DocUploadBtn}"/>
                    </Grid>
                </Border>

                <!-- 4. Insurance -->
                <Border Style="{StaticResource DocRow}" Tag="{Binding HasInsurance}"
                        MouseLeftButtonUp="InsuranceRow_MouseLeftButtonUp"
                        Drop="InsuranceDrop" DragEnter="OnDocDragEnter" DragLeave="OnDocDragLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasInsurance}" Style="{StaticResource DocCheck}"/>
                        <Border Grid.Column="1" Style="{StaticResource DocIconTile}" Tag="{Binding InsurancePreviewPath}">
                            <Path Data="{StaticResource GeomInsurance}" Style="{StaticResource DocIconPath}"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource ChkInsurance}" Style="{StaticResource DocName}"/>
                                <Border Style="{StaticResource DocLoadedPill}" Tag="{Binding InsurancePreviewPath}">
                                    <TextBlock Text="{DynamicResource DocUploaded}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding InsurancePreviewPath}" Style="{StaticResource DocFile}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{DynamicResource DocOptional}" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding HasInsurance, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Grid.Column="3" Command="{Binding UploadInsuranceCommand}" IsEnabled="{Binding HasInsurance}"
                                Tag="{Binding InsurancePreviewPath}" Style="{StaticResource DocUploadBtn}"/>
                    </Grid>
                </Border>

                <!-- 5. Work permit -->
                <Border Style="{StaticResource DocRow}" Tag="{Binding HasWorkPermit}"
                        MouseLeftButtonUp="WorkPermitRow_MouseLeftButtonUp"
                        Drop="WorkPermitDrop" DragEnter="OnDocDragEnter" DragLeave="OnDocDragLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasWorkPermit}" Style="{StaticResource DocCheck}"/>
                        <Border Grid.Column="1" Style="{StaticResource DocIconTile}" Tag="{Binding WorkPermitPreviewPath}">
                            <Path Data="{StaticResource GeomPermit}" Style="{StaticResource DocIconPath}"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource ChkWorkPermit}" Style="{StaticResource DocName}"/>
                                <Border Style="{StaticResource DocLoadedPill}" Tag="{Binding WorkPermitPreviewPath}">
                                    <TextBlock Text="{DynamicResource DocUploaded}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DocFile}">
                                        <Setter Property="Text" Value="{Binding WorkPermitPreviewPath}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkPermitDoc.IsPdf}" Value="True">
                                                <Setter Property="Text" Value="{Binding WorkPermitFileName}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{DynamicResource DocOptional}" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding HasWorkPermit, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Grid.Column="3" Command="{Binding UploadWorkPermitCommand}" IsEnabled="{Binding HasWorkPermit}"
                                Tag="{Binding WorkPermitPreviewPath}" Style="{StaticResource DocUploadBtn}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
