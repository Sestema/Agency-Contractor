<UserControl x:Class="Win11DesktopApp.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:local="clr-namespace:Win11DesktopApp.Converters"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:PathLeafConverter x:Key="PathLeaf"/>
        <conv:InverseStringNullOrEmptyToVisibilityConverter x:Key="InverseStrToVis"/>
        <local:ZoomDoubleConverter x:Key="ZoomDouble"/>
        <local:ZoomFontSizeConverter x:Key="ZoomFontSize"/>
        <local:ZoomThicknessConverter x:Key="ZoomThickness"/>
        <local:ZoomRectConverter x:Key="ZoomRect"/>
        <local:StatusColorConverter x:Key="StatusColor"/>
        <local:StatusBackgroundConverter x:Key="StatusBg"/>
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StrToVis"/>
        <local:ZoomCornerRadiusConverter x:Key="ZoomCornerRadius"/>
        <local:DocumentSeverityBrushConverter x:Key="DocSeverityBrush"/>

        <Style x:Key="EmployeeTileStatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource EmployeeTileTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmployeeTileClearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmployeeCardMoreBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmployeeCardPopupBtn" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ArchiveZoomSlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource CardBorderBrush}" Opacity="0.6"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveToggleButtonBase" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionBtn" TargetType="Button" BasedOn="{StaticResource ArchiveToggleButtonBase}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ArchiveStatCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveMetaIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ArchiveMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ArchiveInfoChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ArchiveTileIconButton" TargetType="Button" BasedOn="{StaticResource ArchiveToggleButtonBase}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <DataTemplate x:Key="ArchiveTileItemTemplate">
                                        <Grid Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='6,14,8,8'}"
                                              Width="{Binding DataContext.TileCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                                              UseLayoutRounding="True"
                                              SnapsToDevicePixels="True"
                                              TextOptions.TextFormattingMode="Ideal"
                                              TextOptions.TextRenderingMode="ClearType"
                                              TextOptions.TextHintingMode="Fixed"
                                              
                                              MouseLeftButtonUp="ArchiveTileCard_MouseLeftButtonUp">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <Border x:Name="TileCard" CornerRadius="16" BorderThickness="1"
                                                    BorderBrush="{DynamicResource EmployeeTileCardBorderBrush}"
                                                    Background="{DynamicResource EmployeeTileCardBackgroundBrush}"
                                                    ClipToBounds="True" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Ellipse Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=190}"
                                                             Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=120}"
                                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,-48,-62,0'}"
                                                             IsHitTestVisible="False" Opacity="0.42"
                                                             Fill="{DynamicResource EmployeeTileDecorBlueBrush}"/>
                                                    <Ellipse Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=170}"
                                                             Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=110}"
                                                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                             Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='-70,0,0,-46'}"
                                                             IsHitTestVisible="False" Opacity="0.32"
                                                             Fill="{DynamicResource EmployeeTileDecorGreenBrush}"/>
                                                    <StackPanel Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter=16}"
                                                                TextOptions.TextFormattingMode="Ideal"
                                                                TextOptions.TextRenderingMode="ClearType"
                                                                TextOptions.TextHintingMode="Fixed">
                                                <!-- Header -->
                                                <Grid Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,0,0,8'}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
<Grid Grid.Column="0"
                                                          Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=72}"
                                                          Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=94}"
                                                          Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,0,12,0'}">
                                                        <Border Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=74}"
                                                                Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=96}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Background="{DynamicResource EmployeeTileAvatarBackgroundBrush}"
                                                                BorderBrush="{DynamicResource EmployeeTileAvatarBorderBrush}"
                                                                BorderThickness="2"
                                                                Padding="0"
                                                                SnapsToDevicePixels="True"
                                                                CornerRadius="18">
                                                            <Border.Clip>
                                                                <RectangleGeometry Rect="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomRect}, ConverterParameter='0,0,74,96'}"
                                                                                   RadiusX="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=18}"
                                                                                   RadiusY="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=18}"/>
                                                            </Border.Clip>
                                                            <Grid>
                                                                <Image Source="{Binding PhotoPath, Converter={StaticResource ThumbnailPathConverter}, ConverterParameter=200}"
                                                                       Stretch="UniformToFill"
                                                                       VerticalAlignment="Center"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       SnapsToDevicePixels="True"
                                                                       Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="17"
                                                                           Style="{StaticResource EmployeeTileClearText}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}"/>
                                                                    </Grid>
                                                        </Border>
                                                        <Ellipse Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=15}"
                                                                 Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=15}"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                 Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,0,1,1'}"
                                                                 Fill="{DynamicResource SecondaryForegroundBrush}"
                                                                 Stroke="{DynamicResource EmployeeTileStatusOutlineBrush}" StrokeThickness="3"/>
                                                    </Grid>
                                                    <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" MinWidth="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="0"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" MinWidth="0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding FirstName}" FontWeight="SemiBold"
                                                                           FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=16}"
                                                                           Style="{StaticResource EmployeeTileClearText}"
                                                                           Foreground="{DynamicResource EmployeeTileTextPrimaryBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FullName}"/>
                                                                <TextBlock Text="{Binding LastName}" FontWeight="SemiBold"
                                                                           FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=16}"
                                                                           Style="{StaticResource EmployeeTileClearText}"
                                                                           Foreground="{DynamicResource EmployeeTileTextPrimaryBrush}"
                                                                           Margin="0,1,0,0"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding LastName, Converter={StaticResource StrToVis}}"
                                                                           ToolTip="{Binding FullName}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                                                <Border CornerRadius="999" Padding="8,3"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                                        Background="{DynamicResource InfoChipBackgroundBrush}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=9}"
                                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{DynamicResource ArchiveTitle}"
                                                                                   Style="{StaticResource EmployeeTileClearText}"
                                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=9}" FontWeight="Medium"
                                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Grid Margin="4,0,0,0" Tag="EmployeeCardMoreMenu">
                                                                    <Button x:Name="MoreBtn" Style="{StaticResource EmployeeCardMoreBtn}"
                                                                            Click="ArchiveCardMoreButton_Click">
                                                                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=10}"
                                                                                   Foreground="{DynamicResource EmployeeTileTextMutedBrush}"/>
                                                                    </Button>
                                                                    <Popup x:Name="ActionPopup"
                                                                           PlacementTarget="{Binding ElementName=MoreBtn}"
                                                                           Placement="Bottom"
                                                                           HorizontalOffset="-186"
                                                                           StaysOpen="True"
                                                                           AllowsTransparency="True"
                                                                           PopupAnimation="Fade">
                                                                        <Border CornerRadius="10" Padding="6"
                                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                                BorderThickness="1">
                                                                            <StackPanel>
                                                                                <Button Style="{StaticResource EmployeeCardPopupBtn}"
                                                                                        Click="ArchiveCardViewProfile_Click">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                                                                   FontSize="{DynamicResource FS12}" Margin="0,0,8,0"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{DynamicResource ArchiveViewProfile}"
                                                                                                   FontSize="{DynamicResource FS11}" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Button Style="{StaticResource EmployeeCardPopupBtn}"
                                                                                        Click="ArchiveCardOpenFolder_Click">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                                                                   FontSize="{DynamicResource FS12}" Margin="0,0,8,0"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{DynamicResource EmpTooltipFolder}"
                                                                                                   FontSize="{DynamicResource FS11}" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Button>
</StackPanel>
                                                                        </Border>
                                                                    </Popup>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                                 Text="{Binding PositionTitle}"
                                                                   Style="{StaticResource EmployeeTileClearText}"
                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=12}"
                                                                   Foreground="{DynamicResource EmployeeTileTextSecondaryBrush}"
                                                                   Margin="0,0,0,2"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                                 ToolTip="{Binding PositionTitle}"
                                                                                 Visibility="{Binding PositionTitle, Converter={StaticResource StrToVis}}"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding FirmName}"
                                                                   Style="{StaticResource EmployeeTileClearText}"
                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=11}"
                                                                   Foreground="{DynamicResource EmployeeTileTextMutedBrush}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FirmName}"
                                                                   Visibility="{Binding FirmName, Converter={StaticResource StrToVis}}"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- Info panel: compact row (start date | phone | end date) -->
                                                <Border Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='0,0,0,8'}"
                                                        CornerRadius="14"
                                                        Padding="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter=6}"
                                                        Background="{DynamicResource EmployeeTileInfoPanelBrush}" BorderBrush="{DynamicResource EmployeeTileInfoPanelBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <!-- 3 columns when phone present -->
                                                        <Grid Visibility="{Binding HasContacts, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" HorizontalAlignment="Stretch"
                                                                        Visibility="{Binding StartDate, Converter={StaticResource StrToVis}}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,1">
                                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=11}"
                                                                               Foreground="{DynamicResource EmployeeTileTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="{Binding StartDate, Mode=OneWay}"
                                                                               Style="{StaticResource EmployeeTileClearText}"
                                                                               FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=12}"
                                                                               FontWeight="Medium" Foreground="{DynamicResource EmployeeTileTextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxWidth="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=80}"
                                                                               ToolTip="{Binding StartDate, Mode=OneWay}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{DynamicResource ExportColStartDate}" Style="{StaticResource EmployeeTileStatLabel}"
                                                                           FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=10}"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Width="1"
                                                                    Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=28}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="3,0" Background="{DynamicResource EmployeeTileInfoPanelBorderBrush}" Opacity="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding StartDate, Converter={StaticResource StrToVis}}" Value="Visible"/>
                                                                                    <Condition Binding="{Binding HasContacts}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
