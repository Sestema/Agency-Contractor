<UserControl x:Class="Win11DesktopApp.Views.PassportOnlyDetailsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>

        <Style x:Key="PassportOnlyWidgetCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsPassportOnlyDetailsOpen, Converter={StaticResource BoolToVis}}">
        <Border Background="{DynamicResource OverlayBrush}" Margin="-24,-16">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePassportOnlyDetailsCommand}"/>
            </Border.InputBindings>
        </Border>
        <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                Width="720" MaxWidth="820" MaxHeight="560" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12"
                                Background="{DynamicResource BrandDangerGradientBrush}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PassportOnlyDialogTitle}" FontSize="{DynamicResource FS20}"
                                       FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding PassportOnlySummaryText}" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding PassportOnlyPeriodHint}" FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource TertiaryForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ClosePassportOnlyDetailsCommand}"
                            Style="{StaticResource HeaderGhostButton}" Width="34" Height="34" VerticalAlignment="Top">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PassportOnlyWidgetCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PassportOnlyActiveColumnTitle}" FontSize="{DynamicResource FS15}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" MinWidth="48" CornerRadius="8" Padding="8,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource WarningChipBackgroundBrush}">
                                    <TextBlock Text="{Binding PassportOnlyActiveCount}" FontSize="{DynamicResource FS11}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource WarningChipForegroundBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center" MinWidth="32"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding PassportOnlyActiveEmptyText}"
                                       FontSize="{DynamicResource FS12}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding PassportOnlyActiveEmployees.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"/>
                            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}"
                                          Visibility="{Binding PassportOnlyActiveEmployees.Count, Converter={StaticResource IntToVis}}">
                                <ItemsControl ItemsSource="{Binding PassportOnlyActiveEmployees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PassportOnlyWidgetCard}" Margin="0,0,0,8" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenPassportOnlyEmployeeDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                                            Background="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource FS13}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource FS11}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PassportOnlyWidgetCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PassportOnlyEndedColumnTitle}" FontSize="{DynamicResource FS15}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" MinWidth="48" CornerRadius="8" Padding="8,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource ErrorLightBrush}">
                                    <TextBlock Text="{Binding PassportOnlyEndedCount}" FontSize="{DynamicResource FS11}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center" MinWidth="32"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding PassportOnlyEndedEmptyText}"
                                       FontSize="{DynamicResource FS12}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding PassportOnlyEndedEmployees.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"/>
                            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}"
                                          Visibility="{Binding PassportOnlyEndedEmployees.Count, Converter={StaticResource IntToVis}}">
                                <ItemsControl ItemsSource="{Binding PassportOnlyEndedEmployees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PassportOnlyWidgetCard}" Margin="0,0,0,8" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenPassportOnlyEmployeeDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                                            Background="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource FS13}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource FS11}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2" Text="{DynamicResource DashMovementOpenEmployeeHint}"
                           FontSize="{DynamicResource FS11}" Foreground="{DynamicResource TertiaryForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
