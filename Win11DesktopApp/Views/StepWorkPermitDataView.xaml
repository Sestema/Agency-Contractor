<UserControl x:Class="Win11DesktopApp.Views.StepWorkPermitDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Win11DesktopApp.Views">
    <UserControl.Resources>
        <Geometry x:Key="GeomWorkPermitStep">M7 2.5C7 1.67 7.67 1 8.5 1H11.5C12.33 1 13 1.67 13 2.5V4H16.5C17.33 4 18 4.67 18 5.5V16.5C18 17.33 17.33 18 16.5 18H3.5C2.67 18 2 17.33 2 16.5V5.5C2 4.67 2.67 4 3.5 4H7V2.5ZM8.5 2.5V4H11.5V2.5H8.5ZM3.7 8.5V16.3H16.3V8.5H12V10.2H8V8.5H3.7Z</Geometry>
        <Geometry x:Key="GeomSparklePermit">M10 2L11.7 6.8L16.5 8.5L11.7 10.2L10 15L8.3 10.2L3.5 8.5L8.3 6.8L10 2ZM15.5 12.2L16.3 14.5L18.6 15.3L16.3 16.1L15.5 18.4L14.7 16.1L12.4 15.3L14.7 14.5L15.5 12.2Z</Geometry>

        <Style x:Key="PermitFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="1,0,0,4"/>
        </Style>

        <Style x:Key="PermitFieldInput" TargetType="TextBox" BasedOn="{StaticResource WizInput}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=7}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource ThinScroll}" Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Hidden"
                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <!-- Header + AI Scan -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PageHeaderIconBadge}" Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}">
                                <Path Data="{StaticResource GeomWorkPermitStep}" Width="16" Height="16" Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource StepWorkPermitData}"
                                       FontSize="{DynamicResource FS16}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding AIScanDocumentCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Height="34" Padding="14,0"
                                Visibility="{Binding IsAIScanning, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomSparklePermit}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource AIScanBtn}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin AI status banner -->
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                            Background="{DynamicResource AccentLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding AIScanStatus, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding AIScanStatus}"
                                   FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Single-column fields -->
                    <TextBlock Text="{DynamicResource WizWorkPermitNumber}" Style="{StaticResource PermitFieldLabel}"/>
                    <TextBox Text="{Binding Data.WorkPermitNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PermitFieldInput}"/>

                    <TextBlock Text="{DynamicResource WizWorkPermitType}" Style="{StaticResource PermitFieldLabel}"/>
                    <TextBox Text="{Binding Data.WorkPermitType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PermitFieldInput}"/>

                    <TextBlock Text="{DynamicResource WizWorkPermitIssueDate}" Style="{StaticResource PermitFieldLabel}"/>
                    <TextBox Text="{Binding Data.WorkPermitIssueDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PermitFieldInput}"/>

                    <TextBlock Text="{DynamicResource WizWorkPermitExpiry}" Style="{StaticResource PermitFieldLabel}"/>
                    <TextBox Text="{Binding Data.WorkPermitExpiry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PermitFieldInput}"/>

                    <TextBlock Text="{DynamicResource WizWorkPermitAuthority}" Style="{StaticResource PermitFieldLabel}"/>
                    <TextBox Text="{Binding Data.WorkPermitAuthority, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PermitFieldInput}" Margin="0"/>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" Margin="0"/>

            <views:DocumentPreviewPanel Grid.Column="2" Margin="10,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
