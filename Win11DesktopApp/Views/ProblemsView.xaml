<UserControl x:Class="Win11DesktopApp.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:DocTypeToGeometryConverter x:Key="DocTypeGeometry"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StrToVis"/>

        <!-- Severity colours live in styles rather than a converter so they survive a theme
             switch: a converter resolves the brush once when the binding is set up and is never
             asked again, because the severity itself has not changed. DynamicResource re-resolves.
             Expired and Critical share one colour, so red is the default and only the remaining
             two states need a trigger. Ok cannot reach this list, but it is covered to keep the
             behaviour identical to the converter that used to fall back to accent.

             There are two families because the employee card binds WorstSeverity while each
             document row binds Severity, and a trigger's binding is fixed inside the style. -->

        <Style x:Key="WorstSeverityStrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorstSeverityBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorstSeverityGlyph" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WorstSeverity}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityRowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared by the document type tile and the days-remaining badge. -->
        <Style x:Key="SeverityTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityGlyphPath" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}" Margin="24,14,24,24" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource HeaderBackButton}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                </Button>
                <Border Style="{StaticResource PageHeaderIconBadge}" Background="{DynamicResource ErrorBrush}">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource PageHeaderIconText}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FS22}" Style="{StaticResource PageHeaderTitleText}"/>
                    <TextBlock FontSize="{DynamicResource FS11}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0">
                        <Run Text="{Binding TotalDisplay, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding ExpiredDisplay, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding WarningDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding ExportToPdfCommand}" Padding="10,6" Style="{StaticResource FilledActionButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource ProbExportPdf}" FontSize="{DynamicResource FS12}" FontWeight="Medium"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- STATS + FILTERS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
            <!-- Expired / Critical -->
            <Button Command="{Binding FilterExpiredCommand}" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- All four chips share one rule: the border is always 2 thick and only
                             changes colour. Thickness adds to the chip's size, so switching 1 to 2
                             on selection made the whole chip grow and its numbers shift. Inactive,
                             the border matches its own fill and is invisible. -->
                        <Border x:Name="Bd" Background="{DynamicResource ErrorChipBackgroundBrush}" CornerRadius="8" Padding="12,7" MinWidth="112"
                                BorderBrush="{DynamicResource ErrorChipBackgroundBrush}" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="{Binding ExpiredDisplay, Mode=OneWay}" FontSize="{DynamicResource FS24}" FontWeight="Bold" Foreground="{DynamicResource ErrorChipForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource ProbStatExpired}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource ErrorChipForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ErrorChipBorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/>
                            </Trigger>
                            <!-- Declared after the hover trigger so an active chip keeps its strong
                                 ring while still darkening under the mouse. -->
                            <DataTrigger Binding="{Binding IsFilterExpired}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Warning / Expiring soon -->
            <Button Command="{Binding FilterWarningCommand}" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource WarningChipBackgroundBrush}" CornerRadius="8" Padding="12,7" MinWidth="112"
                                BorderBrush="{DynamicResource WarningChipBackgroundBrush}" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="{Binding WarningDisplay, Mode=OneWay}" FontSize="{DynamicResource FS24}" FontWeight="Bold" Foreground="{DynamicResource WarningChipForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource ProbStatWarning}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource WarningChipForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningChipBorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFilterWarning}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Total -->
            <Button Command="{Binding FilterAllCommand}" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- The neutral chip has no chip brush family, so it keeps the card colours
                             and a visible grey ring when inactive. Hover fills instead of dimming:
                             the old Opacity 0.85 faded the chip's own numbers. -->
                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12,7" MinWidth="112"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalDisplay, Mode=OneWay}" FontSize="{DynamicResource FS24}" FontWeight="Bold" 
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource ProbStatTotal}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Ignored -->
            <Button Command="{Binding ToggleIgnoredListCommand}" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource InfoChipBackgroundBrush}" CornerRadius="8" Padding="12,7" MinWidth="112"
                                BorderBrush="{DynamicResource InfoChipBackgroundBrush}" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="{Binding IgnoredCount}" FontSize="{DynamicResource FS24}" FontWeight="Bold" Foreground="{DynamicResource InfoChipForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource ProbIgnored}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource InfoChipForegroundBrush}"/>
                                    <TextBlock x:Name="Chev" Text=" &#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}"
                                               Foreground="{DynamicResource InfoChipForegroundBrush}" VerticalAlignment="Center" Margin="4,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InfoChipBorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InfoChipBorderBrush}"/>
                            </Trigger>
                            <!-- This chip opens the ignored panel, so it needs to show that the panel
                                 is open: ring plus the chevron pointing the other way. -->
                            <DataTrigger Binding="{Binding IsIgnoredListVisible}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chev" Property="Text" Value=" &#xE70E;"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            </StackPanel>

            <!-- Filters: search + firm -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search box -->
                <Border CornerRadius="9" Height="36" MinWidth="240" MaxWidth="320"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,8,0"
                        UseLayoutRounding="True"
                        TextOptions.TextFormattingMode="Display"
                        TextOptions.TextRenderingMode="ClearType">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource FS13}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 FontSize="{DynamicResource FS13}" Padding="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Tag" Value="{DynamicResource ProbSearchPlaceholder}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="placeholder"
                                                               Text="{TemplateBinding Tag}"
                                                               Foreground="{DynamicResource TertiaryForegroundBrush}"
                                                               VerticalAlignment="Center" Margin="4,0"
                                                               FontSize="{DynamicResource FS13}"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Command="{Binding ClearFiltersCommand}" Cursor="Hand"
                                VerticalAlignment="Center" Margin="4,0,0,0"
                                Visibility="{Binding SearchQuery, Converter={StaticResource StrToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource FS11}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Firm filter -->
                <ComboBox Height="36" MinWidth="170" MaxWidth="230"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding FirmOptions}"
                          SelectedItem="{Binding SelectedFirm, Mode=TwoWay}"
                          ToolTip="{DynamicResource ProbAllFirms}"/>
            </StackPanel>
        </Grid>

        <!-- IGNORED LIST (collapsible) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding IsIgnoredListVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS16}"
                               Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource ProbIgnoredTitle}" FontSize="{DynamicResource FS15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding IgnoredProblems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,5"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}">
                                            <Run Text="{Binding EmployeeName, Mode=OneWay}"/>
                                            <Run Text=" — " Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Run Text="{Binding DocumentTypeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding ExpiryDateStr}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,12,0"/>
                                            <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource ProbUntil}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource AccentDarkBrush}"/>
                                                    <TextBlock Text="{Binding IgnoredUntil}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource AccentDarkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1" VerticalAlignment="Center" Cursor="Hand"
                                            Command="{Binding DataContext.RestoreProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource ProbRestoreTooltip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="10,6"
                                                        BorderBrush="{DynamicResource AccentDarkBrush}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                                                   Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource ProbRestore}" FontSize="{DynamicResource FS11}" FontWeight="Medium"
                                                                   Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- PROBLEMS LIST (grouped by employee) -->
        <Grid Grid.Row="3">
            <ItemsControl ItemsSource="{Binding ProblemGroups}" Margin="10,2,10,4"
                          Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource ThinScroll}" Padding="10" CanContentScroll="True" Focusable="False" ClipToBounds="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!-- No entry animation and no RenderTransform on these cards on purpose.
                             The panel recycles containers, so a Loaded-driven fade replays every
                             time a card scrolls back into view, and fading a card full of text
                             pushes it through an opacity layer that softens the glyphs. -->
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                                    Padding="0" Margin="10,4,10,7"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Cursor="Hand"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="ClearType"
                                    MouseLeftButtonDown="EmployeeCard_MouseLeftButtonDown"
                                    Effect="{x:Null}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity color strip (worst severity). Inset top and bottom so the bar
                                         never reaches the card's corner arcs, which curve inward for the first
                                         11 device pixels and would otherwise clip its ends. The radius has to
                                         stay at or below half the 5 width, or WPF trims it back to fit. -->
                                    <Border Grid.Column="0" Margin="0,10" CornerRadius="2.5"
                                            Style="{StaticResource WorstSeverityStrip}"/>

                                    <Grid Grid.Column="1" Margin="12,10,12,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Employee header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Style="{StaticResource WorstSeverityBadge}">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Style="{StaticResource WorstSeverityGlyph}"/>
                                            </Border>

                                            <!-- Name + firm -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EmployeeName}" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="{DynamicResource ProbIssueCount}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <TextBlock Text="{Binding IssueCount}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Open employee button -->
                                            <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand"
                                                    Command="{Binding DataContext.OpenEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource ProbOpenTooltip}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{DynamicResource ProbOpen}" FontSize="{DynamicResource FS11}"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Issues list -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,4" Padding="10,6,8,6" CornerRadius="7"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            Style="{StaticResource SeverityRowBorder}"
                                                            BorderThickness="4,0,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Document type icon tile -->
                                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                                                                    Margin="0,0,9,0" VerticalAlignment="Center"
                                                                    Style="{StaticResource SeverityTile}">
                                                                <Path Data="{Binding DocumentType, Converter={StaticResource DocTypeGeometry}}"
                                                                      Stretch="Uniform" Width="15" Height="15"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Style="{StaticResource SeverityGlyphPath}"
                                                                      StrokeThickness="1.5" Fill="Transparent"
                                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Border>

                                                            <!-- Doc type + date + badge -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock FontSize="{DynamicResource FS12}" FontWeight="Medium"
                                                                           Foreground="{DynamicResource ForegroundBrush}">
                                                                    <Run Text="{Binding DocumentTypeDisplay, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ExpiryDateStr}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,8,0"/>
                                                                    <Border CornerRadius="6" Padding="6,1"
                                                                            Style="{StaticResource SeverityTile}">
                                                                        <TextBlock FontSize="{DynamicResource FS9}" FontWeight="SemiBold"
                                                                                   Text="{Binding DaysRemaining, Converter={x:Static conv:DaysRemainingTextConverter.Instance}}"
                                                                                   Style="{StaticResource SeverityText}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Close validity — custom signed documents only -->
                                                            <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.CloseCustomDocumentValidityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsCustomDocument, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{DynamicResource ProbCloseValidityTooltip}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,3">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource SuccessChipForegroundBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{DynamicResource ProbCloseValidity}" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource SuccessChipForegroundBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Ignore button -->
                                                            <Button Grid.Column="3" VerticalAlignment="Center" Cursor="Hand"
                                                                    Command="{Binding DataContext.IgnoreProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{DynamicResource ProbIgnoreTooltip}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,3">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{DynamicResource ProbIgnore}" FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <!-- Empty state: no problems at all -->
            <Border Style="{StaticResource CompactEmptyStateCard}"
                    Padding="28,24"
                    Visibility="{Binding IsAllClear, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource CompactEmptyStateIconText}"
                               FontSize="{DynamicResource FS28}" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource ProbAllOk}" Style="{StaticResource CompactEmptyStateTitleText}"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource ProbAllOkDesc}" Style="{StaticResource CompactEmptyStateDescriptionText}"/>
                </StackPanel>
            </Border>

            <!-- Empty state: problems exist but filter/search hides them all -->
            <Border Style="{StaticResource CompactEmptyStateCard}"
                    Padding="28,24"
                    Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" Style="{StaticResource CompactEmptyStateIconText}"
                               FontSize="{DynamicResource FS28}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource ProbNoMatches}" Style="{StaticResource CompactEmptyStateTitleText}"/>
                    <TextBlock Text="{DynamicResource ProbNoMatchesDesc}" Style="{StaticResource CompactEmptyStateDescriptionText}"/>
                    <Button Command="{Binding ClearFiltersCommand}" Cursor="Hand"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Style="{StaticResource FilledActionButton}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource ProbClearFilters}" FontSize="{DynamicResource FS12}"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Employee Details Overlay -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsEmployeeDetailsOpen, Converter={StaticResource BoolToVis}}">
            <!-- Only the dim fades in. The same animation used to sit on this Grid, which meant
                 the whole employee card - a very large view full of text - was pushed through a
                 half-screen opacity buffer for the whole quarter second. The dim is a flat rect
                 with no children, so fading it costs nothing; the card itself just appears. -->
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmployeeDetailsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EmployeeDetailsVm.CloseCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding EmployeeDetailsVm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:EmployeeDetailsViewModel}">
                        <views:EmployeeDetailsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
