<UserControl x:Class="Win11DesktopApp.Views.LayeredTileIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- Static vector icon on a 24x24 canvas: gradient body, accent strokes, white inner strokes. -->
    <Viewbox>
        <Canvas Width="24" Height="24">
            <Path Data="{Binding IconBody, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Fill="{Binding IconGradient, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Stroke="{Binding IconGradient, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.6" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="{Binding IconAccent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Stroke="{Binding IconAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.6" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="{Binding IconInner, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Stroke="White"
                  StrokeThickness="1.6" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
