<UserControl x:Class="Win11DesktopApp.Views.EmployeesView"
             x:Name="EmployeesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             xmlns:local="clr-namespace:Win11DesktopApp.Converters"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:h="clr-namespace:Win11DesktopApp.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:StatusColorConverter x:Key="StatusColor"/>
        <local:StatusBackgroundConverter x:Key="StatusBg"/>
        <local:GenderRingBrushConverter x:Key="GenderRingBrush"/>
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StrToVis"/>
        <local:InverseStringNullOrEmptyToVisibilityConverter x:Key="InverseStrToVis"/>
        <local:NameToColorConverter x:Key="NameToColor"/>
        <local:FirstCharConverter x:Key="FirstCharConverter"/>
        <local:ZoomDoubleConverter x:Key="ZoomDouble"/>
        <local:ZoomFontSizeConverter x:Key="ZoomFontSize"/>
        <local:ZoomThicknessConverter x:Key="ZoomThickness"/>
        <local:ZoomRectConverter x:Key="ZoomRect"/>
        <local:ZoomCornerRadiusConverter x:Key="ZoomCornerRadius"/>
        <local:DocumentSeverityBrushConverter x:Key="DocSeverityBrush"/>
        <local:ViewModeToPillOffsetConverter x:Key="ViewModePillOffset"/>

        <!-- Right-click menu on Tiles/Icons cards, mirrors the "..." popup (Open Folder / Delete) -->
        <ContextMenu x:Key="EmployeeCardContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{DynamicResource EmpTooltipFolder}" Click="EmployeeCardContextOpenFolder_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource EmpBtnDelete}" Click="EmployeeCardContextDelete_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                               Foreground="{DynamicResource DangerOutlineBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="StatusMessageText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusMessageBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkAwareDeleteBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerOutlineBrush}"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource DangerOutlineBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmployeeMetaIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmployeeMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmployeeDocChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
        </Style>

        <Style x:Key="EmployeeDocChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="EmployeeCardIconBtn" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>

        <Style x:Key="EmployeeCardDeleteIconBtn" TargetType="Button" BasedOn="{StaticResource DarkAwareDeleteBtn}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>

        <Style x:Key="EmployeeCardMoreBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmployeeCardPopupBtn" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinWidth" Value="210"/>
        </Style>

        <Style x:Key="EmployeeCardPopupDeleteBtn" TargetType="Button" BasedOn="{StaticResource DarkAwareDeleteBtn}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinWidth" Value="210"/>
        </Style>

        <Style x:Key="EmployeeDocPillBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="EmployeeDocPillVisaBorder" TargetType="Border" BasedOn="{StaticResource EmployeeDocPillBorder}">
            <Setter Property="Background" Value="{DynamicResource SuccessChipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessChipBorderBrush}"/>
        </Style>

        <Style x:Key="EmployeeTileStatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FS10}"/>
            <Setter Property="Foreground" Value="{DynamicResource EmployeeTileTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmployeeTileClearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmployeeDocPillVisaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FS9}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <Style x:Key="EmpIconCardInfoText" TargetType="TextBlock" BasedOn="{StaticResource EmployeeTileClearText}">
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="EmpToolbarText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
        </Style>
        <Style x:Key="EmpToolbarTextBold" TargetType="TextBlock" BasedOn="{StaticResource EmpToolbarText}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="EmpToolbarIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
        </Style>
        <Style x:Key="EmpStatChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented sort button: hover only applies while the segment is inactive (Tag is empty).
             The active accent fill is a separate layer that fades in/out for a smoother feel. -->
        <Style x:Key="SortSegmentButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value=""/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="BaseBd" Background="{DynamicResource ContentBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border x:Name="HoverBd" Background="{DynamicResource CardHoverBrush}"
                                    CornerRadius="8" Opacity="0"/>
                            <Border x:Name="ActiveBd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverBd" Property="Opacity" Value="1"/>
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="Active">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fading vertical divider used between toolbar sections (softer than a flat line). -->
        <Style x:Key="ToolbarFadeDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="OpacityMask">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular icon badge used inside the stat chips. -->
        <Style x:Key="EmpStatIconBadge" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- View-mode segment: transparent flat button, icon color reacts to the shared sliding pill behind it. -->
        <Style x:Key="ViewModeSegmentButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact pill-track zoom slider. -->
        <Style x:Key="EmpZoomSlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource CardBorderBrush}" Opacity="0.6"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact, consistently-sized actions used only by the employees header. -->
        <Style x:Key="EmpHeaderGhostButton" TargetType="Button" BasedOn="{StaticResource HeaderGhostButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="EmpHeaderPrimaryButton" TargetType="Button" BasedOn="{StaticResource FilledActionButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="11,4"/>
        </Style>

    </UserControl.Resources>

    <Grid ClipToBounds="False">
        <Border Background="{DynamicResource PageBackgroundBrush}"
                CacheMode="BitmapCache"
                RenderOptions.CachingHint="Cache"
                IsHitTestVisible="False"/>
        <Grid ClipToBounds="False"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Ideal"
              TextOptions.TextRenderingMode="ClearType"
              TextOptions.TextHintingMode="Fixed">
            <Grid Margin="20,6,20,16" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="Auto"/>  <!-- Stats + sort + view + zoom -->
                    <RowDefinition Height="Auto"/>  <!-- Selection bar -->
                    <RowDefinition Height="*"/>     <!-- List -->
                </Grid.RowDefinitions>

                <!-- ===== UNIFIED HEADER CARD (branding + company switcher + search + actions / stats + sort + view) ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,8" ClipToBounds="False">
                    <Border CornerRadius="14" Background="{DynamicResource CardBackgroundBrush}"
                            Effect="{DynamicResource CardShadow}"/>
                    <Border CornerRadius="14" BorderThickness="1" Padding="10,7"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Ideal"
                            TextOptions.TextRenderingMode="ClearType"
                            TextOptions.TextHintingMode="Animated">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top row: branding | company pill | search | action buttons -->
                            <Grid Grid.Row="0" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="EmpHeaderSide"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="EmpHeaderSide"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding GoBackCommand}" Style="{StaticResource HeaderBackButton}"
                                Width="30" Height="30" Margin="0,0,8,0">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"/>
                        </Button>
                        <!-- App branding -->
                        <Border Width="30" Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Resources/agency_contractor_header_logo.png"
                                   Width="30" Height="30"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Agency Contractor"
                                       FontSize="{DynamicResource FS11}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource EmpBrandSubtitle}"
                                       FontSize="{DynamicResource FS9}"
                                       Foreground="{DynamicResource TertiaryForegroundBrush}"
                                       Margin="0,0,0,0"/>
                        </StackPanel>
                        <!-- Company switcher pill: click opens the firm dropdown below -->
                        <Border x:Name="CompanyPill"
                                CornerRadius="11"
                                Padding="4,3,9,3"
                                Background="{DynamicResource EmpCompanyPillBackgroundBrush}"
                                BorderBrush="{DynamicResource EmpCompanyPillBorderBrush}"
                                BorderThickness="1"
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="{DynamicResource EmpSwitchCompanyTooltip}"
                                MouseLeftButtonUp="CompanyPill_MouseLeftButtonUp"
                                MouseEnter="CompanyDropdown_MouseEnter"
                                MouseLeave="CompanyDropdown_MouseLeave">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{DynamicResource EmpCompanyPillAvatarBackgroundBrush}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, Converter={StaticResource FirstCharConverter}}"
                                               FontSize="{DynamicResource FS11}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmpCompanyPillAvatarForegroundBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource PageHeaderTitleTextEmployees}"
                                           Foreground="{DynamicResource EmpCompanyPillForegroundBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FS11}"
                                           MaxWidth="230"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FS10}"
                                           Text="&#xE70D;"
                                           Foreground="{DynamicResource EmpCompanyPillCheckBrush}"
                                           Margin="6,1,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Firm switcher dropdown -->
                        <Popup IsOpen="{Binding IsCompanyDropdownOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=CompanyPill}"
                               Placement="Bottom"
                               VerticalOffset="4"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border CornerRadius="10" Padding="5" Margin="8,0,8,8"
                                    MinWidth="280" MaxWidth="360"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Effect="{DynamicResource CardShadow}"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Ideal"
                                    TextOptions.TextRenderingMode="ClearType"
                                    TextOptions.TextHintingMode="Animated"
                                    MouseEnter="CompanyDropdown_MouseEnter"
                                    MouseLeave="CompanyDropdown_MouseLeave">
                                <Grid>
                                    <TextBlock Text="{DynamicResource EmpNoCompaniesInDropdown}"
                                               FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="12,10" TextWrapping="Wrap"
                                               Visibility="{Binding HasCompanyDropdownItems, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0,1"
                                                  Visibility="{Binding HasCompanyDropdownItems, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding CompanyDropdownItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Button Command="{Binding DataContext.SwitchCompanyCommand, ElementName=EmployeesRoot}"
                                                                CommandParameter="{Binding Company}"
                                                                Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,1">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Setter Property="Tag" Value=""/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Tag" Value="Current"/>
                                                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="10,7"
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <MultiTrigger>
                                                                            <MultiTrigger.Conditions>
                                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                                <Condition Property="Tag" Value=""/>
                                                                            </MultiTrigger.Conditions>
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                        </MultiTrigger>
                                                                        <MultiTrigger>
                                                                            <MultiTrigger.Conditions>
                                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                                <Condition Property="Tag" Value="Current"/>
                                                                            </MultiTrigger.Conditions>
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        </MultiTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                                        Background="{Binding Name, Converter={StaticResource NameToColor}}"
                                                                        Margin="0,0,10,0" VerticalAlignment="Center"
                                                                        SnapsToDevicePixels="True">
                                                                    <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                                                               FontFamily="Segoe UI"
                                                                               FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontFamily="Segoe UI"
                                                                           FontSize="{DynamicResource FS12}"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                                                        Background="{DynamicResource AccentBrush}"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="&#xE73E;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="{DynamicResource FS9}"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                        <Border Height="1" Margin="14,2,10,1"
                                                                Background="{DynamicResource CardBorderBrush}"
                                                                Opacity="0.45"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Grid Grid.Column="1"
                            Margin="14,0,0,0"
                          Height="30"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Border Style="{StaticResource ToolbarSearchContainer}"
                                Background="{DynamicResource ContentBackgroundBrush}"
                                CornerRadius="10"
                                Padding="8,0,6,0"
                                UseLayoutRounding="True"
                                TextOptions.TextFormattingMode="Ideal"
                                TextOptions.TextRenderingMode="ClearType"
                                TextOptions.TextHintingMode="Animated">
                        <Grid Margin="6,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FS11}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,7,0"/>
                            <TextBox x:Name="EmployeeSearchBox"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"
                                     FontSize="{DynamicResource FS11}"
                                     Padding="0,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Tag" Value="{DynamicResource FinSearchPlaceholder}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="placeholder"
                                                                   Text="{TemplateBinding Tag}"
                                                                   Foreground="{DynamicResource TertiaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="{DynamicResource FS11}"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Border Grid.Column="2"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    Margin="5,0,1,0"
                                    Background="{DynamicResource ContentBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource InverseStrToVis}}">
                                <TextBlock Text="Ctrl + K"
                                           FontSize="{DynamicResource FS9}"
                                           Foreground="{DynamicResource TertiaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Command="{Binding ExportToExcelCommand}"
                                Style="{StaticResource EmpHeaderGhostButton}"
                                Margin="0,0,6,0"
                                ToolTip="{DynamicResource EmpTooltipExport}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0"/>
                                <TextBlock Text="Excel" FontSize="{DynamicResource FS11}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenBatchAIValidationCommand}"
                                Style="{StaticResource EmpHeaderGhostButton}"
                                Margin="0,0,6,0"
                                ToolTip="{DynamicResource EmpAiCheckTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource EmpAiCheck}" FontSize="{DynamicResource FS11}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleSelectionModeCommand}"
                                Style="{StaticResource EmpHeaderGhostButton}"
                                Margin="0,0,6,0"
                                ToolTip="{DynamicResource EmpTooltipSelect}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource EmpBtnSelect}" FontSize="{DynamicResource FS11}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddEmployeeCommand}" Style="{StaticResource EmpHeaderPrimaryButton}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                           Foreground="White" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource BtnAddEmployee}" FontSize="{DynamicResource FS11}"
                                           FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                            </Grid>

                            <!-- Bottom row: stats | sort | view mode | zoom -->
                            <Border Grid.Row="1" Margin="0,5,0,0" Padding="2,2,2,0"
                                    BorderThickness="0"
                                    Visibility="{Binding HasEmployees, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- View mode capsule: one sliding accent pill behind 4 transparent icon buttons. -->
                                <Border CornerRadius="8" BorderThickness="1" Padding="2"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        Background="{DynamicResource ContentBackgroundBrush}"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <Border x:Name="ViewModePill" Width="30" Height="24" CornerRadius="6"
                                                Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <!-- The transform's base value is a plain data binding (source of truth: always
                                                 correct even if the visual tree is rebuilt). The DataTriggers below only add
                                                 a smooth glide on top of it via FillBehavior=Stop, which hands control back
                                                 to the bound base value the instant the animation finishes, so the pill can
                                                 never get stuck at a stale position after switching to a heavy view like Tiles. -->
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding ViewMode, Converter={StaticResource ViewModePillOffset}, ConverterParameter=30}"/>
                                            </Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ViewMode}" Value="Table">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                         To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                         To="30" Duration="0:0:0.2" FillBehavior="Stop">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ViewMode}" Value="Tiles">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                         To="60" Duration="0:0:0.2" FillBehavior="Stop">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ViewMode}" Value="Icons">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                         To="90" Duration="0:0:0.2" FillBehavior="Stop">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding SetViewModeCommand}" CommandParameter="Table" ToolTip="{DynamicResource ViewTable}"
                                                    Style="{StaticResource ViewModeSegmentButton}" Cursor="Hand">
                                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ViewMode}" Value="Table">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Command="{Binding SetViewModeCommand}" CommandParameter="List" ToolTip="{DynamicResource ViewList}"
                                                    Style="{StaticResource ViewModeSegmentButton}" Cursor="Hand">
                                                <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Command="{Binding SetViewModeCommand}" CommandParameter="Tiles" ToolTip="{DynamicResource ViewTiles}"
                                                    Style="{StaticResource ViewModeSegmentButton}" Cursor="Hand">
                                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ViewMode}" Value="Tiles">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Command="{Binding SetViewModeCommand}" CommandParameter="Icons" ToolTip="{DynamicResource ViewIcons}"
                                                    Style="{StaticResource ViewModeSegmentButton}" Cursor="Hand">
                                                <TextBlock Text="&#xE80B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ViewMode}" Value="Icons">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ToolbarFadeDivider}" Height="20" Margin="0,0,8,0"/>

                                <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider Value="{Binding TileSizeStep}" Minimum="1" Maximum="6" Width="72"
                                        Style="{StaticResource EmpZoomSlider}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ToolTip="{DynamicResource EmpTileSizeTooltip}"/>
                                <Border CornerRadius="6" Padding="5,1" Margin="6,0,0,0"
                                        Background="{DynamicResource ContentBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding TileSizeStep, StringFormat=x{0}}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" MinWidth="14"
                                               TextAlignment="Center"
                                               ToolTip="{DynamicResource EmpTileSizeTooltip}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border Margin="0,0,6,0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByStatCommand}" CommandParameter="all"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmpStatChipBorder}">
                                            <Setter Property="Background" Value="{DynamicResource InfoChipBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource InfoChipBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatFilter}" Value="all">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource EmpStatIconBadge}" Background="{DynamicResource InfoChipForegroundBrush}">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalCount}" FontFamily="Segoe UI"
                                                       FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InfoChipForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                       TextOptions.TextFormattingMode="Ideal"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       TextOptions.TextHintingMode="Animated"/>
                                            <TextBlock Text="{DynamicResource EmpStatTotal}" FontFamily="Segoe UI"
                                                       FontSize="{DynamicResource FS11}" FontWeight="Medium"
                                                       Foreground="{DynamicResource InfoChipForegroundBrush}" Opacity="0.9"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                       TextOptions.TextFormattingMode="Ideal"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       TextOptions.TextHintingMode="Animated"/>
                                        </StackPanel>
                        </StackPanel>
                    </Border>
                                <Border Margin="0,0,6,0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByStatCommand}" CommandParameter="problems"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmpStatChipBorder}">
                                            <Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatFilter}" Value="problems">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningChipForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource EmpStatIconBadge}" Background="{DynamicResource WarningChipForegroundBrush}">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProblemsCount}" FontFamily="Segoe UI"
                                                       FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningChipForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                       TextOptions.TextFormattingMode="Ideal"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       TextOptions.TextHintingMode="Animated"/>
                                            <TextBlock Text="{DynamicResource EmpStatProblems}" FontFamily="Segoe UI"
                                                       FontSize="{DynamicResource FS11}" FontWeight="Medium"
                                                       Foreground="{DynamicResource WarningChipForegroundBrush}" Opacity="0.9"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                       TextOptions.TextFormattingMode="Ideal"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       TextOptions.TextHintingMode="Animated"/>
                                        </StackPanel>
                        </StackPanel>
                    </Border>
                                <Border>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByStatCommand}" CommandParameter="new"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmpStatChipBorder}">
                                            <Setter Property="Background" Value="{DynamicResource SuccessChipBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessChipBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatFilter}" Value="new">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource EmpStatIconBadge}" Background="{DynamicResource SuccessChipForegroundBrush}">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NewThisMonth}" FontFamily="Segoe UI"
                                                       FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessChipForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                       TextOptions.TextFormattingMode="Ideal"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       TextOptions.TextHintingMode="Animated"/>
                                            <TextBlock Text="{DynamicResource EmpStatNewMonth}" FontFamily="Segoe UI"
                                                       FontSize="{DynamicResource FS11}" FontWeight="Medium"
                                                       Foreground="{DynamicResource SuccessChipForegroundBrush}" Opacity="0.9"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                       TextOptions.TextFormattingMode="Ideal"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       TextOptions.TextHintingMode="Animated"/>
                                        </StackPanel>
                        </StackPanel>
                    </Border>
                                <Border Style="{StaticResource ToolbarFadeDivider}" Height="24" Margin="8,0,10,0"/>
                </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource EmpSortLabel}" Style="{StaticResource EmpToolbarText}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,8,0"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SortByCommand}" CommandParameter="Name" Margin="0,0,6,0">
                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortField}" Value="Name">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" Style="{StaticResource EmpToolbarIcon}"/>
                                            <TextBlock Text="{DynamicResource EmpSortName}" Style="{StaticResource EmpToolbarText}"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Name">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                        </StackPanel>
                    </Button>

                                    <Button Command="{Binding SortByCommand}" CommandParameter="StartDate" Margin="0,0,6,0">
                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortField}" Value="StartDate">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" Style="{StaticResource EmpToolbarIcon}"/>
                                            <TextBlock Text="{DynamicResource EmpSortDate}" Style="{StaticResource EmpToolbarText}"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="StartDate">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                        </StackPanel>
                    </Button>

                                    <Button Command="{Binding SortByCommand}" CommandParameter="Status" Margin="0,0,6,0">
                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortField}" Value="Status">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource EmpToolbarIcon}"/>
                                            <TextBlock Text="{DynamicResource EmpSortStatus}" Style="{StaticResource EmpToolbarText}"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Status">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                        </StackPanel>
                    </Button>

                                    <Button Command="{Binding SortByCommand}" CommandParameter="Problems">
                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmpToolbarIcon}">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{DynamicResource EmpSortProblems}" Style="{StaticResource EmpToolbarText}"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                            </StackPanel>
                        </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Skeleton loading placeholders -->
                <StackPanel Grid.Row="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ProgressBar IsIndeterminate="True" Height="3" Width="100" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource MsgEmployeesLoading}" FontSize="{DynamicResource FS11}" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonCard}" Height="72" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="44" Height="44" RadiusX="22" RadiusY="22" Style="{StaticResource SkeletonBlock}"/>
                            <StackPanel Margin="14,4,0,0">
                                <Rectangle Width="160" Height="14" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,8"/>
                                <Rectangle Width="100" Height="10" Style="{StaticResource SkeletonBlock}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonCard}" Height="72" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="44" Height="44" RadiusX="22" RadiusY="22" Style="{StaticResource SkeletonBlock}"/>
                            <StackPanel Margin="14,4,0,0">
                                <Rectangle Width="140" Height="14" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,8"/>
                                <Rectangle Width="120" Height="10" Style="{StaticResource SkeletonBlock}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonCard}" Height="72" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="44" Height="44" RadiusX="22" RadiusY="22" Style="{StaticResource SkeletonBlock}"/>
                            <StackPanel Margin="14,4,0,0">
                                <Rectangle Width="180" Height="14" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,8"/>
                                <Rectangle Width="90" Height="10" Style="{StaticResource SkeletonBlock}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== SELECTION BAR ===== -->
                <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="{DynamicResource FS13}" 
                                       VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run Text="{DynamicResource EmpSelectedPrefix}"/>
                                <Run Text="{Binding SelectedCount}"/>
                            </TextBlock>
                            <Button Command="{Binding SelectAllCommand}" Padding="10,4" Margin="0,0,6,0"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}" 
                                    BorderThickness="0" Cursor="Hand" FontSize="{DynamicResource FS12}">
                                <TextBlock Text="{DynamicResource EmpSelectAll}"/>
                            </Button>
                            <Button Command="{Binding BatchGenerateCommand}" Padding="10,4" Margin="0,0,6,0"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}" 
                                    BorderThickness="0" Cursor="Hand" FontSize="{DynamicResource FS12}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource EmpGenerate}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding DeselectAllCommand}" 
                                Padding="10,4" Background="Transparent" BorderThickness="0" 
                                Foreground="White" Cursor="Hand" FontSize="{DynamicResource FS12}">
                            <TextBlock Text="{DynamicResource BtnCancel}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== EMPLOYEE LIST ===== -->
                <Grid Grid.Row="3" ClipToBounds="False">
                    <ScrollViewer Style="{StaticResource ThinScroll}"
                                  ClipToBounds="False"
                                  PreviewMouseWheel="EmployeesScrollViewer_PreviewMouseWheel">
                        <Grid Margin="4,6,4,4" ClipToBounds="False">
                            <!-- TABLE VIEW -->
                            <DataGrid ItemsSource="{Binding EmployeesForTable}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" Background="Transparent" RowBackground="{DynamicResource CardBackgroundBrush}"
                                      AlternatingRowBackground="{DynamicResource ContentBackgroundBrush}"
                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS12}"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.IsDeferredScrollingEnabled="True"
                                      Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only">
                                                <Setter Property="Background" Value="{DynamicResource InfoLightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding FullName}" Width="*" FontWeight="SemiBold">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource EmpSortName}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding PositionTitle}" Width="Auto">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource LabelPosTitle}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="92">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpSortStatus}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableStatusBadge}"
                                                        Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}"
                                                               Style="{StaticResource TableStatusText}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding StartDate}" Width="90">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource WizStartDate}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Phone}" Width="110">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource WizPhone}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Email}" Width="Auto">
                                        <DataGridTextColumn.Header><TextBlock Text="Email"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpBadgePassport}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TableBooleanBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPassport}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableStatusText}">
                                                                <Setter Property="Text" Value="Так"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPassport}" Value="False">
                                                                        <Setter Property="Text" Value="-"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpBadgeVisa}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TableBooleanBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasVisa}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableStatusText}">
                                                                <Setter Property="Text" Value="Так"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasVisa}" Value="False">
                                                                        <Setter Property="Text" Value="-"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpBadgeInsurance}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TableBooleanBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInsurance}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableStatusText}">
                                                                <Setter Property="Text" Value="Так"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasInsurance}" Value="False">
                                                                        <Setter Property="Text" Value="-"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Padding="4,2" Margin="0,0,2,0" Cursor="Hand"
                                                            Foreground="{DynamicResource ForegroundBrush}"
                                                            Style="{StaticResource CardActionBtn}"
                                                            Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"/>
                                                    </Button>
                                                    <Button Padding="4,2" Style="{StaticResource DarkAwareDeleteBtn}"
                                                            Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- LIST VIEW (original cards) -->
                            <ItemsControl ItemsSource="{Binding EmployeesForList}"
                                          ClipToBounds="False"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True"
                                                      Focusable="False"
                                                      Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10" Margin="16,3,16,6" BorderThickness="1" RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                                                h:StaggerAnimation.Enable="True">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only">
                                                            <Setter Property="Background" Value="{DynamicResource InfoChipBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource InfoChipBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          Checked="EmployeeSelectionCheckBox_Changed"
                                                          Unchecked="EmployeeSelectionCheckBox_Changed"
                                                          Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource InfoChipBackgroundBrush}" VerticalAlignment="Top" Margin="0,0,10,0" BorderBrush="{DynamicResource InfoChipBorderBrush}" BorderThickness="1.5">
                                                    <Border.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/></Border.Clip>
                                                    <Grid>
                                                        <Image Source="{Binding PhotoPath, Converter={StaticResource ThumbnailPathConverter}, ConverterParameter=96}" Stretch="UniformToFill" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS18}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InfoChipForegroundBrush}" Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="{DynamicResource FS14}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                                        <Border CornerRadius="8" Padding="6,1" VerticalAlignment="Center" Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" FontSize="{DynamicResource FS10}" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PositionTitle}" FontSize="{DynamicResource FS11}" Foreground="#888" Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="{DynamicResource FS10}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis">
                                                        <Run Text="&#xE80F; " FontFamily="Segoe MDL2 Assets"/>
                                                        <Run Text="{Binding FirmName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><TextBlock Text="&#xE787;" Style="{StaticResource EmployeeMetaIcon}"/><TextBlock Text="{Binding StartDate}" Style="{StaticResource EmployeeMetaText}"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><TextBlock Text="&#xE717;" Style="{StaticResource EmployeeMetaIcon}"/><TextBlock Text="{Binding Phone}" Style="{StaticResource EmployeeMetaText}"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><TextBlock Text="&#xE715;" Style="{StaticResource EmployeeMetaIcon}"/><TextBlock Text="{Binding Email}" Style="{StaticResource EmployeeMetaText}"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE821;" Style="{StaticResource EmployeeMetaIcon}"/><TextBlock Text="{Binding ContractType}" Style="{StaticResource EmployeeMetaText}"/></StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Border>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource EmployeeDocChipBorder}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PassportSeverity}" Value="Expired"><Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding PassportSeverity}" Value="Critical"><Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding PassportSeverity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding PassportSeverity}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
