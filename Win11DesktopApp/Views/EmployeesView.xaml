                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                                 ToolTip="{Binding PositionTitle}"
                                                                                 Visibility="{Binding PositionTitle, Converter={StaticResource StrToVis}}"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding FirmName}"
                                                                   Style="{StaticResource EmployeeTileClearText}"
                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=11}"
                                                                   Foreground="{DynamicResource EmployeeTileTextMutedBrush}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FirmName}"
                                                                   Visibility="{Binding FirmName, Converter={StaticResource StrToVis}}"/>
