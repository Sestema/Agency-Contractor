<UserControl x:Class="Win11DesktopApp.Views.DocumentsStatusOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:controls="clr-namespace:Win11DesktopApp.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="860">
    <!-- "Documents in order" dialog on the dashboard: ring on the left, people by state on the right. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="TextToVis"/>
        <Style x:Key="DocsPanelCard" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>
        <Style x:Key="DocsTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="{DynamicResource FS13}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                Padding="2,4,2,8" Margin="0,0,18,0">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsDocsDialogOpen, Converter={StaticResource BoolToVis}}">
        <Border Background="{DynamicResource OverlayBrush}" Margin="-24,-16">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDocsDialogCommand}"/>
            </Border.InputBindings>
        </Border>
        <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="16"
                Width="820" MaxWidth="900" Height="580" MaxHeight="620" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SuccessLightBrush}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DashDocsOkTitle}" FontSize="{DynamicResource FS20}"
                                       FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding DocsDialogDateText}" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseDocsDialogCommand}" VerticalAlignment="Center"
                            Style="{StaticResource HeaderGhostButton}" Width="34" Height="34">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: ring and short facts -->
                    <Border Style="{StaticResource DocsPanelCard}">
                        <StackPanel>
                            <Grid Width="150" Height="150" HorizontalAlignment="Center" Margin="0,4,0,12">
                                <controls:MovementRing Added="{Binding DocsOkEmployees}"
                                                       Archived="{Binding DocsNotOkEmployees}"
                                                       AddedBrush="{DynamicResource SuccessBrush}"
                                                       ArchivedBrush="{DynamicResource ErrorBrush}"
                                                       TrackBrush="{DynamicResource DividerBrush}"
                                                       RingThickness="14"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DocsOkPercentText}" FontSize="{DynamicResource FS28}" FontWeight="Bold"
                                               Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DocsOkOfText}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DocsOkEmployees}" FontSize="{DynamicResource FS18}" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource DashDocsTabOk}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DocsNotOkEmployees}" FontSize="{DynamicResource FS18}" FontWeight="Bold"
                                               Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource DashDocsWithProblems}" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,10" Visibility="{Binding DocsTopFirmText, Converter={StaticResource TextToVis}}">
                                <TextBlock Text="{DynamicResource DashDocsTopFirm}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding DocsTopFirmText}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DocsTopFirmText}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DashDocsRuleHint}" FontSize="{DynamicResource FS11}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TertiaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: tabs and people -->
                    <Border Grid.Column="2" Style="{StaticResource DocsPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource DocsTabButton}" Command="{Binding SelectDocsTabCommand}" CommandParameter="expired"
                                            Tag="{Binding IsDocsTabExpired}">
                                        <TextBlock>
                                            <Run Text="{DynamicResource DashDocsTabExpired}"/><Run Text=" · "/><Run Text="{Binding DocsExpiredPeople.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource DocsTabButton}" Command="{Binding SelectDocsTabCommand}" CommandParameter="soon"
                                            Tag="{Binding IsDocsTabSoon}">
                                        <TextBlock>
                                            <Run Text="{DynamicResource DashDocsTabSoon}"/><Run Text=" · "/><Run Text="{Binding DocsSoonPeople.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource DocsTabButton}" Command="{Binding SelectDocsTabCommand}" CommandParameter="ok"
                                            Tag="{Binding IsDocsTabOk}">
                                        <TextBlock>
                                            <Run Text="{DynamicResource DashDocsTabOk}"/><Run Text=" · "/><Run Text="{Binding DocsOkPeople.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{Binding DocsVisibleEmptyText}"
                                       FontSize="{DynamicResource FS13}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding DocsVisiblePeople.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"/>
                            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}"
                                          Visibility="{Binding DocsVisiblePeople.Count, Converter={StaticResource IntToVis}}">
                                <ItemsControl ItemsSource="{Binding DocsVisiblePeople}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="9" Padding="8,7" Margin="0,0,0,2" Cursor="Hand"
                                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenDocsEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Avatar" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                                                            Background="{DynamicResource SuccessLightBrush}">
                                                        <TextBlock x:Name="AvatarText" Text="{Binding Initials}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS11}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Chips}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                  MaxWidth="330">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel HorizontalAlignment="Right"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="Chip" CornerRadius="9" Padding="8,2" Margin="4,2,0,2"
                                                                        Background="{DynamicResource SurfaceBrush}">
                                                                    <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="{DynamicResource FS11}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="expired">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/>
                                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource ErrorChipForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="soon">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/>
                                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource WarningChipForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="expired">
                                                    <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
                                                    <Setter TargetName="AvatarText" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="soon">
                                                    <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                    <Setter TargetName="AvatarText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2" Text="{DynamicResource DashMovementOpenEmployeeHint}"
                           FontSize="{DynamicResource FS11}" Foreground="{DynamicResource TertiaryForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
