<UserControl x:Class="Win11DesktopApp.Views.StepInsuranceDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Win11DesktopApp.Views">
    <UserControl.Resources>
        <Geometry x:Key="GeomInsuranceStep">M10 1.8L16.5 4.4V9.4C16.5 13.7 13.7 17.3 10 18.5C6.3 17.3 3.5 13.7 3.5 9.4V4.4L10 1.8ZM9.2 6.2V8.9H6.5V10.5H9.2V13.2H10.8V10.5H13.5V8.9H10.8V6.2H9.2Z</Geometry>
        <Geometry x:Key="GeomSparkleInsurance">M10 2L11.7 6.8L16.5 8.5L11.7 10.2L10 15L8.3 10.2L3.5 8.5L8.3 6.8L10 2ZM15.5 12.2L16.3 14.5L18.6 15.3L16.3 16.1L15.5 18.4L14.7 16.1L12.4 15.3L14.7 14.5L15.5 12.2Z</Geometry>

        <Style x:Key="InsuranceFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="1,0,0,4"/>
        </Style>

        <Style x:Key="InsuranceFieldInput" TargetType="TextBox" BasedOn="{StaticResource WizInput}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InsuranceFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource WizCombo}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=3}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource ThinScroll}" Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Hidden"
                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <!-- Header + AI Scan -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PageHeaderIconBadge}" Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}">
                                <Path Data="{StaticResource GeomInsuranceStep}" Width="16" Height="16" Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource StepInsuranceData}"
                                       FontSize="{DynamicResource FS16}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding AIScanDocumentCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Height="34" Padding="14,0"
                                Visibility="{Binding IsAIScanning, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomSparkleInsurance}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource AIScanBtn}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin AI status banner -->
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                            Background="{DynamicResource AccentLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding AIScanStatus, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding AIScanStatus}"
                                   FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Single-column fields -->
                    <TextBlock Text="{DynamicResource WizInsCompany}" Style="{StaticResource InsuranceFieldLabel}"/>
                    <ComboBox Style="{StaticResource InsuranceFieldCombo}"
                              ItemsSource="{Binding InsuranceCompanies}"
                              SelectedItem="{Binding SelectedInsuranceCompany}"
                              DisplayMemberPath="DisplayName"
                              IsEditable="False"/>

                    <TextBlock Text="{DynamicResource WizInsCompanyShort}" Style="{StaticResource InsuranceFieldLabel}"/>
                    <TextBox Text="{Binding Data.InsuranceCompanyShort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InsuranceFieldInput}"
                             IsReadOnly="True"/>

                    <TextBlock Text="{DynamicResource WizInsCompanyFull}" Style="{StaticResource InsuranceFieldLabel}"/>
                    <TextBox Text="{Binding InsuranceCompanyFullDisplay, Mode=OneWay}"
                             Style="{StaticResource InsuranceFieldInput}"
                             IsReadOnly="True"/>

                    <TextBlock Text="{DynamicResource WizInsNumber}" Style="{StaticResource InsuranceFieldLabel}"/>
                    <TextBox Text="{Binding Data.InsuranceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InsuranceFieldInput}"/>

                    <TextBlock Text="{DynamicResource WizInsExpiry}" Style="{StaticResource InsuranceFieldLabel}"/>
                    <TextBox Text="{Binding Data.InsuranceExpiry, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InsuranceFieldInput}"
                             Margin="0"/>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" Margin="0"/>

            <views:DocumentPreviewPanel Grid.Column="2" Margin="10,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
