<Window x:Class="Win11DesktopApp.Views.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FinExportSettings}"
        Width="480"
        Height="700"
        MinWidth="420"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <ScrollViewer Style="{StaticResource ThinScroll}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource FinExportSettings}"
                           FontSize="{DynamicResource FS18}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,14"/>

                <CheckBox x:Name="HideZeroPayoutBox"
                          Checked="HideZeroPayout_Changed"
                          Unchecked="HideZeroPayout_Changed"
                          FontSize="{DynamicResource FS13}"
                          Foreground="{DynamicResource ForegroundBrush}"
                          Cursor="Hand"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource FinExportHideZeroPayout}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FS13}"/>
                </CheckBox>

                <Border Style="{StaticResource DialogPreviewSurface}"
                        Padding="12,10"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FinExportHideZeroPayoutOnTitle}"
                                   FontSize="{DynamicResource FS12}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{DynamicResource FinExportHideZeroPayoutOn}"
                                   FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DialogPreviewSurface}"
                        Padding="12,10"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FinExportHideZeroPayoutOffTitle}"
                                   FontSize="{DynamicResource FS12}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource FinExportHideZeroPayoutOff}"
                                   FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource FinExportFontSizeTitle}"
                           FontSize="{DynamicResource FS14}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{DynamicResource FinExportFontSizeHint}"
                           FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="FontSizeSlider"
                            Minimum="1"
                            Maximum="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            VerticalAlignment="Center"
                            ValueChanged="FontSizeSlider_Changed"/>
                    <Border Grid.Column="1"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            Background="{DynamicResource ContentBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="FontSizeValueText"
                                   FontSize="{DynamicResource FS12}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   MinWidth="16"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock Text="{DynamicResource FinExportColumnsTitle}"
                           FontSize="{DynamicResource FS14}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{DynamicResource FinExportColumnsHint}"
                           FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"/>

                <Border Style="{StaticResource DialogPreviewSurface}" Padding="10,8">
                    <ItemsControl x:Name="ExportColumnsList">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          FontSize="{DynamicResource FS12}"
                                          Foreground="{DynamicResource ForegroundBrush}"
                                          Cursor="Hand"
                                          VerticalContentAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource FS12}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
