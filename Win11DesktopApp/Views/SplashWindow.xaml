<Window x:Class="Win11DesktopApp.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsTabStop="False">

    <Border Width="440" Height="320"
            CornerRadius="24"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF20232E" Offset="0"/>
                <GradientStop Color="#FF14161E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#22FFFFFF"/>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0"
                   Source="pack://application:,,,/Resources/splash_logo.png"
                   Width="112" Height="112"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- App name -->
            <TextBlock Grid.Row="1"
                       Text="Agency Contractor"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>

            <!-- Version -->
            <TextBlock x:Name="VersionText"
                       Grid.Row="2"
                       Text="v0.0.0"
                       FontFamily="Segoe UI Variable Small, Segoe UI"
                       FontSize="12"
                       Foreground="#99FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <!-- Spinner -->
            <Canvas Grid.Row="3"
                    Width="44" Height="44"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Center">
                <Path StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 22,4 A 18,18 0 1 1 4,22"
                      Width="44" Height="44">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2D5BFF" Offset="0"/>
                            <GradientStop Color="#FF7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="22" CenterY="22"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:0.9"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Canvas>
        </Grid>
    </Border>
</Window>
