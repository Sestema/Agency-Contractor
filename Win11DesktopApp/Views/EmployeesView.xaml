                                                                                   Style="{StaticResource EmployeeTileClearText}"
                                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=9}" FontWeight="Medium"
                                                                                   Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Grid Margin="4,0,0,0" Tag="EmployeeCardMoreMenu">
                                                                    <Button x:Name="MoreBtn" Style="{StaticResource EmployeeCardMoreBtn}"
                                                                            Click="EmployeeCardMoreButton_Click">
                                                                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=10}"
                                                                                   Foreground="{DynamicResource EmployeeTileTextMutedBrush}"/>
                                                                    </Button>
                                                                    <Popup x:Name="ActionPopup"
                                                                           PlacementTarget="{Binding ElementName=MoreBtn}"
                                                                           Placement="Bottom"
                                                                           HorizontalOffset="-186"
                                                                           StaysOpen="True"
                                                                           AllowsTransparency="True"
                                                                           PopupAnimation="Fade">
                                                                        <Border CornerRadius="10" Padding="6"
                                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                                BorderThickness="1">
                                                                            <StackPanel>
                                                                                <Button Style="{StaticResource EmployeeCardPopupBtn}"
                                                                                        Click="EmployeeCardOpenFolder_Click">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                                                                   FontSize="{DynamicResource FS12}" Margin="0,0,8,0"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{DynamicResource EmpTooltipFolder}"
                                                                                                   FontSize="{DynamicResource FS11}" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Button Style="{StaticResource EmployeeCardPopupDeleteBtn}"
                                                                                        Click="EmployeeCardDelete_Click">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                                                   FontSize="{DynamicResource FS12}" Margin="0,0,8,0"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{DynamicResource EmpBtnDelete}"
                                                                                                   FontSize="{DynamicResource FS11}" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Popup>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                                 Text="{Binding PositionTitle}"
