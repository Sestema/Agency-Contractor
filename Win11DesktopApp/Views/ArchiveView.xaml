                                   FontWeight="SemiBold" Foreground="{DynamicResource InfoChipForegroundBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FirmName}"/>
                    </Border>

                    <Border Margin="0,0,0,8" CornerRadius="12" Padding="6,6"
                            Background="{DynamicResource EmployeeTileInfoPanelBrush}"
                            BorderBrush="{DynamicResource EmployeeTileInfoPanelBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Stretch"
                                        Visibility="{Binding StartDate, Converter={StaticResource StrToVis}}">
