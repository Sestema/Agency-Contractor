<Window x:Class="Win11DesktopApp.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsTabStop="False"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.38">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="440" Height="440" ClipToBounds="False">
            <Border x:Name="GlowHost"
                    Width="400" Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    ClipToBounds="False"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.94" ScaleY="0.94"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="GlowEffect"
                                      Color="#00E5FF"
                                      BlurRadius="40"
                                      ShadowDepth="0"
                                      Opacity="0.34"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ContentScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ContentScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                 Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                 From="0.24" To="0.46"
                                                 Duration="0:0:2.1"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid Width="300" Height="300"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ClipToBounds="False">
                    <Ellipse Width="294" Height="294"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#1200E5FF"
                             Opacity="0.22">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.14" To="0.28"
                                                         Duration="0:0:2.1"
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Width="280" Height="280"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#FF000000"
                             StrokeThickness="1.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF00E5FF" Offset="0"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.55"/>
                                <GradientStop Color="#8800E5FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>

                    <Viewbox Width="250" Height="250"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             ClipToBounds="False">
                        <Image Source="pack://application:,,,/Resources/splash_logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Viewbox>

                    <Canvas Width="300" Height="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Ellipse Canvas.Left="8" Canvas.Top="8"
                                 Width="284" Height="284"
                                 StrokeThickness="1.5"
                                 Opacity="0.28">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6600E5FF" Offset="0"/>
                                    <GradientStop Color="#66FF00FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <Path StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 150,14 A 136,136 0 1 1 38,230"
                              Width="300" Height="300">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF00E5FF" Offset="0"/>
                                    <GradientStop Color="#FFFF00FF" Offset="0.55"/>
                                    <GradientStop Color="#4400E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="150" CenterY="150"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:1.75"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Text="{DynamicResource DashLoading}"
                   FontFamily="Segoe UI Variable Small, Segoe UI"
                   FontSize="12"
                   Foreground="#BB00E5FF"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>

        <TextBlock x:Name="VersionText"
                   Text="v0.0.0"
                   FontFamily="Segoe UI Variable Small, Segoe UI"
                   FontSize="11"
                   Foreground="#7700E5FF"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"/>
    </StackPanel>
</Window>
