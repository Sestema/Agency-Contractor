<UserControl x:Class="Win11DesktopApp.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:Win11DesktopApp.Views"
             xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels"
             xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
             xmlns:h="clr-namespace:Win11DesktopApp.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:IndexPlusOneConverter x:Key="IndexPlusOne"/>
        <CubicEase x:Key="SmoothEase" EasingMode="EaseOut"/>
        <!-- One joined button panel: Edit, then icon actions separated by thin lines -->
        <Style x:Key="TemplateSegmentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Width="38"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplateSegmentDeleteButton" TargetType="Button" BasedOn="{StaticResource TemplateSegmentButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Width="38" CornerRadius="0,8,8,0"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplateSegmentEditButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8,0,0,8" Padding="13,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource PageBackgroundBrush}" AllowDrop="True"
          PreviewDragOver="Page_PreviewDragOver">
        <Grid Margin="{StaticResource PageOuterMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                        Style="{StaticResource HeaderBackButton}">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadge}"
                            Background="{DynamicResource BrandSuccessGradientBrush}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource PageHeaderIconText}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FS26}"
                                   Style="{StaticResource PageHeaderTitleText}"/>
                        <TextBlock FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,3,0,0">
                            <Run Text="{Binding Templates.Count, Mode=OneWay, FallbackValue=0}"/>
                            <Run Text=" "/>
                            <Run Text="{DynamicResource TplTemplateCount}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Add template button -->
                <Button Grid.Column="2"
                        Command="{Binding AddTemplateCommand}"
                        Style="{StaticResource FilledActionButton}"
                        Padding="18,10"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BrandSuccessHorizontalGradientBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource BtnAddTemplate}" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== LOADING SKELETON ===== -->
            <StackPanel Grid.Row="1"
                        Margin="12,4,12,8"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource SkeletonCard}" Height="78" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="52" Height="52" RadiusX="14" RadiusY="14" Style="{StaticResource SkeletonBlock}"/>
                        <StackPanel Margin="16,6,0,0">
                            <Rectangle Width="220" Height="16" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,10"/>
                            <Rectangle Width="150" Height="11" Style="{StaticResource SkeletonBlock}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SkeletonCard}" Height="78" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="52" Height="52" RadiusX="14" RadiusY="14" Style="{StaticResource SkeletonBlock}"/>
                        <StackPanel Margin="16,6,0,0">
                            <Rectangle Width="180" Height="16" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,10"/>
                            <Rectangle Width="130" Height="11" Style="{StaticResource SkeletonBlock}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SkeletonCard}" Height="78" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="52" Height="52" RadiusX="14" RadiusY="14" Style="{StaticResource SkeletonBlock}"/>
                        <StackPanel Margin="16,6,0,0">
                            <Rectangle Width="200" Height="16" Style="{StaticResource SkeletonBlock}" Margin="0,0,0,10"/>
                            <Rectangle Width="110" Height="11" Style="{StaticResource SkeletonBlock}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== TEMPLATE LIST ===== -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Templates}" Margin="0,4,0,8"
                          AlternationCount="100000"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource ThinScroll}" CanContentScroll="True" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TemplateCard"
                                    Style="{StaticResource ModernCard}"
                                    Background="{DynamicResource CardBackgroundBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="15,12" Margin="12,4,12,14"
                                    Effect="{x:Null}"
                                    AllowDrop="True"
                                    DragOver="TemplateCard_DragOver"
                                    DragLeave="TemplateCard_DragLeave"
                                    Drop="TemplateCard_Drop"
                                    >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag handle: hold and drag to change the order -->
                                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" Padding="2,8,10,8"
                                            VerticalAlignment="Center"
                                            ToolTip="{DynamicResource TplDragToReorder}"
                                            PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="DragHandle_PreviewMouseMove">
                                        <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS16}"
                                                   Foreground="{DynamicResource TertiaryForegroundBrush}"/>
                                    </Border>

                                    <!-- Position number -->
                                    <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Margin="0,0,12,0"
                                            VerticalAlignment="Center" Background="{DynamicResource AccentLightBrush}">
                                        <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexPlusOne}}"
                                                   FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentDarkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Format badge with gradient -->
                                    <Border Grid.Column="2" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BrandPrimaryGradientBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Format}" Value="XLSX">
                                                        <Setter Property="Background" Value="{DynamicResource BrandSuccessGradientBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Format}" Value="PDF">
                                                        <Setter Property="Background" Value="{DynamicResource BrandWarmGradientBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="FormatIcon" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS18}"
                                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE8A5;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Format}" Value="XLSX">
                                                                <Setter Property="Text" Value="&#xE80A;"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Format}" Value="PDF">
                                                                <Setter Property="Text" Value="&#xEA00;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Format}" HorizontalAlignment="Center"
                                                       FontWeight="Bold" FontSize="{DynamicResource FS9}" Foreground="White" Opacity="0.9"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Template info -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FS15}" 
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Style="{StaticResource CounterChipBorder}"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding Format}"
                                                           Style="{StaticResource StatusChipText}"
                                                           FontSize="{DynamicResource FS10}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock FontSize="{DynamicResource FS12}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{DynamicResource TplUpdated}"/>
                                                <Run Text="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action panel: Edit, rename, copy to another firm, delete -->
                                    <Border Grid.Column="4" Height="36" VerticalAlignment="Center" CornerRadius="9"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource TemplateSegmentEditButton}"
                                                    Command="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"
                                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource TplBtnEdit}" FontSize="{DynamicResource FS12}" FontWeight="Medium"
                                                               Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TemplateSegmentButton}"
                                                    ToolTip="{DynamicResource TplRenameTitle}"
                                                    Command="{Binding DataContext.RenameTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button Style="{StaticResource TemplateSegmentButton}"
                                                    ToolTip="{DynamicResource TplCopyToCompanyTooltip}"
                                                    Command="{Binding DataContext.CopyTemplateToCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button Style="{StaticResource TemplateSegmentDeleteButton}"
                                                    ToolTip="{DynamicResource TplBtnDelete}"
                                                    Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS14}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="TemplateCard" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TemplateCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="TemplateCard" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <!-- Empty state -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    >
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AnimatedEmptyStateCard}">
                        <Setter Property="Visibility" Value="{Binding HasTemplates, Converter={StaticResource InverseBoolToVis}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource EmptyStateIconText}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource TplEmptyState}" Style="{StaticResource EmptyStateTitleText}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Modal Dialog Overlay — Add Template ===== -->
        <Grid Visibility="{Binding IsAddDialogOpen, Converter={StaticResource BoolToVis}}"
              Style="{StaticResource OverlayFadeInGrid}">
            <Border Background="{DynamicResource OverlayBrush}">
                 <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAddDialogCommand}"/>
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding AddTemplateVm}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource DialogEntranceContentControl}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:AddTemplateViewModel}" xmlns:vm="clr-namespace:Win11DesktopApp.ViewModels">
                        <views:AddTemplateView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- ===== Copy Template Dialog Overlay ===== -->
        <Grid Visibility="{Binding IsCopyDialogOpen, Converter={StaticResource BoolToVis}}"
              Style="{StaticResource OverlayFadeInGrid}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelCopyTemplateCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource AnimatedDialogSectionCard}"
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28"
                    Background="{DynamicResource ContentBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SoftIconBadge}" Background="{DynamicResource AccentLightBrush}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8FA;" Style="{StaticResource SoftIconBadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{DynamicResource TplCopyDialogTitle}" FontSize="{DynamicResource FS18}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CancelCopyTemplateCommand}"
                                Style="{StaticResource ToolbarInlineIconButton}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Button>
                    </Grid>

                    <!-- What is copied, and from where -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS16}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding CopySourceName}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CopySourceText}" FontSize="{DynamicResource FS11}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="CopyFirmSearchBox"
                                 Text="{Binding CopyFirmSearch, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{DynamicResource FS13}" Padding="32,8,10,8"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="{DynamicResource TplCopySearchPlaceholder}" FontSize="{DynamicResource FS13}" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TertiaryForegroundBrush}" VerticalAlignment="Center" Margin="33,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CopyFirmSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Firms with check boxes -->
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14">
                        <Grid>
                            <ScrollViewer Style="{StaticResource ThinScroll}" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VisibleCopyFirms}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="7" Padding="8,6" Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center"
                                                          HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <Grid Margin="6,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,9,0"
                                                                Background="{DynamicResource AccentLightBrush}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentDarkBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource FS13}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                                Background="{DynamicResource WarningChipBackgroundBrush}"
                                                                BorderBrush="{DynamicResource WarningChipBorderBrush}" BorderThickness="1"
                                                                Visibility="{Binding HasSameName, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{DynamicResource TplCopySameNameExists}" FontSize="{DynamicResource FS10}"
                                                                       Foreground="{DynamicResource WarningChipForegroundBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </CheckBox>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{DynamicResource TplCopyNothingFound}" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="14,12"
                                       Visibility="{Binding HasNoVisibleCopyFirms, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Name in the new firms -->
                    <TextBlock Text="{DynamicResource TplCopyDialogName}" FontSize="{DynamicResource FS13}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CopyTemplateName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="{DynamicResource FS14}" Padding="10,8" Margin="0,0,0,18"
                             Background="{DynamicResource CardBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedCopyFirmsText}" FontSize="{DynamicResource FS12}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding CancelCopyTemplateCommand}" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="16,9"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{DynamicResource BtnCancel}" FontSize="{DynamicResource FS13}" FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding ConfirmCopyTemplateCommand}"
                                    Style="{StaticResource FilledActionButton}"
                                    Padding="18,9">
                                <TextBlock Text="{Binding CopyButtonText}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Rename Dialog Overlay ===== -->
        <Grid Visibility="{Binding IsRenameDialogOpen, Converter={StaticResource BoolToVis}}"
              Style="{StaticResource OverlayFadeInGrid}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelRenameCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource AnimatedDialogSectionCard}"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28"
                    Background="{DynamicResource ContentBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SoftIconBadge}" Background="{DynamicResource WarningLightBrush}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8AC;" Style="{StaticResource SoftIconBadgeText}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="{DynamicResource TplRenameTitle}" FontSize="{DynamicResource FS18}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CancelRenameCommand}"
                                Style="{StaticResource ToolbarInlineIconButton}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource DialogPreviewSurface}" Padding="16,14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TplRenamePrompt}" FontSize="{DynamicResource FS13}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"/>

                            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{DynamicResource FS14}" Padding="10,8" 
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelRenameCommand}" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="16,9"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{DynamicResource BtnCancel}" FontSize="{DynamicResource FS13}" FontWeight="Medium"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding ConfirmRenameCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Padding="18,9">
                            <TextBlock Text="{DynamicResource TplRenameBtn}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Tags Panel Overlay ===== -->
        <Grid Visibility="{Binding IsTagsPanelOpen, Converter={StaticResource BoolToVis}}"
              Style="{StaticResource OverlayFadeInGrid}">
            <Border Background="{DynamicResource OverlayBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseTagsPanelCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource AnimatedDialogSectionCard}"
                    Width="650"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28"
                    Background="{DynamicResource ContentBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SoftIconBadge}" Background="{DynamicResource AccentLightBrush}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8EC;" Style="{StaticResource SoftIconBadgeText}"
                                           Foreground="{DynamicResource AccentDarkBrush}"/>
                            </Border>
                            <TextBlock Text="{DynamicResource TplTagsTitle}" FontSize="{DynamicResource FS18}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding CloseTagsPanelCommand}"
                                Style="{StaticResource ToolbarInlineIconButton}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" 
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource DialogPreviewSurface}" Padding="14,12" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="{DynamicResource FS12}"
                                   Text="{DynamicResource TplTagsDesc}"/>
                    </Border>

                    <!-- Tags list -->
                    <Border Grid.Row="2" Style="{StaticResource DialogPreviewSurface}" Padding="10">
                        <ScrollViewer Style="{StaticResource ThinScroll}" MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding AvailableTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DialogPreviewSurface}"
                                            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" 
                                            Padding="12,8" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" CornerRadius="6" Padding="8,3" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="Employee">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Agency">
                                                                <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FS10}" FontWeight="Medium" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource FS13}" FontFamily="Consolas"
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="${"/><Run Text="{Binding Tag}"/><Run Text="}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" 
                                                    Command="{Binding DataContext.CopyTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="10,5">
                                                            <TextBlock Text="{DynamicResource TplCopyTag}" FontSize="{DynamicResource FS11}" FontWeight="Medium"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding OpenTemplateFileCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS13}"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource TplOpenEditor}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
