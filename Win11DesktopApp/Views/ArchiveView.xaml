                                <TextBlock Text="{DynamicResource ExportColStartDate}"
                                           FontSize="{DynamicResource FS9}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource EmployeeTileTextMutedBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Height="28" VerticalAlignment="Center"
                                    Margin="4,0" Background="{DynamicResource EmployeeTileInfoPanelBorderBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding StartDate, Converter={StaticResource StrToVis}}" Value="Visible"/>
                                                    <Condition Binding="{Binding EndDate, Converter={StaticResource StrToVis}}" Value="Visible"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch"
                                        Visibility="{Binding EndDate, Converter={StaticResource StrToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,1">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource FS10}"
                                               Foreground="{DynamicResource EmployeeTileTextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding EndDate, Mode=OneWay}"
