<Window x:Class="Win11DesktopApp.Views.SalaryQrPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FinQrTitle}"
        Width="500" SizeToContent="Height" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource PageHeaderIconBadge}">
                <TextBlock Text="&#xED14;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PageHeaderIconText}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource FinQrTitle}"
                           FontSize="{DynamicResource FS18}"
                           Style="{StaticResource PageHeaderTitleText}"/>
                <TextBlock x:Name="NameText"
                           FontSize="{DynamicResource FS13}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionCard}">
            <StackPanel>
                <TextBlock x:Name="AmountText" FontSize="{DynamicResource FS20}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
                <TextBlock x:Name="AccountText" FontSize="{DynamicResource FS13}"
                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BankText" FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="IbanText" FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,10,0,12" TextWrapping="Wrap"/>

                <Image x:Name="QrImage" Width="260" Height="260" HorizontalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock x:Name="StatusText"
                           FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Click="Close_Click" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource FilledActionButton}">
            <TextBlock Text="{DynamicResource BtnDone}" FontSize="{DynamicResource FS13}"
                       Foreground="White" FontWeight="SemiBold"/>
        </Button>
    </Grid>
</Window>
