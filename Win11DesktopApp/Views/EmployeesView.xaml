                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border CornerRadius="8" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" BorderThickness="1">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByStatCommand}" CommandParameter="all"/>
