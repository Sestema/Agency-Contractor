                                                </Trigger>
                                                <DataTrigger Binding="{Binding StatFilter}" Value="all">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TotalCount}" FontSize="{DynamicResource FS14}" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{DynamicResource EmpStatTotal}" FontSize="{DynamicResource FS10}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" BorderThickness="1">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByStatCommand}" CommandParameter="problems"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding StatFilter}" Value="problems">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningChipForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProblemsCount}" FontSize="{DynamicResource FS14}" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{DynamicResource EmpStatProblems}" FontSize="{DynamicResource FS10}"
                                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Padding="8,3" Cursor="Hand" BorderThickness="1">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByStatCommand}" CommandParameter="new"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding StatFilter}" Value="new">
                                                    <Setter Property="BorderBrush" Value="#1565C0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NewThisMonth}" FontSize="{DynamicResource FS14}" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{DynamicResource EmpStatNewMonth}" FontSize="{DynamicResource FS10}"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Height="18" Background="{DynamicResource CardBorderBrush}" Margin="6,0,10,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource EmpSortLabel}" FontSize="{DynamicResource FS12}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <Border CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    Background="{DynamicResource ContentBackgroundBrush}"
                                    Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SortByCommand}" CommandParameter="Name">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Name">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource EmpSortName}" FontSize="{DynamicResource FS12}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Name">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Border Width="1" Margin="1,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Name">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SortField}" Value="StartDate">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Button Command="{Binding SortByCommand}" CommandParameter="StartDate">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="StartDate">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource EmpSortDate}" FontSize="{DynamicResource FS12}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="StartDate">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Border Width="1" Margin="1,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="StartDate">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Status">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Button Command="{Binding SortByCommand}" CommandParameter="Status">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Status">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource EmpSortStatus}" FontSize="{DynamicResource FS12}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Status">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Border Width="1" Margin="1,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Status">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Button Command="{Binding SortByCommand}" CommandParameter="Problems">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                        <Setter Property="Tag" Value="Active"/>
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{DynamicResource EmpSortProblems}" FontSize="{DynamicResource FS12}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS9}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE74A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SortField}" Value="Problems">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                                                <Setter Property="Text" Value="&#xE74B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== SELECTION BAR ===== -->
                <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="{DynamicResource FS13}" 
                                       VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run Text="{DynamicResource EmpSelectedPrefix}"/>
                                <Run Text="{Binding SelectedCount}"/>
                            </TextBlock>
                            <Button Command="{Binding SelectAllCommand}" Padding="10,4" Margin="0,0,6,0"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}" 
                                    BorderThickness="0" Cursor="Hand" FontSize="{DynamicResource FS12}">
                                <TextBlock Text="{DynamicResource EmpSelectAll}"/>
                            </Button>
                            <Button Command="{Binding BatchGenerateCommand}" Padding="10,4" Margin="0,0,6,0"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}" 
                                    BorderThickness="0" Cursor="Hand" FontSize="{DynamicResource FS12}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource EmpGenerate}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding DeselectAllCommand}" 
                                Padding="10,4" Background="Transparent" BorderThickness="0" 
                                Foreground="White" Cursor="Hand" FontSize="{DynamicResource FS12}">
                            <TextBlock Text="{DynamicResource BtnCancel}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== EMPLOYEE LIST ===== -->
                <Grid Grid.Row="3" ClipToBounds="False">
                    <ScrollViewer Style="{StaticResource ThinScroll}"
                                  ClipToBounds="False"
                                  PreviewMouseWheel="EmployeesScrollViewer_PreviewMouseWheel">
                        <Grid Margin="4,6,4,4" ClipToBounds="False">
                            <!-- TABLE VIEW -->
                            <DataGrid ItemsSource="{Binding EmployeesForTable}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" Background="Transparent" RowBackground="{DynamicResource CardBackgroundBrush}"
                                      AlternatingRowBackground="{DynamicResource ContentBackgroundBrush}"
                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FS12}"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.IsDeferredScrollingEnabled="True"
                                      Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only">
                                                <Setter Property="Background" Value="{DynamicResource InfoLightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding FullName}" Width="*" FontWeight="SemiBold">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource EmpSortName}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding PositionTitle}" Width="Auto">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource LabelPosTitle}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="92">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpSortStatus}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableStatusBadge}"
                                                        Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}"
                                                               Style="{StaticResource TableStatusText}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding StartDate}" Width="90">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource WizStartDate}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Phone}" Width="110">
                                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource WizPhone}"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Email}" Width="Auto">
                                        <DataGridTextColumn.Header><TextBlock Text="Email"/></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpBadgePassport}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TableBooleanBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPassport}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableStatusText}">
                                                                <Setter Property="Text" Value="Так"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPassport}" Value="False">
                                                                        <Setter Property="Text" Value="-"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpBadgeVisa}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TableBooleanBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasVisa}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableStatusText}">
                                                                <Setter Property="Text" Value="Так"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasVisa}" Value="False">
                                                                        <Setter Property="Text" Value="-"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource EmpBadgeInsurance}"/></DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TableBooleanBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInsurance}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableStatusText}">
                                                                <Setter Property="Text" Value="Так"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessChipForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasInsurance}" Value="False">
                                                                        <Setter Property="Text" Value="-"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Padding="4,2" Margin="0,0,2,0" Cursor="Hand"
                                                            Foreground="{DynamicResource ForegroundBrush}"
                                                            Style="{StaticResource CardActionBtn}"
                                                            Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"/>
                                                    </Button>
                                                    <Button Padding="4,2" Style="{StaticResource DarkAwareDeleteBtn}"
                                                            Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- LIST VIEW (original cards) -->
                            <ItemsControl ItemsSource="{Binding EmployeesForList}"
                                          ClipToBounds="False"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True"
                                                      Focusable="False"
                                                      Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10" Margin="16,3,16,6" BorderThickness="1" RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                                                h:StaggerAnimation.Enable="True">
