                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource CardActionBtn}" Margin="0,0,0,3" Padding="8,4" Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource EmpBtnEdit}" FontSize="{DynamicResource FS11}"/></StackPanel></Button>
                                                    <Button Style="{StaticResource CardActionBtn}" Margin="0,0,0,3" Padding="8,4" Command="{Binding DataContext.OpenEmployeeFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource EmpTooltipFolder}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource EmpBtnFolder}" FontSize="{DynamicResource FS11}"/></StackPanel></Button>
                                                    <Button Style="{StaticResource DarkAwareDeleteBtn}" Padding="8,4" Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource EmpTooltipDelete}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource EmpBtnDelete}" FontSize="{DynamicResource FS11}"/></StackPanel></Button>
