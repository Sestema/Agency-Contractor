<Window x:Class="Win11DesktopApp.Views.EmployeeHistoryCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Win11DesktopApp.Converters"
        Title="{DynamicResource HistCleanupTitle}"
        Width="1040" Height="700" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="TextToVis"/>
        <Style x:Key="HcCard" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>
        <Style x:Key="HcFilterButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS11}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HcDangerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HcPlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS12}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HcEventTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="{DynamicResource FS11}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="added">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="archived">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="restored">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="salary">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ErrorLightBrush}" Margin="0,0,12,0">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                           Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource HistCleanupTitle}" FontSize="{DynamicResource FS20}" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{DynamicResource HistCleanupDescription}" FontSize="{DynamicResource FS11}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" MaxWidth="760" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Server mode: not available -->
        <Border Grid.Row="1" Style="{StaticResource HcCard}" VerticalAlignment="Top"
                Visibility="{Binding IsNotSupported, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource HistCleanupPostgresBlocked}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FS13}" Foreground="{DynamicResource ForegroundBrush}"/>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- People -->
            <Border Style="{StaticResource HcCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{DynamicResource FS13}" Padding="30,7,8,7"
                                 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="{DynamicResource HistCleanupSearch}" FontSize="{DynamicResource FS13}" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TertiaryForegroundBrush}" VerticalAlignment="Center" Margin="31,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource HcFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="all"
                                Tag="{Binding IsFilterAll}" Content="{DynamicResource HistCleanupFilterAll}"/>
                        <Button Style="{StaticResource HcFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="active"
                                Tag="{Binding IsFilterActive}" Content="{DynamicResource HistCleanupFilterActive}"/>
                        <Button Style="{StaticResource HcFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="archived"
                                Tag="{Binding IsFilterArchived}" Content="{DynamicResource HistCleanupFilterArchived}"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding VisiblePeople}" SelectedItem="{Binding SelectedPerson}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Margin="0,0,0,2" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" Background="{DynamicResource SurfaceBrush}">
                                        <TextBlock Text="{Binding Initials}" FontSize="{DynamicResource FS11}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource FS13}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{DynamicResource FS11}" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding CurrentFirm}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Periods of the selected person -->
            <Border Grid.Column="2" Style="{StaticResource HcCard}">
                <Grid>
                    <TextBlock Text="{DynamicResource HistCleanupPickPerson}" FontSize="{DynamicResource FS13}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoSelectedPerson, Converter={StaticResource BoolToVis}}"/>
                    <Grid Visibility="{Binding HasSelectedPerson, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedPerson.FullName}" FontSize="{DynamicResource FS18}" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding SelectedPersonSubtitle}" FontSize="{DynamicResource FS12}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroll}" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding Periods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1" Padding="12" Margin="0,0,0,10"
                                                BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource WindowBackgroundBrush}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                        <Border x:Name="CurrentChip" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource SuccessLightBrush}" Visibility="Collapsed">
                                                            <TextBlock Text="{DynamicResource HistCleanupCurrent}" FontSize="{DynamicResource FS10}"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                        <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                Visibility="{Binding DurationText, Converter={StaticResource TextToVis}}">
                                                            <TextBlock Text="{Binding DurationText}" FontSize="{DynamicResource FS10}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DatesText}" FontSize="{DynamicResource FS12}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0"
                                                              ItemTemplate="{StaticResource HcEventTemplate}"/>
                                                <TextBlock Text="{DynamicResource HistCleanupNoEvents}" FontSize="{DynamicResource FS11}" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TertiaryForegroundBrush}"
                                                           Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Money already recorded -->
                                                <Border CornerRadius="8" Padding="10,6" Margin="0,8,0,0" Background="{DynamicResource WarningLightBrush}"
                                                        Visibility="{Binding HasMoney, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl ItemsSource="{Binding MoneyFound}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource FS11}" Foreground="{DynamicResource WarningBrush}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding BlockReason}" FontSize="{DynamicResource FS11}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Style="{StaticResource HcDangerButton}"
                                                            Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/>
                                                            <TextBlock Text="{DynamicResource HistCleanupDeleteButton}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter TargetName="CurrentChip" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Records about firms without a period -->
                            <StackPanel Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource HistCleanupOrphanTitle}" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource HistCleanupOrphanHint}" FontSize="{DynamicResource FS11}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,8"/>
                                <ItemsControl ItemsSource="{Binding Orphans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" BorderThickness="1" Padding="12" Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource WarningBrush}" Background="{DynamicResource WindowBackgroundBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FirmName}" FontSize="{DynamicResource FS14}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                        <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource WarningLightBrush}">
                                                            <TextBlock Text="{DynamicResource HistCleanupOrphanChip}" FontSize="{DynamicResource FS10}"
                                                                       Foreground="{DynamicResource WarningBrush}"/>
                                                        </Border>
                                                        <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource SurfaceBrush}">
                                                            <TextBlock Text="{Binding CountText}" FontSize="{DynamicResource FS10}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0"
                                                                  ItemTemplate="{StaticResource HcEventTemplate}"/>
                                                    <Button Style="{StaticResource HcDangerButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                                            Command="{Binding DataContext.AskDeleteOrphansCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/>
                                                            <TextBlock Text="{DynamicResource HistCleanupOrphanDeleteButton}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="{DynamicResource FS11}" Margin="0,10,0,0"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"
                   Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}"/>

        <!-- Busy -->
        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,4"
                     Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- Confirmation -->
        <Grid Grid.RowSpan="3" Margin="-20" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}"/>
            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="14" Padding="22" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ErrorLightBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding ConfirmTitle}" FontSize="{DynamicResource FS16}" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConfirmSubtitle}" FontSize="{DynamicResource FS12}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ConfirmLines}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS11}"
                                               Foreground="{DynamicResource SuccessBrush}" Margin="0,2,8,0"/>
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource FS12}" Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,14" Background="{DynamicResource InfoLightBrush}">
                        <TextBlock Text="{DynamicResource HistCleanupBackupHint}" FontSize="{DynamicResource FS11}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource HcPlainButton}" Command="{Binding CancelDeleteCommand}" Margin="0,0,8,0"
                                Content="{DynamicResource BtnCancel}"/>
                        <Button Style="{StaticResource HcDangerButton}" Command="{Binding ConfirmDeleteCommand}"
                                Content="{DynamicResource HistCleanupConfirmButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
