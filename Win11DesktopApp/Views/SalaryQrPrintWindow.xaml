<Window x:Class="Win11DesktopApp.Views.SalaryQrPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FinQrPrintTitle}"
        Width="560" Height="640" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource PageHeaderIconBadge}">
                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PageHeaderIconText}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource FinQrPrintTitle}"
                           FontSize="{DynamicResource FS18}"
                           Style="{StaticResource PageHeaderTitleText}"/>
                <TextBlock Text="{DynamicResource FinQrPrintDesc}"
                           FontSize="{DynamicResource FS11}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionCard}" Padding="8">
            <Grid>
                <ListBox x:Name="PeopleList"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      FontSize="{DynamicResource FS13}"
                                      Foreground="{DynamicResource ForegroundBrush}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding FullName, Mode=OneWay}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding AmountText, Mode=OneWay}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText"
                           Text="{DynamicResource FinQrPrintNone}"
                           FontSize="{DynamicResource FS12}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource FinExportSelectAll}" Click="SelectAll_Click"
                    Padding="12,6" Margin="0,0,8,0" Style="{StaticResource HeaderGhostButton}"/>
            <Button Content="{DynamicResource FinExportClearAll}" Click="ClearAll_Click"
                    Padding="12,6" Style="{StaticResource HeaderGhostButton}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource BtnCancel}" Click="Cancel_Click"
                    Margin="0,0,8,0" Padding="16,8" Style="{StaticResource HeaderGhostButton}"/>
            <Button Click="Print_Click" Style="{StaticResource FilledActionButton}" Padding="20,8">
                <TextBlock Text="{DynamicResource FinQrPrint}" FontSize="{DynamicResource FS13}"
                           Foreground="White" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
