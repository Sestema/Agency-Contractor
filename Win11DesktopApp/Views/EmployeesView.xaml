                                                    </Border>

                                                    <Border Grid.Column="4" ToolTip="{Binding InsuranceExpiry}" Tag="insurance" Cursor="Hand"
                                                            MouseLeftButtonUp="EmployeeDocumentButton_MouseLeftButtonUp"
                                                            Padding="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='5,2'}"
                                                            MinHeight="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=38}"
                                                            CornerRadius="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomCornerRadius}, ConverterParameter=14}"
                                                            BorderThickness="1"
                                                            Background="{Binding InsuranceSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Background}"
                                                            BorderBrush="{Binding InsuranceSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=CardBorder}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='3,0,0,0'}"
                                                                    Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=32}"
                                                                    Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=32}"
                                                                    CornerRadius="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomCornerRadius}, ConverterParameter=10}"
                                                                    Background="{Binding InsuranceSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Tile}">
                                                                <Viewbox Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=18}"
                                                                         Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=18}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconDocInsurance}"
                                                                          Stretch="Uniform"
                                                                          Stroke="{Binding InsuranceSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Foreground}"
                                                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Fill="Transparent"/>
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource EmpBadgeInsurance}"
                                                                       Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='4,0,1,0'}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Style="{StaticResource EmployeeTileClearText}" FontWeight="SemiBold"
                                                                       FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=10}"
                                                                       Foreground="{Binding InsuranceSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Foreground}"/>
                                                        </Grid>
                                                    </Border>

                                                    <Border Grid.Column="6" ToolTip="{Binding WorkPermitExpiry}" Tag="permit" Cursor="Hand"
                                                            MouseLeftButtonUp="EmployeeDocumentButton_MouseLeftButtonUp"
                                                            Padding="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='5,2'}"
                                                            MinHeight="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=38}"
                                                            CornerRadius="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomCornerRadius}, ConverterParameter=14}"
                                                            BorderThickness="1"
                                                            Background="{Binding WorkPermitSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Background}"
                                                            BorderBrush="{Binding WorkPermitSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=CardBorder}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='3,0,0,0'}"
                                                                    Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=32}"
                                                                    Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=32}"
                                                                    CornerRadius="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomCornerRadius}, ConverterParameter=10}"
                                                                    Background="{Binding WorkPermitSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Tile}">
                                                                <Viewbox Width="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=18}"
                                                                         Height="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomDouble}, ConverterParameter=18}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconDocWorkPermit}"
                                                                          Stretch="Uniform"
                                                                          Stroke="{Binding WorkPermitSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Foreground}"
                                                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Fill="Transparent"/>
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource EmpBadgeWorkPermit}"
                                                                       Margin="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomThickness}, ConverterParameter='4,0,1,0'}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Style="{StaticResource EmployeeTileClearText}" FontWeight="SemiBold"
                                                                       FontSize="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ZoomFontSize}, ConverterParameter=10}"
                                                                       Foreground="{Binding WorkPermitSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Foreground}"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                </Grid>
                                                </Border>
                                            </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                             To="-2" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                             To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ICONS VIEW -->
                            <ItemsControl ItemsSource="{Binding EmployeesForIcons}"
                                          ClipToBounds="False"
                                          SizeChanged="IconsItemsControl_SizeChanged"
                                          Visibility="{Binding IsIconsView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ClipToBounds="False"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="18" Padding="0" Margin="6,14,6,6" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                                                h:TileWidthAnimator.TargetWidth="{Binding DataContext.IconCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                UseLayoutRounding="True"
                                                SnapsToDevicePixels="True"
                                                TextOptions.TextFormattingMode="Display"
                                                TextOptions.TextRenderingMode="ClearType"
                                                ContextMenu="{StaticResource EmployeeCardContextMenu}"
                                                MouseLeftButtonUp="EmployeeTileCard_MouseLeftButtonUp">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.10"/>
                                            </Border.Effect>
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#8022C55E" Offset="0"/>
                                                    <GradientStop Color="#803B82F6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only">
                                                            <Setter Property="Background" Value="{DynamicResource InfoChipBackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- Subtle glass highlight, top only -->
                                                <Border CornerRadius="17" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel Margin="16,18,16,16">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                                              Checked="EmployeeSelectionCheckBox_Changed"
                                                              Unchecked="EmployeeSelectionCheckBox_Changed"
                                                              Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                                    <Border Grid.Column="1" CornerRadius="999" Padding="8,3"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource CardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource EmployeeDocSuccessCardBorderBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0" Fill="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" Style="{StaticResource EmployeeTileClearText}"
                                                                       FontSize="{DynamicResource FS11}" FontWeight="Medium" Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid Grid.Column="3" Tag="EmployeeCardMoreMenu">
                                                        <Button x:Name="MoreBtn" Style="{StaticResource EmployeeCardMoreBtn}"
                                                                Width="28" Height="28"
                                                                Click="EmployeeCardMoreButton_Click">
                                                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS12}"/>
                                                        </Button>
                                                        <Popup x:Name="ActionPopup"
                                                               PlacementTarget="{Binding ElementName=MoreBtn}"
                                                               Placement="Bottom"
                                                               HorizontalOffset="-186"
                                                               StaysOpen="True"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Fade">
                                                            <Border CornerRadius="10" Padding="6"
                                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                                    BorderThickness="1">
                                                                <StackPanel>
                                                                    <Button Style="{StaticResource EmployeeCardPopupBtn}"
                                                                            Click="EmployeeCardOpenFolder_Click">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="{DynamicResource FS12}" Margin="0,0,8,0"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{DynamicResource EmpTooltipFolder}"
                                                                                       FontSize="{DynamicResource FS11}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Style="{StaticResource EmployeeCardPopupDeleteBtn}"
                                                                            Click="EmployeeCardDelete_Click">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="{DynamicResource FS12}" Margin="0,0,8,0"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{DynamicResource EmpBtnDelete}"
                                                                                       FontSize="{DynamicResource FS11}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </Grid>

                                                <!-- Photo with gradient ring + status dot -->
                                                <Grid Width="88" Height="88" Margin="0,2,0,12" HorizontalAlignment="Center">
                                                    <Border CornerRadius="44" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="3">
                                                        <Border.BorderBrush>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#22C55E" Offset="0"/>
                                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.BorderBrush>
                                                        <Border CornerRadius="41" Background="{DynamicResource InfoChipBackgroundBrush}" BorderBrush="{DynamicResource InfoChipBorderBrush}" BorderThickness="1.5">
                                                            <Border.Clip><EllipseGeometry Center="41,41" RadiusX="40" RadiusY="40"/></Border.Clip>
                                                            <Grid>
                                                                <Image Source="{Binding PhotoPath, Converter={StaticResource ThumbnailPathConverter}, ConverterParameter=200}" Stretch="UniformToFill" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS28}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InfoChipForegroundBrush}" Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                                            Background="{Binding Status, Converter={StaticResource StatusColor}}"
                                                            BorderBrush="{DynamicResource CardBackgroundBrush}" BorderThickness="2.5"/>
                                                </Grid>

                                                <TextBlock Text="{Binding FullName}" Style="{StaticResource EmployeeTileClearText}" FontWeight="SemiBold" FontSize="{DynamicResource FS14}"
                                                           Foreground="{DynamicResource ForegroundBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullName}"/>
                                                <TextBlock Text="{Binding PositionTitle}" Style="{StaticResource EmployeeTileClearText}" FontSize="{DynamicResource FS11}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" ToolTip="{Binding PositionTitle}"
                                                           Visibility="{Binding PositionTitle, Converter={StaticResource StrToVis}}"/>
                                                <TextBlock Text="{Binding FirmName}" Style="{StaticResource EmployeeTileClearText}" FontSize="{DynamicResource FS10}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,10" ToolTip="{Binding FirmName}"
                                                           Visibility="{Binding FirmName, Converter={StaticResource StrToVis}}"/>

                                                <!-- Start/End date as pill badges -->
                                                <Border CornerRadius="14" Padding="10,6" Margin="0,0,0,4" HorizontalAlignment="Center"
                                                        Background="{DynamicResource InfoChipBackgroundBrush}"
                                                        BorderBrush="{DynamicResource InfoChipBorderBrush}" BorderThickness="1"
                                                        ToolTip="{Binding StartDate}"
                                                        Visibility="{Binding StartDate, Converter={StaticResource StrToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="20" Height="20" CornerRadius="7" Margin="0,0,6,0"
                                                                Background="{DynamicResource CardBackgroundBrush}">
                                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource InfoChipForegroundBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding StartDate, Mode=OneWay}" Style="{StaticResource EmployeeTileClearText}"
                                                                   FontWeight="SemiBold" FontSize="{DynamicResource FS11}"
                                                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border CornerRadius="14" Padding="10,6" Margin="0,0,0,10" HorizontalAlignment="Center"
                                                        Background="{DynamicResource InfoChipBackgroundBrush}"
                                                        BorderBrush="{DynamicResource InfoChipBorderBrush}" BorderThickness="1"
                                                        ToolTip="{Binding EndDate}"
                                                        Visibility="{Binding EndDate, Converter={StaticResource StrToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="20" Height="20" CornerRadius="7" Margin="0,0,6,0"
                                                                Background="{DynamicResource CardBackgroundBrush}">
                                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FS10}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource InfoChipForegroundBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding EndDate, Mode=OneWay}" Style="{StaticResource EmployeeTileClearText}"
                                                                   FontWeight="SemiBold" FontSize="{DynamicResource FS11}"
                                                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Document chips: 1/3/4 columns depending on EmployeeType, always one row -->
                                                <UniformGrid Rows="1" Margin="0,0,0,4">
                                                    <UniformGrid.Style>
                                                        <Style TargetType="UniformGrid">
                                                            <Setter Property="Columns" Value="3"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EmployeeType}" Value="work_permit">
                                                                    <Setter Property="Columns" Value="4"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only">
                                                                    <Setter Property="Columns" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UniformGrid.Style>

                                                    <Border Tag="passport" Cursor="Hand" Margin="3"
                                                            MouseLeftButtonUp="EmployeeDocumentButton_MouseLeftButtonUp"
                                                            ToolTip="{Binding PassportExpiry}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="14"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Background" Value="{DynamicResource SuccessChipBackgroundBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessChipBorderBrush}"/>                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PassportSeverity}" Value="Expired">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/>                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PassportSeverity}" Value="Critical">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/>                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PassportSeverity}" Value="Warning">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/>                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PassportSeverity}" Value="Unknown">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningChipBackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningChipBorderBrush}"/>                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel HorizontalAlignment="Center" Margin="2,8,2,7">
                                                            <Border Width="34" Height="34" CornerRadius="12" BorderThickness="0" Margin="0,0,0,4"
                                                                    Background="{Binding PassportSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Tile}">
                                                                <Grid>
                                                                    <Border CornerRadius="12">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#BFFFFFFF" Offset="0"/>
                                                                                <GradientStop Color="#33FFFFFF" Offset="0.68"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource IconDocPassport}" Stretch="Uniform"
                                                                              Stroke="{Binding PassportSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Foreground}"
                                                                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                              Fill="Transparent"/>
                                                                    </Viewbox>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{DynamicResource EmpBadgePassportShort}" HorizontalAlignment="Center"
                                                                       Style="{StaticResource EmployeeTileClearText}" FontWeight="Bold" FontSize="{DynamicResource FS9}"
                                                                       Foreground="{Binding PassportSeverity, Converter={StaticResource DocSeverityBrush}, ConverterParameter=Foreground}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Tag="visa" Cursor="Hand" Margin="3"
                                                            MouseLeftButtonUp="EmployeeDocumentButton_MouseLeftButtonUp"
                                                            ToolTip="{Binding VisaExpiry}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="14"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Background" Value="{DynamicResource SuccessChipBackgroundBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessChipBorderBrush}"/>                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EmployeeType}" Value="passport_only">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding VisaSeverity}" Value="Expired">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorChipBackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorChipBorderBrush}"/>                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding VisaSeverity}" Value="Critical">
