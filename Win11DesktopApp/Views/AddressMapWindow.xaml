<Window x:Class="Win11DesktopApp.Views.AddressMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource MapWindowTitle}"
        Width="880" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource MapWindowHint}"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource WizInput}"
                     KeyDown="SearchBox_KeyDown"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button x:Name="StreetsButton" Content="{DynamicResource MapLayerStreets}"
                        MinWidth="88" Style="{StaticResource FilledActionButton}"
                        Click="Streets_Click"/>
                <Button x:Name="SatelliteButton" Content="{DynamicResource MapLayerSatellite}"
                        MinWidth="88" Margin="6,0,0,0" Style="{StaticResource HeaderGhostButton}"
                        Click="Satellite_Click"/>
            </StackPanel>
            <Button Grid.Column="2" Content="{DynamicResource MapSearch}" Margin="8,0,0,0"
                    MinWidth="110" Style="{StaticResource FilledActionButton}"
                    Click="Search_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,10,0" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    Background="{DynamicResource CardBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource MapResults}"
                                   Margin="12,10,12,6" FontWeight="SemiBold"/>
                        <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                                 DisplayMemberPath="Label" MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 SelectionChanged="ResultsList_SelectionChanged"/>
                    </DockPanel>
                    <Border Grid.Row="1" Height="1" Margin="12,4"
                            Background="{DynamicResource CardBorderBrush}"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource MapRecent}"
                                   Margin="12,6,12,6" FontWeight="SemiBold"/>
                        <Grid>
                            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent"
                                     DisplayMemberPath="Label" MouseDoubleClick="HistoryList_MouseDoubleClick"
                                     SelectionChanged="HistoryList_SelectionChanged"/>
                            <TextBlock x:Name="HistoryEmpty" Text="{DynamicResource MapRecentEmpty}"
                                       Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="MapView"/>
                    <TextBlock x:Name="MapStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="24" TextAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource BtnCancel}" MinWidth="110" Margin="0,0,8,0"
                    Style="{StaticResource HeaderGhostButton}" Click="Cancel_Click"/>
            <Button x:Name="ApplyButton" Content="{DynamicResource MapApply}" MinWidth="150"
                    Style="{StaticResource FilledActionButton}" IsEnabled="False" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
