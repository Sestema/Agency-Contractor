<UserControl x:Class="Win11DesktopApp.Views.StepPassportDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Win11DesktopApp.Views">
    <UserControl.Resources>
        <Geometry x:Key="GeomPassportStep">M4 2.5C4 1.67 4.67 1 5.5 1H14.5C15.33 1 16 1.67 16 2.5V17.5C16 18.33 15.33 19 14.5 19H5.5C4.67 19 4 18.33 4 17.5V2.5ZM6 3V17H14V3H6ZM10 5.4A2.2 2.2 0 1 1 10 9.8A2.2 2.2 0 1 1 10 5.4ZM7.3 12.6C7.7 11.4 8.75 10.7 10 10.7C11.25 10.7 12.3 11.4 12.7 12.6H7.3ZM7.2 14.4H12.8V15.5H7.2V14.4Z</Geometry>
        <Geometry x:Key="GeomIdCardStep">M2 4.5C2 3.67 2.67 3 3.5 3H16.5C17.33 3 18 3.67 18 4.5V15.5C18 16.33 17.33 17 16.5 17H3.5C2.67 17 2 16.33 2 15.5V4.5ZM3.7 5V15H16.3V5H3.7ZM6.8 6.8A1.6 1.6 0 1 1 6.8 10A1.6 1.6 0 1 1 6.8 6.8ZM4.7 12.8C5 11.7 5.8 11.1 6.8 11.1C7.8 11.1 8.6 11.7 8.9 12.8H4.7ZM10.4 7.3H15V8.5H10.4V7.3ZM10.4 10H15V11.2H10.4V10ZM10.4 12.6H13.5V13.8H10.4V12.6Z</Geometry>
        <Geometry x:Key="GeomSparkleScan">M10 2L11.7 6.8L16.5 8.5L11.7 10.2L10 15L8.3 10.2L3.5 8.5L8.3 6.8L10 2ZM15.5 12.2L16.3 14.5L18.6 15.3L16.3 16.1L15.5 18.4L14.7 16.1L12.4 15.3L14.7 14.5L15.5 12.2Z</Geometry>

        <Style x:Key="StepFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="1,0,0,4"/>
        </Style>

        <Style x:Key="StepFieldInput" TargetType="TextBox" BasedOn="{StaticResource WizInput}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="GenderSegRadio" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=2}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource ThinScroll}" Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Hidden"
                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <!-- Header + AI Scan -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PageHeaderIconBadge}" Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource GeomPassportStep}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEuIdCard}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource GeomIdCardStep}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Border>
                            <TextBlock Text="{Binding PrimaryDocumentStepTitle}"
                                       FontSize="{DynamicResource FS16}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding AIScanDocumentCommand}"
                                Style="{StaticResource FilledActionButton}"
                                Height="34" Padding="14,0"
                                Visibility="{Binding IsAIScanning, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomSparkleScan}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource AIScanBtn}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Thin AI status banner (only when scanning or status message is non-empty) -->
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                            Background="{DynamicResource AccentLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding AIScanStatus, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding AIScanStatus}"
                                   FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Two-column form -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: FirstName | LastName -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizFirstName}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{DynamicResource WizLastName}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>

                        <!-- Row 1: BirthDate | RodneCislo -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizBirthDate}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.BirthDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="{DynamicResource DetFieldRodneCislo}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding RodneCislo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>

                        <!-- Row 2: Gender | Citizenship -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizGender}" Style="{StaticResource StepFieldLabel}"/>
                            <Border Height="34" Margin="0,0,0,8" CornerRadius="8" Padding="2"
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <UniformGrid Columns="2">
                                    <RadioButton Content="{DynamicResource GenderMale}" GroupName="Gender"
                                                 Style="{StaticResource GenderSegRadio}"
                                                 IsChecked="{Binding IsGenderMale, Mode=TwoWay}"/>
                                    <RadioButton Content="{DynamicResource GenderFemale}" GroupName="Gender"
                                                 Style="{StaticResource GenderSegRadio}"
                                                 IsChecked="{Binding IsGenderFemale, Mode=TwoWay}"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="{DynamicResource WizCitizenship}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.Citizenship, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>

                        <!-- Row 3: PassportNumber | PassportExpiry -->
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizPassportNum}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.PassportNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Text="{DynamicResource WizPassportExpiry}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.PassportExpiry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>

                        <!-- Row 4: BirthCity | BirthCountry -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizBirthCity}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.PassportCity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="{DynamicResource WizBirthCountry}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.PassportCountry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>

                        <!-- Row 5: Authority | IssuingCountry -->
                        <StackPanel Grid.Row="5" Grid.Column="0">
                            <TextBlock Text="{DynamicResource WizPassportAuthority}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.PassportAuthority, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2">
                            <TextBlock Text="{DynamicResource WizIssuingCountry}" Style="{StaticResource StepFieldLabel}"/>
                            <TextBox Text="{Binding Data.IssuingCountry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                        </StackPanel>
                    </Grid>

                    <!-- EU ID Card extra fields -->
                    <StackPanel Visibility="{Binding ShowIdCardFallbackFields, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource WizWorkPermitName}" Style="{StaticResource StepFieldLabel}"/>
                        <TextBox Text="{Binding Data.WorkPermitName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepFieldInput}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"
                          Margin="0"/>
            <views:DocumentPreviewPanel Grid.Column="2" Margin="10,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
