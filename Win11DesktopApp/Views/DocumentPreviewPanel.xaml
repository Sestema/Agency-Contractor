<UserControl x:Class="Win11DesktopApp.Views.DocumentPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Geometry x:Key="GeomEmptyDoc">M4 3C4 2.17 4.67 1.5 5.5 1.5H14.5C15.33 1.5 16 2.17 16 3V17C16 17.83 15.33 18.5 14.5 18.5H5.5C4.67 18.5 4 17.83 4 17V3ZM6 3.5V16.5H14V3.5H6ZM7.5 6.5H12.5V8H7.5V6.5ZM7.5 9.8H12.5V11.3H7.5V9.8ZM7.5 13H10.8V14.5H7.5V13Z</Geometry>

        <Style x:Key="PreviewTabBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewZoomBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Panel.ZIndex="2" HorizontalAlignment="Center" Margin="8,8,8,4"
                    CornerRadius="9" Padding="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasCarouselItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding CarouselItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource PreviewTabBtn}"
                                    Command="{Binding DataContext.SelectCarouselTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="1" ClipToBounds="True">
                <Grid x:Name="StageGrid" Background="Transparent"
                      PreviewMouseWheel="DocImage_MouseWheel"
                      MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                      MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                      MouseRightButtonDown="Stage_MouseLeftButtonDown"
                      MouseRightButtonUp="Stage_MouseLeftButtonUp"
                      MouseMove="Stage_MouseMove">
                    <Image x:Name="DocImage"
                           Source="{Binding CarouselPreviewPath, Converter={StaticResource ImagePathConverter}}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0,0"
                           Visibility="{Binding CarouselPreviewState, Converter={StaticResource PreviewStateToVis}, ConverterParameter=Ready}">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ZoomTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                            CornerRadius="8" Padding="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding CarouselPreviewState, Converter={StaticResource PreviewStateToVis}, ConverterParameter=Ready}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="−" Style="{StaticResource PreviewZoomBtn}" Click="ZoomOut_Click"/>
                            <Button x:Name="ZoomResetBtn" Content="100%" Style="{StaticResource PreviewZoomBtn}"
                                    MinWidth="46" Click="ZoomReset_Click"/>
                            <Button Content="+" Style="{StaticResource PreviewZoomBtn}" Click="ZoomIn_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="12"
                            Padding="24,20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CompactEmptyStateCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CarouselPreviewState, Converter={StaticResource PreviewStateToVis}, ConverterParameter=Empty}" Value="{x:Static Visibility.Visible}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeomEmptyDoc}" Width="26" Height="26" Stretch="Uniform"
                                  Fill="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource DocPreviewEmptyTitle}"
                                       Style="{StaticResource CompactEmptyStateTitleText}"/>
                            <TextBlock Text="{DynamicResource DocPreviewEmptyDescription}"
                                       Style="{StaticResource CompactEmptyStateDescriptionText}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding CarouselPreviewState, Converter={StaticResource PreviewStateToVis}, ConverterParameter=Loading}">
                        <TextBlock Text="{DynamicResource PreviewLoading}"
                                   Style="{StaticResource CompactEmptyStateTitleText}"/>
                    </StackPanel>

                    <Border Margin="12"
                            Padding="24,20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{StaticResource CompactEmptyStateCard}"
                            Visibility="{Binding CarouselPreviewState, Converter={StaticResource PreviewStateToVis}, ConverterParameter=Error}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource PreviewFailed}"
                                       Style="{StaticResource CompactEmptyStateTitleText}"/>
                            <Button Command="{Binding OpenCurrentPreviewFileCommand}" Style="{StaticResource HeaderGhostButton}" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource PreviewOpenFile}" FontSize="{DynamicResource FS12}" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
