<UserControl x:Class="Win11DesktopApp.Views.StepAddressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <Geometry x:Key="GeomHomeStep">M10 2.2L2 8.8H4.2V17H8.5V12.2H11.5V17H15.8V8.8H18L10 2.2Z</Geometry>
        <Geometry x:Key="GeomPinStep">M10 2C6.69 2 4 4.69 4 8C4 12.25 10 18.2 10 18.2C10 18.2 16 12.25 16 8C16 4.69 13.31 2 10 2ZM10 10.2A2.2 2.2 0 1 1 10 5.8A2.2 2.2 0 1 1 10 10.2Z</Geometry>
        <Geometry x:Key="GeomGlobeStep">M10 2A8 8 0 1 0 10 18A8 8 0 1 0 10 2ZM3.9 9.3H6.8C6.9 7.3 7.4 5.5 8.2 4.2A6.3 6.3 0 0 0 3.9 9.3ZM6.8 10.7H3.9A6.3 6.3 0 0 0 8.2 15.8C7.4 14.5 6.9 12.7 6.8 10.7ZM8.3 9.3H11.7C11.6 7.5 10.9 5.8 10 4.5C9.1 5.8 8.4 7.5 8.3 9.3ZM11.7 10.7H8.3C8.4 12.5 9.1 14.2 10 15.5C10.9 14.2 11.6 12.5 11.7 10.7ZM13.2 9.3H16.1A6.3 6.3 0 0 0 11.8 4.2C12.6 5.5 13.1 7.3 13.2 9.3ZM11.8 15.8A6.3 6.3 0 0 0 16.1 10.7H13.2C13.1 12.7 12.6 14.5 11.8 15.8Z</Geometry>
        <Geometry x:Key="GeomWorkStep">M7 2.5C7 1.67 7.67 1 8.5 1H11.5C12.33 1 13 1.67 13 2.5V4H16.5C17.33 4 18 4.67 18 5.5V16.5C18 17.33 17.33 18 16.5 18H3.5C2.67 18 2 17.33 2 16.5V5.5C2 4.67 2.67 4 3.5 4H7V2.5ZM8.5 2.5V4H11.5V2.5H8.5ZM3.7 8.5V16.3H16.3V8.5H12V10.2H8V8.5H3.7Z</Geometry>
        <Geometry x:Key="GeomSalaryStep">M3 4.5C3 3.67 3.67 3 4.5 3H15.5C16.33 3 17 3.67 17 4.5V15.5C17 16.33 16.33 17 15.5 17H4.5C3.67 17 3 16.33 3 15.5V4.5ZM5.5 6V8.2H14.5V6H5.5ZM5.5 10V11.6H8.5V10H5.5ZM10 10V11.6H14.5V10H10ZM5.5 13.1V14.7H8.5V13.1H5.5ZM10 13.1V14.7H14.5V13.1H10Z</Geometry>

        <Style x:Key="AddrFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>

        <Style x:Key="AddrFieldInput" TargetType="TextBox" BasedOn="{StaticResource WizInput}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="AddrFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="AddressMapThumb" TargetType="Button">
            <Setter Property="Width" Value="86"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                Background="#E7F2EA">
                            <Grid>
                                <Canvas IsHitTestVisible="False">
                                    <Line X1="6" Y1="14" X2="80" Y2="22" Stroke="#B7D7C4" StrokeThickness="3"/>
                                    <Line X1="10" Y1="32" X2="76" Y2="39" Stroke="#C5D7E8" StrokeThickness="2"/>
                                </Canvas>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StepFade}" Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=5}"
            Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <ScrollViewer Style="{StaticResource ThinScroll}"
                      VerticalScrollBarVisibility="Hidden"
                      PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Style="{StaticResource PageHeaderIconBadge}" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <Path Data="{StaticResource GeomHomeStep}" Width="16" Height="16" Stretch="Uniform" Fill="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource StepAddresses}"
                                   FontSize="{DynamicResource FS16}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource LabelWorkAddress}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Local & Abroad address cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Local address -->
                    <Border Grid.Column="0" Style="{StaticResource DialogPreviewSurface}" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,9,0"
                                            Background="{DynamicResource AccentLightBrush}">
                                        <Path Data="{StaticResource GeomPinStep}" Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource AccentDarkBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource LabelAddressLocal}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AddressMapThumb}"
                                        Command="{Binding PickLocalAddressCommand}"
                                        ToolTipService.InitialShowDelay="200">
                                    <Button.ToolTip>
                                        <StackPanel MaxWidth="280">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Data.AddressLocal.Street, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Data.AddressLocal.Number, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Data.AddressLocal.City, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Data.AddressLocal.Zip, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{DynamicResource MapThumbHint}" Opacity="0.7" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button.ToolTip>
                                    <Path Data="{StaticResource GeomPinStep}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="#1F6B4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource WizStreet}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressLocal.Street, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource WizNumber}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressLocal.Number, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource WizCity}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressLocal.City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource WizZip}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressLocal.Zip, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Abroad address -->
                    <Border Grid.Column="2" Style="{StaticResource DialogPreviewSurface}" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,9,0"
                                            Background="{DynamicResource InfoLightBrush}">
                                        <Path Data="{StaticResource GeomGlobeStep}" Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource InfoBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource LabelAddressAbroad}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AddressMapThumb}"
                                        Command="{Binding PickAbroadAddressCommand}"
                                        ToolTipService.InitialShowDelay="200">
                                    <Button.ToolTip>
                                        <StackPanel MaxWidth="280">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Data.AddressAbroad.Street, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Data.AddressAbroad.Number, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Data.AddressAbroad.City, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Data.AddressAbroad.Zip, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{DynamicResource MapThumbHint}" Opacity="0.7" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button.ToolTip>
                                    <Path Data="{StaticResource GeomPinStep}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="#1F6B4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource WizStreet}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressAbroad.Street, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource WizNumber}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressAbroad.Number, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource WizCity}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressAbroad.City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource WizZip}" Style="{StaticResource AddrFieldLabel}"/>
                                    <TextBox Text="{Binding Data.AddressAbroad.Zip, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddrFieldInput}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Work address, position, contract & salary preview -->
                <Border Style="{StaticResource DialogPreviewSurface}" Padding="14,12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,9,0"
                                        Background="{DynamicResource SuccessLightBrush}">
                                    <Path Data="{StaticResource GeomWorkStep}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource SuccessBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LabelWorkAddress}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{DynamicResource LabelPosition}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource LabelWorkAddress}" Style="{StaticResource AddrFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CompanyAddresses}" SelectedItem="{Binding SelectedWorkAddress}" Style="{StaticResource AddrFieldCombo}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock><Run Text="{Binding Street}"/> <Run Text="{Binding Number}"/>, <Run Text="{Binding City}"/> <Run Text="{Binding ZipCode}"/></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LabelPosition}" Style="{StaticResource AddrFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding CompanyPositions}" SelectedItem="{Binding SelectedPosition}" Style="{StaticResource AddrFieldCombo}" Margin="0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding Title}"/> (<Run Text="{Binding PositionNumber}"/>)</TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LabelContractType}" Style="{StaticResource AddrFieldLabel}"/>
                                    <ComboBox SelectedItem="{Binding ContractType}" Style="{StaticResource AddrFieldCombo}" Margin="0">
                                        <sys:String>HPP</sys:String>
                                        <sys:String>DPP</sys:String>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="10" Padding="14,12"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Stretch">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,9,0"
                                            Background="{DynamicResource AccentLightBrush}">
                                        <Path Data="{StaticResource GeomSalaryStep}" Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource AccentDarkBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LabelPosition}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{DynamicResource WizSalaryMonth}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource WizPosNumber}" Style="{StaticResource AddrFieldLabel}"/>
                                        <TextBlock Text="{Binding SelectedPosition.PositionNumber}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource WizSalaryHour}" Style="{StaticResource AddrFieldLabel}"/>
                                        <TextBlock Text="{Binding SelectedPosition.HourlySalary, StringFormat={}{0:N0} CZK/h}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentDarkBrush}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource WizSalaryMonth}" Style="{StaticResource AddrFieldLabel}"/>
                                <TextBlock Text="{Binding SelectedPosition.MonthlySalaryBrutto, StringFormat={}{0:N0} CZK}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
